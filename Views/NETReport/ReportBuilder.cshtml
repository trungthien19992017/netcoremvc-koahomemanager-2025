    const button=$('#saveBtn'),token=document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    try{
      config=validate(config);button.disabled=true;button.classList.add('saving');$('#saveState').textContent='Đang lưu cấu hình...';
      const response=await fetch('/NETReport/ReportBuilderSave?ReportCode='+encodeURIComponent(reportCode),{
        method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token||''},body:JSON.stringify(config)
      });
      const payload=await response.json().catch(()=>({success:false,errorMessage:'Phản hồi từ máy chủ không hợp lệ.'}));
      if(!response.ok||!payload.success)throw Error(payload.errorMessage||'Không lưu được cấu hình.');
      config.table.createNew=false;config.databaseVersion=payload.result?.savedversion??payload.result?.lastmodificationtime??config.databaseVersion;
      history=[];$('#saveState').textContent='Đã lưu vào TTT_Config';toast('Đã lưu cấu hình report '+reportCode);
    }catch(error){$('#saveState').textContent='Lưu thất bại';toast(error.message||'Không lưu được cấu hình.');}
    finally{button.disabled=false;button.classList.remove('saving');}
  }
  function exportData(kind){const columns=config.columns.filter(c=>c.isexport),data=filteredRows(),name=config.table.id.replace(/[^a-zA-Z0-9_-]/g,'_');if(kind==='json'){download(JSON.stringify(data.map(r=>Object.fromEntries(columns.map(c=>[c.key,r[c.key]??null]))),null,2),name+'-data.json','application/json');return;}const csvCell=v=>{let text=asText(v);if(/^[\s]*[=+@@-]/.test(text))text="'"+text;return '"'+text.replace(/"/g,'""')+'"';};download('\ufeff'+[columns.map(c=>csvCell(c.title)).join(','),...data.map(r=>columns.map(c=>csvCell(r[c.key])).join(','))].join('\r\n'),name+'-data.csv','text/csv;charset=utf-8');toast('Đã xuất các dòng đang lọc; chỉ gồm cột được phép export.');}

  function freshKey(){let n=config.columns.length+1;while(config.columns.some(c=>c.key==='field_'+n))n++;return 'field_'+n;}
  document.addEventListener('click',e=>{
    const t=e.target;
    const fileCommand=t.closest('[data-file-command]');if(fileCommand){$('#builderFiles').open=false;const id={import:'importBtn',download:'downloadBtn',undo:'undoBtn'}[fileCommand.dataset.fileCommand];if(id)$('#'+id).click();return;}
    if(t.closest('[data-close-sheet]'))return closeSheets();
    if(t.closest('#closeDialog')||t===$('#reportDialogBackdrop'))return closeDialog();
    if(t.closest('[data-confirm-simulation]')){toast('Đã xác nhận mô phỏng. Không có dữ liệu thực tế bị thay đổi.');closeDialog();return;}
    const a=t.closest('[data-action]');if(a)return runAction(a.dataset.action,a.dataset.actionRow);
    const link=t.closest('[data-preview-link]');if(link){showDialog('Xem cấu hình liên kết','<div class="info-note">Chỉ hiển thị URL, không tự điều hướng.</div><pre class="action-preview">'+esc(link.dataset.previewLink)+'</pre>');return;}
    const menu=t.closest('[data-row-menu]');if(menu)return showActions(menu.dataset.rowMenu);
    const detail=t.closest('[data-detail]');if(detail)return showDetail(detail.dataset.detail);
    const col=t.closest('[data-column]');if(col){selectedColumnId=col.dataset.column;inspectorTab='column';renderColumns();renderInspector();if(innerWidth<=1200)showSheet('settings');return;}
    const it=t.closest('[data-inspector-tab]');if(it){inspectorTab=it.dataset.inspectorTab;renderInspector();return;}
    const ct=t.closest('[data-center-tab]');if(ct){centerTab=ct.dataset.centerTab;$('#previewView').hidden=centerTab!=='preview';$('#jsonView').style.display=centerTab==='json'?'block':'none';$$('[data-center-tab]').forEach(b=>b.classList.toggle('active',b===ct));if(centerTab==='json')renderJSON();return;}
    const deviceButton=t.closest('button[data-device]');if(deviceButton){device=deviceButton.dataset.device;renderPreview();$$('button[data-device]').forEach(b=>b.classList.toggle('active',b===deviceButton));return;}
    const mobile=t.closest('[data-mobile-view]');if(mobile){const v=mobile.dataset.mobileView;if(v==='structure'||v==='settings')showSheet(v);else{closeSheets();centerTab=v==='json'?'json':'preview';render();$$('[data-mobile-view]').forEach(b=>b.classList.toggle('active',b===mobile));}return;}
    const sortButton=t.closest('[data-sort]');if(sortButton){const c=getColumn(sortButton.dataset.sort);if(!c?.sortable)return;sort=sort.key===c.key?{key:c.key,direction:sort.direction==='asc'?'desc':'asc'}:{key:c.key,direction:'asc'};renderTable();$('#runtimeSort').value=c.id+':'+sort.direction;return;}
    const pagination=t.closest('[data-page]');if(pagination){page=Number(pagination.dataset.page);renderTable();return;}
    if(t.closest('[data-clear-filters]')){filterValues={};globalQuery='';$('#globalSearch').value='';page=1;renderFilters();renderTable();return;}
    if(t.closest('[data-close-filters]')){filtersOpen=false;$('#advancedFilters').open=false;return;}
    if(t.closest('[data-clear-selection]')){selection.clear();renderTable();return;}
    const exp=t.closest('[data-export-data]');if(exp)return exportData(exp.dataset.exportData);
    function getNextColumnNumber() {
        return Math.max(
            0,
            ...config.columns.map(c => Number(c.colnum) || 0)
        ) + 1;
    }
    if(t.closest('[data-add-column]')){
      mutate(()=>{
          const id=uid('col');
          const nextColNum=getNextColumnNumber();

          config.columns.push(
              column(
                  id,
                  freshKey(),
                  'Cột mới',
                  'text',
                  {
                      colnum: nextColNum
                  }
              )
          );

          selectedColumnId=id;
          inspectorTab='column';
      },'Đã thêm cột');

      if(innerWidth<=1200)
          showSheet('settings');

      return;
  }
    if(t.closest('[data-delete-column]')){const c=selectedColumn();if(!c)return;mutate(()=>{config.columns=config.columns.filter(x=>x.id!==c.id);config.filters=config.filters.filter(f=>f.field!==c.key);config.rowRules=config.rowRules.filter(r=>r.field!==c.key);},'Đã xóa cột và cấu hình liên quan');return;}
    const move=t.closest('[data-move-column]');
        if(move){
            mutate(()=>{
                const from=config.columns.findIndex(
                    c=>c.id===selectedColumnId
                );

                const to=from+(
                    move.dataset.moveColumn==='up' ? -1 : 1
                );

                if(to>=0 && to<config.columns.length){
                    config.columns.splice(
                        to,
                        0,
                        config.columns.splice(from,1)[0]
                    );

                    syncColumnNumbers();
                }
            });

            return;
        }
    const iconButton=t.closest('[data-column-icon]');if(iconButton)return update('column','iconClass',iconButton.dataset.columnIcon);
    if(t.closest('[data-booking-template]'))return update('column','template',bookingTemplate);
    if(t.closest('[data-add-group]'))return mutate(()=>config.groups.push({id:uid('group'),title:'Nhóm tiêu đề mới',cssheader:''}));
    const removeGroup=t.closest('[data-remove-group]');if(removeGroup)return mutate(()=>{config.groups=config.groups.filter(g=>g.id!==removeGroup.dataset.removeGroup);config.columns.forEach(c=>{if(c.groupId===removeGroup.dataset.removeGroup)c.groupId='';});});
    if(t.closest('[data-add-filter]')){const c=config.columns.find(c=>c.filterable);if(!c)return toast('Chưa có cột cho phép lọc.');mutate(()=>{config.filters.push({id:uid('filter'),field:c.key,label:c.title,component:c.type==='datetime'?'date':c.type,operator:['text'].includes(c.type)?'contains':'equals',colSpan:4});inspectorTab='filters';});if(innerWidth<=1200)showSheet('settings');return;}
    const rf=t.closest('[data-remove-filter]');if(rf)return mutate(()=>{config.filters=config.filters.filter(f=>f.id!==rf.dataset.removeFilter);},'Đã xóa filter và giá trị đang lọc');
    if(t.closest('[data-add-action]'))return mutate(()=>{const id=uid('action');config.actions.push({id,name:'Thao tác mới',code:'CUSTOM_'+id.replace(/[^A-Za-z0-9]/g,'').toUpperCase(),actionId:null,type:'LINK',scope:'row',icon:'fa fa-link',value:'/detail/{{id}}',enabled:true,background:'#7759ed',color:'#ffffff'});});
    const ra=t.closest('[data-remove-action]');if(ra)return mutate(()=>{config.actions=config.actions.filter(a=>a.id!==ra.dataset.removeAction);});
    if(t.closest('[data-add-rule]')){if(!config.columns.length)return toast('Thêm một cột trước.');return mutate(()=>config.rowRules.push({id:uid('rule'),field:config.columns[0].key,operator:'equals',value:'',label:'Trạng thái mới',background:'#eaf3ff'}));}
    const rr=t.closest('[data-remove-rule]');if(rr)return mutate(()=>{config.rowRules=config.rowRules.filter(r=>r.id!==rr.dataset.removeRule);});
    if(t.closest('[data-apply-data]')){try{const rows=JSON.parse($('#sampleData').value);mutate(()=>{config.data.rows=rows;selection.clear();page=1;},'Đã áp dụng dữ liệu mẫu');}catch{toast('Dữ liệu phải là JSON array hợp lệ.');}return;}
    if(t.closest('[data-booking-demo]'))return mutate(()=>{config=clone(defaultConfig);filterValues={};selection.clear();runtimeHidden.clear();sort={key:'',direction:'asc'};globalQuery='';$('#globalSearch').value='';page=1;selectedColumnId=config.columns[0].id;jsonDirty=false;filtersOpen=false;},'Đã mở mẫu đặt phòng. Có thể hoàn tác.');
  });
  document.addEventListener('change',editorChange);
  document.addEventListener('focusout',e=>{if(e.target.matches('input[data-scope],textarea[data-scope]'))editorChange(e);});
  document.addEventListener('input',e=>{const el=e.target;if(el.id==='jsonEditor'){jsonDraft=el.value;jsonDirty=true;$('#jsonStatus').textContent='BẢN NHÁP · CHƯA APPLY';$('#jsonStatus').style.color='';return;}if(el.matches('[data-runtime-filter]'))runtimeFilterInput(el);});
  function runtimeFilterInput(el){const f=config.filters.find(f=>f.id===el.dataset.runtimeFilter);if(!f)return;if(f.component==='multiSelect'){const values=$$('[data-runtime-filter]').filter(n=>n.dataset.runtimeFilter===f.id&&n.checked).map(n=>n.value);filterValues[f.id]=values;}else if(el.dataset.part!==undefined){const arr=Array.isArray(filterValues[f.id])?[...filterValues[f.id]]:['',''];arr[Number(el.dataset.part)]=el.value;filterValues[f.id]=arr;}else filterValues[f.id]=el.value;page=1;renderTable();const count=config.filters.filter(f=>isFilterActive(f,filterValues[f.id])).length;const badge=$('.filter-count');if(badge)badge.textContent=count?count+' đang lọc':config.filters.length+' bộ lọc';}
  document.addEventListener('change',e=>{const el=e.target;if(el.matches('select[data-runtime-filter]'))runtimeFilterInput(el);if(el.matches('[data-select-row]')){el.checked?selection.add(el.dataset.selectRow):selection.delete(el.dataset.selectRow);renderTable();}
    if(el.matches('[data-select-page]')){const data=filteredRows(),rows=config.table.pagination?data.slice((page-1)*config.table.pageSize,page*config.table.pageSize):data;rows.forEach(r=>el.checked?selection.add(rowKey(r)):selection.delete(rowKey(r)));renderTable();}
    if(el.matches('[data-runtime-column]')){el.checked?runtimeHidden.delete(el.dataset.runtimeColumn):runtimeHidden.add(el.dataset.runtimeColumn);renderTable();}
  });
  $('#columnSearch').oninput=renderColumns;$('#globalSearch').oninput=e=>{globalQuery=e.target.value.trim().toLowerCase();page=1;renderTable();};
  $('#runtimePageSize').onchange=e=>mutate(()=>{config.table.pageSize=Number(e.target.value);page=1;});
  $('#runtimeSort').onchange=e=>{const [id,direction]=e.target.value.split(':');sort={key:config.columns.find(c=>c.id===id)?.key||'',direction:direction||'asc'};renderTable();};
  $('#inspectorBtn').onclick=()=>showSheet('settings');$('#structureFilters').onclick=()=>{inspectorTab='filters';renderInspector();if(innerWidth<=1200)showSheet('settings');};$('#sheetBackdrop').onclick=closeSheets;
  $('#focusBtn').onclick=()=>{closeSheets();document.body.classList.toggle('preview-only');$('#focusBtn').setAttribute('aria-pressed',document.body.classList.contains('preview-only'));};
  $('#undoBtn').onclick=()=>{if(!history.length)return toast('Không còn lịch sử');config=validate(JSON.parse(history.pop()));reconcile();persist();render();toast('Đã hoàn tác');};
  $('#saveBtn').onclick=saveConfiguration;
  $('#downloadBtn').onclick=exportConfig;
  $('#copyBtn').onclick=async()=>{try{await navigator.clipboard.writeText(JSON.stringify(config,null,2));toast('Đã copy cấu hình đã Apply');}catch{centerTab='json';render();toast('Đã mở JSON để bạn sao chép');}};
  $('#importBtn').onclick=()=>$('#configFile').click();$('#configFile').onchange=e=>{const f=e.target.files[0];if(!f)return;if(f.size>15*1024*1024){toast('File JSON tối đa 15 MB.');e.target.value='';return;}const reader=new FileReader();reader.onload=()=>{try{applyConfig(reader.result);}catch(err){toast(err.message);}$('#configFile').value='';};reader.onerror=()=>toast('Không đọc được file.');reader.readAsText(f);};
  $('#applyJsonBtn').onclick=()=>{try{applyConfig($('#jsonEditor').value);}catch(err){$('#jsonStatus').textContent=err.message;$('#jsonStatus').style.color='#ff8596';}};
  $('#formatBtn').onclick=()=>{try{jsonDraft=JSON.stringify(JSON.parse($('#jsonEditor').value),null,2);jsonDirty=true;renderJSON();}catch(err){$('#jsonStatus').textContent=err.message;$('#jsonStatus').style.color='#ff8596';}};
  $('#revertJsonBtn').onclick=()=>{jsonDirty=false;jsonDraft='';renderJSON();};
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('#reportDialogBackdrop').hidden)closeDialog();else closeSheets();}
    if(e.target.matches('[data-column]')&&(e.key==='Enter'||e.key===' ')){e.preventDefault();e.target.click();}
    if(e.key==='Tab'&&!$('#reportDialogBackdrop').hidden){const nodes=$$('#reportDialogBackdrop button,#reportDialogBackdrop a[href],#reportDialogBackdrop input').filter(n=>!n.disabled&&n.offsetParent!==null);const first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus();}}
  });
  let resizeTimer;window.addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>renderPreview(),100);});
  render();if(startupMessage)toast(startupMessage);
})();

</script>
</body>
</html>
