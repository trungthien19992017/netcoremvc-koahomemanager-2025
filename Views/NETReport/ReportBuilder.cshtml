@using System.Text.Json
@{
    ViewData["Title"] = "Cấu hình Report động";
    Layout = "_BlankLayout";
}

<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Report Studio 3 — NETReport Mobile Preview</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary:#6c5ce7;
      --primary-2:#8577f5;
      --primary-soft:#f0eeff;
      --blue:#20b5f5;
      --green:#20c77a;
      --orange:#ff9f43;
      --red:#ea5455;
      --ink:#252a41;
      --muted:#82879a;
      --line:#e3e5ed;
      --soft:#f6f7fb;
      --panel:#fff;
      --shadow:0 5px 18px rgba(40,45,72,.07);
      --radius:13px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#f4f5fb}
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .app{height:100vh;display:grid;grid-template-rows:70px minmax(0,1fr);overflow:hidden}
    .topbar{
      z-index:10;display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:0 18px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);
      box-shadow:0 2px 12px rgba(36,40,67,.05)
    }
    .brand,.top-actions,.statuses,.panel-title,.toolbar-group,.inline{display:flex;align-items:center}
    .brand{gap:12px;min-width:230px}
    .brand-icon{
      width:40px;height:40px;display:grid;place-items:center;border-radius:11px;color:#fff;
      font-size:20px;font-weight:800;background:linear-gradient(135deg,var(--primary-2),var(--primary));
      box-shadow:0 7px 16px rgba(108,92,231,.25)
    }
    .brand h1{font-size:15px;margin:0;font-weight:800}
    .brand p{margin:3px 0 0;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em}
    .statuses{gap:7px;justify-content:center}
    .status{
      display:flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--line);
      border-radius:9px;color:#72778a;background:#fafaff;font-size:11px
    }
    .status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 8px rgba(32,199,122,.45)}
    .top-actions{gap:8px}
    .btn{
      min-height:36px;display:inline-flex;align-items:center;justify-content:center;gap:7px;
      padding:7px 12px;border:1px solid var(--line);border-radius:9px;color:#5e6376;background:#fff;
      font-size:12px;font-weight:600;box-shadow:0 2px 6px rgba(38,43,67,.04);transition:.16s
    }
    .btn:hover{border-color:#bcb6f5;color:var(--primary);background:#f9f8ff;transform:translateY(-1px)}
    .btn.primary{color:#fff;border-color:var(--primary);background:linear-gradient(135deg,var(--primary-2),var(--primary));box-shadow:0 6px 14px rgba(108,92,231,.22)}
    .btn.danger{color:var(--red);border-color:#ffd1d1;background:#fff8f8}
    .btn.small{min-height:30px;padding:5px 9px;font-size:11px}
    .icon-btn{
      width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--line);
      border-radius:8px;color:#8a8fa0;background:#fff
    }
    .icon-btn:hover{color:var(--primary);border-color:#c6c0f4;background:#f8f7ff}
    .workspace{min-height:0;display:grid;grid-template-columns:260px minmax(530px,1fr) 310px}
    .sidebar{
      min-width:0;overflow:auto;background:#fff;scrollbar-width:thin;scrollbar-color:#bbb transparent
    }
    .sidebar.left{border-right:1px solid var(--line)}
    .sidebar.right{border-left:1px solid var(--line)}
    .side-head{
      position:sticky;top:0;z-index:3;padding:17px 15px 12px;border-bottom:1px solid #eff0f4;background:rgba(255,255,255,.96)
    }
    .side-head h2{margin:0;color:#7c8191;font-size:11px;letter-spacing:.05em;text-transform:uppercase}
    .side-head p{margin:5px 0 0;color:#a0a4b1;font-size:10px;line-height:1.5}
    .side-body{padding:12px}
    .section-label{margin:16px 0 9px;color:#9498a8;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
    .section-label:first-child{margin-top:0}
    .search{position:relative}
    .search span{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#a1a5b2;font-size:13px}
    .control{
      width:100%;min-height:38px;padding:8px 10px;border:1px solid #dde0e9;border-radius:9px;
      outline:none;color:#34394e;background:#fff;font-size:12px
    }
    .search .control{padding-left:31px}
    .control:focus{border-color:#8174ef;box-shadow:0 0 0 3px rgba(108,92,231,.09)}
    .field{display:grid;gap:6px;margin-bottom:12px}
    .field label{color:#898e9e;font-size:10px;font-weight:700}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .column-list{display:grid;gap:7px;margin-top:10px}
    .column-item{
      display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:8px;
      min-height:57px;padding:8px;border:1px solid var(--line);border-radius:10px;background:#fafaff;transition:.15s
    }
    .column-item:hover{border-color:#cdc8ef;background:#f9f8ff}
    .column-item.active{border-color:#897df0;background:linear-gradient(90deg,#efedff,#fff);box-shadow:inset 3px 0 var(--primary)}
    .column-item.hidden{opacity:.55}
    .drag{color:#abb0bd;text-align:center;cursor:grab;user-select:none}
    .column-item{touch-action:pan-y;will-change:transform}
    .drag{display:grid;min-width:28px;min-height:38px;place-items:center;touch-action:none}
    .sortable-ghost{opacity:.28!important;background:#e8e4ff!important;border:1px dashed var(--primary)!important}
    .sortable-chosen{border-color:var(--primary)!important;box-shadow:0 10px 28px rgba(108,92,231,.2)!important}
    .sortable-drag{opacity:1!important;transform:rotate(1.5deg) scale(1.025);box-shadow:0 18px 38px rgba(44,42,90,.22)!important}
    .column-copy{min-width:0}
    .column-copy strong,.column-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .column-copy strong{font-size:11px}
    .column-copy small{margin-top:4px;color:#9297a8;font:9px "JetBrains Mono",monospace}
    .type{padding:4px 6px;border:1px solid #dbd7fa;border-radius:6px;color:var(--primary);background:#f1efff;font:9px "JetBrains Mono",monospace}
    .dash-btn{
      width:100%;min-height:43px;margin-top:9px;border:1px dashed #a9a1ee;border-radius:10px;
      color:var(--primary);background:#f9f8ff;font-size:11px;font-weight:700
    }
    .dash-btn:hover{border-color:var(--primary);background:#efedff}
    .filter-node{margin-bottom:8px;padding:9px;border:1px solid var(--line);border-radius:10px;background:#fafaff}
    .filter-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
    .filter-head strong{font-size:10px}
    .filter-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
    .filter-grid .control{min-height:32px;padding:5px 7px;font-size:10px}
    .canvas{
      min-width:0;overflow:auto;padding:16px;background:
        linear-gradient(rgba(108,92,231,.026) 1px,transparent 1px),
        linear-gradient(90deg,rgba(108,92,231,.026) 1px,transparent 1px),#f5f6fb;
      background-size:44px 44px
    }
    .canvas-inner{width:100%;max-width:1500px;margin:auto}
    .canvas-head{
      display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:12px;padding:13px 15px;
      border:1px solid #dfdcef;border-left:4px solid var(--primary);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow)
    }
    .canvas-title h2{margin:0;font-size:17px}
    .canvas-title p{margin:5px 0 0;color:var(--muted);font-size:11px}
    .metrics{display:flex;gap:7px}
    .metric{min-width:78px;padding:7px 9px;border:1px solid var(--line);border-radius:9px;background:#fafaff}
    .metric b{display:block;color:var(--primary);font-size:14px}
    .metric span{color:#989cad;font-size:8px;text-transform:uppercase}
    .card{overflow:hidden;border:1px solid #dfe1ea;border-radius:var(--radius);background:#fff;box-shadow:var(--shadow)}
    .card-head{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 13px;border-bottom:1px solid #e9eaf0}
    .panel-title{gap:9px}
    .panel-icon{width:29px;height:29px;display:grid;place-items:center;border-radius:8px;color:#fff;background:var(--primary)}
    .panel-title h3{margin:0;font-size:12px}
    .panel-title p{margin:3px 0 0;color:var(--muted);font-size:9px}
    .tabs{display:flex;gap:4px;padding:4px;border:1px solid var(--line);border-radius:9px;background:#f5f6fa}
    .tab{min-height:29px;padding:5px 10px;border:0;border-radius:7px;color:#858a9c;background:transparent;font-size:10px;font-weight:600}
    .tab.active{color:var(--primary);background:#fff;box-shadow:0 2px 7px rgba(45,50,77,.08)}
    .filter-bar{display:grid;grid-template-columns:repeat(4,minmax(110px,1fr)) auto;gap:8px;padding:11px 13px;border-bottom:1px solid #e9eaf0;background:#fafaff}
    .filter-box label{display:block;margin-bottom:4px;color:#8b90a0;font-size:8px;font-weight:700;text-transform:uppercase}
    .filter-box .control{min-height:33px;padding:6px 8px;font-size:10px}
    .table-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px;border-bottom:1px solid #eaebf1}
    .table-toolbar h4{margin:0;font-size:12px}
    .table-toolbar p{margin:3px 0 0;color:var(--muted);font-size:9px}
    .toolbar-group{gap:7px}
    .global-search{width:190px}
    .table-wrap{overflow:auto;min-height:330px}
    table{width:100%;min-width:760px;border-collapse:collapse}
    th,td{padding:11px 12px;border-bottom:1px solid #eceef3;text-align:left;white-space:nowrap}
    th{position:sticky;top:0;z-index:2;color:#697087;background:#f7f8fc;font-size:9px;letter-spacing:.04em;text-transform:uppercase}
    th.sortable{cursor:pointer}
    th.sortable:hover{color:var(--primary);background:#f1efff}
    td{color:#474c60;font-size:11px}
    tbody tr:hover{background:#f8f7ff}
    tbody tr.selected{background:#f0eeff;box-shadow:inset 3px 0 var(--primary)}
    .identity{display:flex;align-items:center;gap:8px}
    .avatar{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;color:#fff;background:linear-gradient(135deg,var(--blue),var(--primary));font-size:9px;font-weight:800}
    .badge{display:inline-flex;align-items:center;gap:5px;padding:4px 7px;border-radius:999px;font-size:9px;font-weight:700}
    .badge:before{width:5px;height:5px;content:"";border-radius:50%;background:currentColor}
    .badge.Active{color:#139a5e;background:#eafaf2}
    .badge.Pending{color:#d68120;background:#fff5e8}
    .badge.Blocked{color:#d64b62;background:#fff0f2}
    .money{color:#1769c2;font-family:"JetBrains Mono",monospace;font-weight:600}
    .progress{display:flex;align-items:center;gap:7px}
    .progress-track{width:65px;height:5px;overflow:hidden;border-radius:9px;background:#e9eaf1}
    .progress-track i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--primary),var(--blue))}
    .pagination{display:flex;align-items:center;justify-content:space-between;padding:10px 13px;color:#898e9e;background:#fafaff;font-size:9px}
    .pages{display:flex;gap:4px}
    .page{width:27px;height:27px;border:1px solid var(--line);border-radius:7px;color:#777d90;background:#fff;font-size:10px}
    .page.active{color:#fff;border-color:var(--primary);background:var(--primary)}
    .json-view{display:none;background:#202338}
    .json-toolbar{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.1)}
    .dots{display:flex;gap:5px}.dots i{width:7px;height:7px;border-radius:50%;background:var(--red)}.dots i:nth-child(2){background:var(--orange)}.dots i:nth-child(3){background:var(--green)}
    .json-status{color:#74e0a8;font:9px "JetBrains Mono",monospace}
    .json-editor{width:100%;min-height:480px;padding:15px;border:0;outline:0;resize:vertical;color:#e5e8f2;background:#202338;font:11px/1.65 "JetBrains Mono",monospace}
    .inspector-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-bottom:13px;padding:4px;border:1px solid var(--line);border-radius:9px;background:#f5f6fa}
    .inspector-tab{min-height:30px;border:0;border-radius:7px;color:#898e9f;background:transparent;font-size:10px}
    .inspector-tab.active{color:var(--primary);background:#fff;box-shadow:0 2px 6px rgba(40,45,72,.08)}
    .switch-row{min-height:43px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #eff0f4}
    .switch-copy b{display:block;font-size:10px}.switch-copy small{display:block;margin-top:3px;color:#969baa;font-size:8px}
    .switch{position:relative;width:36px;height:20px;flex:0 0 auto}
    .switch input{position:absolute;opacity:0}
    .switch span{position:absolute;inset:0;border-radius:20px;background:#e4e6ec;transition:.2s}
    .switch span:after{position:absolute;top:3px;left:3px;width:14px;height:14px;content:"";border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(30,35,59,.2);transition:.2s}
    .switch input:checked+span{background:var(--primary)}
    .switch input:checked+span:after{transform:translateX(16px)}
    .renderer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}
    .renderer{min-height:43px;border:1px solid var(--line);border-radius:9px;color:#818698;background:#fafaff;font-size:9px}
    .renderer.active{color:var(--primary);border-color:#8c81f3;background:#f0eeff}
    .empty{padding:30px;color:var(--muted);text-align:center;font-size:11px}
    .toast{position:fixed;right:18px;bottom:18px;z-index:99;padding:11px 14px;border:1px solid #b8e9d1;border-radius:10px;color:#21724c;background:#effcf6;box-shadow:0 9px 25px rgba(34,67,50,.14);font-size:11px;opacity:0;pointer-events:none;transform:translateY(8px);transition:.2s}
    .toast.show{opacity:1;transform:none}
    .mobile-nav,.sheet-backdrop{display:none}
    @@media(max-width:1150px){
      .workspace{grid-template-columns:240px minmax(500px,1fr)}
      .sidebar.right{position:fixed;right:0;top:70px;bottom:0;z-index:8;width:310px;box-shadow:-12px 0 30px rgba(34,39,67,.12);transform:translateX(100%);transition:.22s}
      .sidebar.right.open{transform:none}
      .statuses{display:none}
    }
    @@media(max-width:780px){
      body{overflow-x:hidden}
      .app{height:auto;min-height:100vh;overflow:visible;padding-bottom:68px}
      .topbar{position:sticky;top:0}
      .brand{min-width:0}.brand p{display:none}
      .top-actions .btn:not(.primary){display:none}
      .workspace{display:block}
      .canvas{min-height:calc(100vh - 138px);padding:10px 10px 18px}
      .canvas-head{align-items:flex-start;flex-direction:column;padding:12px}
      .canvas-title h2{font-size:15px}.canvas-title p{line-height:1.5}
      .metrics{display:grid;width:100%;grid-template-columns:repeat(4,minmax(74px,1fr));overflow:auto}
      .metric{min-width:74px;padding:6px 8px}
      .card{border-radius:11px}.card-head{align-items:flex-start;flex-direction:column}
      .tabs{width:100%}.tab{flex:1}
      .filter-bar{grid-template-columns:1fr 1fr}
      .global-search{width:150px}
      .sidebar.left,.sidebar.right{
        position:fixed;top:auto;right:0;bottom:67px;left:0;z-index:30;width:auto;
        max-height:min(78vh,720px);overflow:auto;border:1px solid var(--line);border-bottom:0;
        border-radius:20px 20px 0 0;background:#fff;box-shadow:0 -18px 46px rgba(35,39,68,.18);
        transform:translateY(calc(100% + 90px));transition:transform .28s cubic-bezier(.22,.8,.25,1)
      }
      .sidebar.left{border-right:1px solid var(--line)}
      .sidebar.right{border-left:1px solid var(--line)}
      body.mobile-structure-open .sidebar.left,body.mobile-settings-open .sidebar.right{transform:translateY(0)}
      .side-head{padding-top:22px}
      .side-head:before{
        position:absolute;top:8px;left:50%;width:44px;height:4px;content:"";border-radius:9px;
        background:#d9dbe5;transform:translateX(-50%)
      }
      .column-list{grid-template-columns:1fr}
      .column-item{min-height:64px;padding:9px 10px}
      .drag{min-width:38px;min-height:44px;border-radius:9px;color:var(--primary);background:#f0eeff;font-size:16px}
      .sheet-backdrop{
        position:fixed;inset:70px 0 67px;z-index:25;display:block;visibility:hidden;
        opacity:0;background:rgba(29,32,52,.28);backdrop-filter:blur(2px);transition:.22s
      }
      body.mobile-structure-open .sheet-backdrop,body.mobile-settings-open .sheet-backdrop{visibility:visible;opacity:1}
      .mobile-nav{
        position:fixed;right:8px;bottom:7px;left:8px;z-index:40;display:grid;
        grid-template-columns:repeat(4,1fr);gap:4px;padding:5px;border:1px solid rgba(218,220,232,.9);
        border-radius:15px;background:rgba(255,255,255,.94);box-shadow:0 8px 30px rgba(34,38,65,.16);
        backdrop-filter:blur(18px);padding-bottom:max(5px,env(safe-area-inset-bottom))
      }
      .mobile-nav button{
        min-height:50px;display:grid;place-items:center;gap:2px;padding:5px;border:0;border-radius:11px;
        color:#858a9c;background:transparent;font-size:9px;font-weight:700
      }
      .mobile-nav button b{font-size:18px;font-weight:500;line-height:1}
      .mobile-nav button.active{color:var(--primary);background:#f0eeff}
      .toast{right:12px;bottom:82px;left:12px;text-align:center}
    }
    @@media(max-width:500px){
      .brand h1{font-size:12px}.brand-icon{width:34px;height:34px}.topbar{padding:0 10px}
      .column-list{grid-template-columns:1fr}.filter-bar{grid-template-columns:1fr}.filter-bar .btn{width:100%}
      .table-toolbar{align-items:flex-start;flex-direction:column}.toolbar-group{width:100%}.global-search{width:100%}
    }
    @@media(max-width:640px){
      .filter-bar{display:flex!important;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x proximity}
      .filter-bar[style*="display: none"]{display:none!important}
      .filter-box{min-width:155px;scroll-snap-align:start}
      .filter-bar>.btn{min-width:90px}
      .table-wrap{min-height:300px;padding:10px;background:#f6f7fb}
      table{min-width:0;border-collapse:separate}
      thead{display:none!important}
      tbody{display:grid;gap:9px}
      tbody tr{
        display:block;overflow:hidden;border:1px solid #e0e2eb;border-radius:11px;
        background:#fff;box-shadow:0 3px 10px rgba(40,45,72,.05)
      }
      tbody tr:hover{background:#fff}
      tbody tr.selected{background:#f8f7ff;box-shadow:inset 3px 0 var(--primary),0 4px 12px rgba(108,92,231,.08)}
      tbody td{
        display:grid;grid-template-columns:minmax(92px,36%) minmax(0,1fr);align-items:center;
        gap:10px;min-height:43px;padding:9px 11px!important;text-align:left!important;white-space:normal
      }
      tbody td:before{
        content:attr(data-label);color:#8a8fa0;font-size:8px;font-weight:800;letter-spacing:.04em;text-transform:uppercase
      }
      .identity{justify-content:flex-start}.progress-track{width:min(90px,100%)}
      .pagination{align-items:flex-start;gap:8px;flex-direction:column}.pages{width:100%;overflow-x:auto}
      .page{flex:0 0 30px}
      .json-editor{min-height:60vh;font-size:10px}
    }
  </style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css">
<style>
/* Report Studio v3 — preserves v2 shell, adds responsive runtime. */
:root{--primary:#7759ed;--primary-2:#9476ff;--primary-soft:#f2edff}
[hidden]{display:none!important}.r-table thead[hidden]{display:none!important}.preview-stage.mobile-mode .icon-only-actions .report-actions .action-label{display:none}
