@Html.AntiForgeryToken()
<div class="app">
  <header class="topbar">
    <div class="brand"><div class="brand-icon">▦</div><div><h1>REPORT STUDIO 3</h1><p>NETReport · mobile first</p></div></div>
    <div class="top-actions"><details id="builderFiles" class="builder-files"><summary class="btn" aria-label="Tệp và lịch sử">☰</summary><div class="builder-file-options"><button type="button" data-file-command="import">Import cấu hình JSON</button><button type="button" data-file-command="download">Tải cấu hình JSON</button><button type="button" data-file-command="undo">↶ Hoàn tác</button></div></details>
      <button class="btn" id="undoBtn" title="Hoàn tác" aria-label="Hoàn tác">↶</button>
      <button class="btn" id="importBtn"><i class="fa fa-upload" aria-hidden="true"></i> Import</button>
