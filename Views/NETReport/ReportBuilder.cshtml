  function resolve(scope){if(scope==='column')return selectedColumn();if(scope==='table')return config.table;if(scope==='display')return config.display;const [kind,id]=scope.split(':');return config[{group:'groups',filter:'filters',action:'actions',rule:'rowRules'}[kind]]?.find(x=>x.id===id);}
  function update(scope,path,value){mutate(()=>{const target=resolve(scope);if(!target)throw Error('Không tìm thấy đối tượng chỉnh sửa.');if(scope==='column'){
      if(path==='key'){const old=target.key;config.filters.forEach(f=>{if(f.field===old){f.field=value;delete filterValues[f.id];}});config.rowRules.forEach(r=>{if(r.field===old)r.field=value;});if(sort.key===old)sort.key=value;runtimeHidden.delete(old);}
      if(path==='mobileRole'&&value==='primary')config.columns.forEach(c=>{if(c.id!==target.id&&c.mobileRole==='primary')c.mobileRole='summary';});
      if(path==='fixed'&&value&&target.groupId)throw Error('Bỏ nhóm tiêu đề trước khi cố định cột.');
      if(path==='aggregate')value=value?'sum':'';
    }if(scope.startsWith('filter:')){delete filterValues[target.id];page=1;if(path==='component'&&!filterOperators(value).includes(target.operator))target.operator=filterOperators(value)[0];}
    if(scope==='display'&&path==='filterOpen')filtersOpen=value;
