@{
    ViewData["Title"] = "KOA Auto Reply";
    Layout = "_BlankLayout";
    var chatHistory = ViewData["ChatHistory"] as List<KOAHome.Models.ChatHistoryModel>;

}
@section VendorStyles {
    @* chat *@
    <link rel="stylesheet" href="~/vendor/css/pages/app-chat.css" />
}
@section PageScripts {
    <script src="~/js/app-chat.js"></script>
    <script>
        $(document).ready(function () {const $chatList = $(".chat-history-body ul"); // Selector chứa các thẻ <li>
      
          const $historyContainer = $(".chat-history-body");

          // Hàm cuộn xuống cuối
          function scrollToBottom() {
              $historyContainer.stop().animate({
                  scrollTop: $historyContainer[0].scrollHeight
              }, 300);
          }
          const modelData = {
              gemini: [
                  { value: 'gemini-2.5-flash', text: 'gemini-2.5-flash' },
                  { value: 'gemini-2.5-flash-lite', text: 'gemini-2.5-flash-lite' }
              ],
              openrouter: [
                  { value: 'deepseek/deepseek-chat', text: 'deepseek-chat' },
                  { value: 'deepseek/deepseek-r1-0528', text: 'deepseek-r1-0528' },
                  { value: 'deepseek/deepseek-r1-0528:free', text: 'deepseek-r1-0528:free' },
                  { value: 'minimax/minimax-m2.5', text: 'minimax-m2.5' }
              ]
          };

          const providerSelect = document.getElementById('selectedProvider');
          const modelSelect = document.getElementById('selectedModel');

          function updateModels() {
              const selected = providerSelect.value;
              const models = modelData[selected] || [];
    
              // Xóa sạch các option cũ và render option mới
              modelSelect.innerHTML = models.map(m => 
                  `<option value="${m.value}">${m.text}</option>`
              ).join('');
          }
          updateModels();

          // Hàm hỗ trợ tạo mẫu tin nhắn (Phía bên phải - User)
          function appendUserMessage(text, shortname) {
              const now = new Date();
              const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
              const messageHtml = `
                  <li class="chat-message chat-message-right">
                      <div class="d-flex overflow-hidden">
                          <div class="chat-message-wrapper flex-grow-1 w-50">
                              <div class="chat-message-text">
                                  <p class="mb-0">${text}</p>
                              </div>
                              <div class="text-end text-body-secondary mt-1">
                                  <i class="icon-base ri ri-check-double-line icon-16px me-1"></i>
                                  <small>${timeStr}</small>
                              </div>
                          </div>
                          <div class="user-avatar flex-shrink-0 ms-4">
                              <div class="avatar avatar-sm">
                                  <span class="avatar-initial rounded-circle bg-label-primary">${shortname ?? "ME"}</span>
                              </div>
                          </div>
                      </div>
                  </li>`;
        
              // Giả sử container chứa các thẻ <li> là một thẻ <ul> có class .chat-history-list
              // Hoặc bạn trỏ trực tiếp vào class chứa tin nhắn
              $(".chat-history-body ul").append(messageHtml);
        
              // Tự động cuộn xuống cuối (tận dụng hàm scrollTo của PerfectScrollbar hoặc JS thuần)
              const historyBody = document.querySelector(".chat-history-body");
              if(historyBody) {
                  historyBody.scrollTo(0, historyBody.scrollHeight);
              }
          }

          function appendAiLoading() {
                const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const tempId = "ai-loading-" + Date.now();
                const html = `
                    <li class="chat-message" id="${tempId}">
                        <div class="d-flex overflow-hidden">
                            <div class="user-avatar flex-shrink-0 me-4">
                                <div class="avatar avatar-sm">
                                    <span class="avatar-initial rounded-circle bg-label-secondary"><img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;"></span>
                                </div>
                            </div>
                            <div class="chat-message-wrapper flex-grow-1 w-50">
                                <div class="chat-message-text">
                                    <p class="mb-0 ai-content">KOA Home đang suy nghĩ...</p>
                                </div>
                                <div class="text-body-secondary mt-1">
                                    <small>${timeStr}</small>
                                </div>
                            </div>
                        </div>
                    </li>`;
                $chatList.append(html);
                scrollToBottom();
                return tempId;
            }

            $("#btn-send").click(function () {
                var message = $("#Message").val();
                var provider = $("#selectedProvider").val();
                var model = $("#selectedModel").val();
                var bookingId = "@ViewBag.BookingID";
                var logoShortName = "@ViewBag.ShortName"

                if (!message) {
                    alert("Vui lòng nhập tin nhắn!");
                    return;
                }
                // --- BƯỚC BỔ SUNG: Hiển thị tin nhắn người dùng lên HTML ngay lập tức ---
                appendUserMessage(message, logoShortName);
                $("#Message").val(""); // Xóa trống ô nhập liệu

                // Hiển thị bong bóng chat AI (trạng thái chờ)
                const aiMsgId = appendAiLoading();
                $("#btn-send").prop("disabled", true);

                $.ajax({
                    url: '/HomestayAi/Index', // Đường dẫn tới Action trong Controller
                    type: 'POST',
                    data: {
                        selectedProvider: provider,
                        selectedModel: model,
                        Message: message,
                        BookingID: bookingId
                    },
                    success: function (res) {
                      // Cập nhật nội dung AI trả về vào bong bóng chat đang chờ
                      $(`#${aiMsgId} .ai-content`).html(res.replace(/\n/g, "<br>"));
                    },
                    error: function (xhr) {
                      let errorMsg = "Lỗi kết nối với trợ lý.";
                      if(xhr.status == 400) errorMsg = "Model không hỗ trợ tham số này.";
                      $(`#${aiMsgId} .ai-content`).html(`<span class="text-danger">${errorMsg}</span>`);
                    },
                    complete: function () {
                        $("#btn-send").prop("disabled", false);
                        scrollToBottom();
                    }
                });
            });
        function renderChatHistory(chatHistory) {
            var timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            var html = '';

            if (!chatHistory || chatHistory.length === 0) {

                html = `
                <li class="chat-message">
                    <div class="d-flex overflow-hidden">
                        <div class="user-avatar flex-shrink-0 me-4">
                            <div class="avatar avatar-sm">
                                <span class="avatar-initial rounded-circle bg-label-secondary"><img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;"></span>
                            </div>
                        </div>
                        <div class="chat-message-wrapper flex-grow-1 w-50">
                            <div class="chat-message-text">
                                <p class="mb-0 ai-content">Chào bạn, mình là trợ lý đắc thủ của KOA. Mình có thể hỗ trợ gì cho bạn? </p>
                            </div>
                            <div class="text-body-secondary mt-1">
                                  <small>${timeStr}</small>
                            </div>
                        </div>
                    </div>
                </li>
                `;

                $("#chat-history").html(html);
                return; // ⛔ dừng tại đây
            }
            chatHistory.forEach(function (msg) {

                if (msg.role === "user") {

                    html += `
                    <li class="chat-message chat-message-right">
                        <div class="d-flex overflow-hidden">
                            <div class="chat-message-wrapper flex-grow-1 w-50">
                                <div class="chat-message-text">
                                    <p class="mb-0">${msg.parts.replace(/\n/g, "<br>")}</p>
                                </div>
                                <div class="text-end text-body-secondary mt-1">
                                    <i class="icon-base ri ri-check-double-line icon-16px me-1"></i>
                                      <small>${timeStr}</small>
                                </div>
                            </div>
                            <div class="user-avatar flex-shrink-0 ms-4">
                                <div class="avatar avatar-sm">
                                    <span class="avatar-initial rounded-circle bg-label-primary">GUEST</span>
                                </div>
                            </div>
                        </div>
                    </li>
                    `;
                }
                else {

                    html += `
                    
                    <li class="chat-message">
                        <div class="d-flex overflow-hidden">
                            <div class="user-avatar flex-shrink-0 me-4">
                                <div class="avatar avatar-sm">
                                      <span class="avatar-initial rounded-circle bg-label-secondary"><img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;"></span>
                                </div>
                            </div>
                            <div class="chat-message-wrapper flex-grow-1 w-50">
                                <div class="chat-message-text">
                                      <p class="mb-0 ai-content">${msg.parts.replace(/\n/g, "<br>")} </p>
                                </div>
                                <div class="text-body-secondary mt-1">
                                    <small>${timeStr}</small>
                                </div>
                            </div>
                        </div>
                    </li>
                    `;
                }
            });

            $("#chat-history").html(html);
        }

        $("#selectedProvider").change(function () {
          updateModels();
          var provider = $(this).val();

          $.ajax({
              url: '/HomestayAi/GetChatHistoryByProvider',
              type: 'GET',
              data: {
                  provider: provider
              },
              beforeSend: function () {
                  $("#chat-history").html("<p>Đang tải...</p>");
              },
              success: function (response) {
                  renderChatHistory(response);
              },
              error: function () {
                  alert("Lỗi khi tải lịch sử chat");
              }
          });

      });
        });
</script>

}

<!-- Content wrapper -->
<div class="content-wrapper">
<!-- Content -->
<div class="container-xxl flex-grow-1 container-p-y" style="background:#ffffff;border-radius:5px">
  <div class="card">
    <div class="card-header bg-label-primary d-flex justify-content-sm-between align-items-sm-center flex-column flex-sm-row">
        <h5 class="card-title mb-sm-0 me-2" style="">Trợ lý KOA</h5>
    </div>
  </div>

  <div id="chat-container">
      <div class="form-group">
          <label for="selectedProvider">Chọn hãng AI:</label>
          <select id="selectedProvider" name="selectedProvider" class="form-control">
              <option value="gemini"selected>Gemini</option>
              <option value="openrouter">Open Router</option>
          </select>
      </div>
      <div class="form-group mt-2">
          <label for="selectedModel">Chọn phiên bản AI:</label>
          <select id="selectedModel" name="selectedModel" class="form-control">
              <option value="gemini-2.5-flash"selected>gemini-2.5-flash</option>
              <option value="gemini-2.5-flash-lite">gemini-2.5-flash-lite</option>
              <option value="deepseek/deepseek-chat">deepseek-chat</option>
              <option value="deepseek/deepseek-r1-0528">deepseek-r1-0528</option>
              <option value="deepseek/deepseek-r1-0528:free">deepseek-r1-0528:free</option>
              <option value="minimax/minimax-m2.5">minimax-m2.5</option>
          </select>
      </div>
  </div>
    <div class="app-chat overflow-hidden">

        <div class="row g-0">
            <!-- /Chat contacts -->
            <!-- Chat History -->
            <div class="col app-chat-history d-block" id="app-chat-history">
                <div class="chat-history-wrapper">
                    <div class="chat-history-header border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex overflow-hidden align-items-center">
                                <i class="icon-base ri ri-menu-line icon-lg cursor-pointer d-lg-none d-block me-4" data-bs-toggle="sidebar" data-overlay data-target="#app-chat-contacts"></i>
                                <div class="flex-shrink-0 avatar avatar-online">
                                    <img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;">
                                </div>
                                <div class="chat-contact-info flex-grow-1 ms-4">
                                    <h6 class="m-0 fw-normal text-white">KOA Kaka</h6>
                                    <small class="user-status">Trợ lý ảo của KOA Rental Home</small>
                                </div>
                            </div>
                            <div class="d-flex chat-container-items-center">
                                <span class="btn btn-text-light cursor-pointer d-sm-inline-flex d-none me-1 btn-icon rounded-pill">
                                    <i class="icon-base ri ri-phone-line icon-22px"></i>
                                </span>
                                <span class="btn btn-text-light cursor-pointer d-sm-inline-flex d-none me-1 btn-icon rounded-pill">
                                    <i class="icon-base ri ri-video-add-line icon-22px"></i>
                                </span>
                                <span class="btn btn-text-light cursor-pointer d-sm-inline-flex d-none me-1 btn-icon rounded-pill">
                                    <i class="icon-base ri ri-search-line icon-22px"></i>
                                </span>
                                <div class="dropdown">
                                    <button class="btn btn-icon btn-text-light rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="true" id="chat-header-actions"><i class="icon-base ri ri-more-2-line icon-22px"></i></button>
                                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="chat-header-actions">
                                        <a class="dropdown-item" href="javascript:void(0);">View Contact</a>
                                        <a class="dropdown-item" href="javascript:void(0);">Mute Notifications</a>
                                        <a class="dropdown-item" href="javascript:void(0);">Block Contact</a>
                                        <a class="dropdown-item" href="javascript:void(0);">Clear Chat</a>
                                        <a class="dropdown-item" href="javascript:void(0);">Report</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="chat-history-body">
                        <ul class="list-unstyled chat-history" id="chat-history">
                        @{
                          string timeStr = DateTime.Now.ToString("HH:mm");
                          if (chatHistory != null && chatHistory.Count > 0)
                          {
                              @foreach (var msg in chatHistory)
                              {
                                  if (msg.Role == "user")
                                  {
                                      <li class="chat-message chat-message-right">
                                          <div class="d-flex overflow-hidden">
                                              <div class="chat-message-wrapper flex-grow-1 w-50">
                                                  <div class="chat-message-text">
                                                      <p class="mb-0">@Html.Raw(msg.Parts.Replace("\n", "<br>"))</p>
                                                  </div>
                                                  <div class="text-end text-body-secondary mt-1">
                                                      <i class="icon-base ri ri-check-double-line icon-16px me-1"></i>
                                                      <small>@timeStr</small>
                                                  </div>
                                              </div>
                                              <div class="user-avatar flex-shrink-0 ms-4">
                                                  <div class="avatar avatar-sm">
                                                      <span class="avatar-initial rounded-circle bg-label-primary">GUEST</span>
                                                  </div>
                                              </div>
                                          </div>
                                      </li>
                                  }
                                  else{
                                    <li class="chat-message">
                                        <div class="d-flex overflow-hidden">
                                            <div class="user-avatar flex-shrink-0 me-4">
                                                <div class="avatar avatar-sm">
                                                    <span class="avatar-initial rounded-circle bg-label-secondary"><img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;"></span>
                                                </div>
                                            </div>
                                            <div class="chat-message-wrapper flex-grow-1 w-50">
                                                <div class="chat-message-text">
                                                    <p class="mb-0 ai-content">@Html.Raw(msg.Parts.Replace("\n", "<br>")) </p>
                                                </div>
                                                <div class="text-body-secondary mt-1">
                                                    <small>@timeStr</small>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    }
                                }
                          }
                          else {
                              <li class="chat-message" id="${tempId}">
                                  <div class="d-flex overflow-hidden">
                                      <div class="user-avatar flex-shrink-0 me-4">
                                          <div class="avatar avatar-sm">
                                              <span class="avatar-initial rounded-circle bg-label-secondary"><img src="/img/icons/koa/koa-chatbot.png" alt="Scroll To Top" style="width:50px; height:50px;"></span>
                                          </div>
                                      </div>
                                      <div class="chat-message-wrapper flex-grow-1 w-50">
                                          <div class="chat-message-text">
                                              <p class="mb-0 ai-content">Chào bạn, mình là trợ lý đắc thủ của KOA. Mình có thể hỗ trợ gì cho bạn? </p>
                                          </div>
                                          <div class="text-body-secondary mt-1">
                                            <small>@timeStr</small>
                                        </div>
                                      </div>
                                  </div>
                              </li>
                          }
                        }
                        </ul>
                    </div>

                    <!-- Chat message form -->
                    <div class="chat-history-footer shadow-xs">
                        <form class="form-send-message d-flex justify-content-between align-items-center ">
                            <input id="Message" class="form-control message-input border-0 me-4 shadow-none" placeholder="Bạn cần gì ạ?..." />
                            <div class="message-actions d-flex align-items-center">
                                <span class="btn btn-text-secondary btn-icon rounded-pill cursor-pointer">
                                    <i class="speech-to-text icon-base ri ri-mic-line icon-md text-heading"></i>
                                </span>
                                <button class="btn btn-primary d-flex send-msg-btn" id="btn-send">
                                    <span class="align-middle d-md-inline-block d-none">Gửi</span>
                                    <i class="icon-base ri ri-send-plane-line icon-sm ms-md-2 ms-0"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- /Chat History -->

            <div class="app-overlay"></div>
        </div>
    </div>
    
    <a type="button" href="javascript:history.back()" class="btn btn-outline-secondary btn-prev waves-effect" style="display: inline-block;">
        <i class="icon-base ri ri-arrow-left-line icon-sm me-sm-1 me-0"></i>
        <span class="align-middle d-sm-inline-block d-none">Quay lại</span>
    </a>
    <div class="buy-now">
        <a href="#" id="scrollToTopBtn" class="btn btn-danger btn-buy-now waves-effect waves-light"><i class="ri-arrow-up-double-fill"></i></a>
    </div>
</div>
<!-- / Content -->

</div>

