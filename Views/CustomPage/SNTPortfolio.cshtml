@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Giới thiệu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thiện — Kỹ sư hệ thống giải pháp động</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #eef3ff;
            --bg-soft: #dfe9fd;
            --surface: #ffffff;
            --navy: #0d2358;
            --navy-2: #153274;
            --blue: #3b63e0;
            --blue-light: #7ea0f5;
            --purple: #9b7ff2;
            --coral: #ff8a8f;
            --ink: #1c2440;
            --ink-soft: #5b6690;
            --line: #c7d6fb;
            --radius-lg: 28px;
            --radius-md: 18px;
            --shadow: 0 20px 45px -20px rgba(13,35,88,0.25);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: 'Be Vietnam Pro', sans-serif;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        h1, h2, h3, .display {
            font-family: 'Baloo 2', sans-serif;
            color: var(--navy);
            margin: 0;
            line-height: 1.15;
        }

        p {
            margin: 0;
        }

        a {
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .mono {
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: 0.02em;
        }

        .wrap {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 28px;
            position: relative;
        }

        section {
            position: relative;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12.5px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--blue);
            background: rgba(59,99,224,0.08);
            border: 1px solid rgba(59,99,224,0.25);
            padding: 6px 14px;
            border-radius: 100px;
        }

            .eyebrow::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--coral);
                flex: none;
            }

        /* ---------- NAV ---------- */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 16px 0;
            transition: background .3s ease, box-shadow .3s ease, padding .3s ease;
        }

            header.scrolled {
                background: rgba(238,243,255,0.85);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                box-shadow: 0 8px 30px -18px rgba(13,35,88,0.35);
                padding: 11px 0;
            }

        .nav-inner {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Baloo 2', sans-serif;
            font-weight: 700;
            font-size: 19px;
            color: var(--navy);
            text-decoration: none;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(145deg, var(--blue), var(--navy-2));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 6px 14px -4px rgba(59,99,224,0.6);
            flex: none;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 30px;
            margin: 0;
            padding: 0;
        }

        nav a {
            text-decoration: none;
            font-size: 14.5px;
            font-weight: 500;
            color: var(--ink-soft);
            position: relative;
            padding: 4px 0;
            transition: color .2s ease;
        }

            nav a:hover {
                color: var(--blue);
            }

            nav a::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -2px;
                width: 0%;
                height: 2px;
                background: var(--blue);
                transition: width .25s ease;
            }

            nav a:hover::after {
                width: 100%;
            }

        .nav-cta {
            background: var(--navy);
            color: #fff !important;
            padding: 9px 18px;
            border-radius: 100px;
            font-size: 13.5px;
            font-weight: 600;
        }

            .nav-cta::after {
                display: none;
            }

        .nav-toggle {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--surface);
            border: 1px solid var(--line);
            cursor: pointer;
            padding: 0;
            flex: none;
        }

            .nav-toggle span {
                display: block;
                width: 18px;
                height: 2px;
                margin: 0 auto;
                background: var(--navy);
                border-radius: 2px;
                transition: transform .25s ease, opacity .25s ease;
            }

            .nav-toggle.open span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .nav-toggle.open span:nth-child(2) {
                opacity: 0;
            }

            .nav-toggle.open span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        .mobile-menu {
            display: none;
            flex-direction: column;
            gap: 2px;
            max-width: 1120px;
            margin: 10px auto 0;
            padding: 10px 28px 18px;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height .3s ease, opacity .25s ease, padding .3s ease;
        }

            .mobile-menu.open {
                max-height: 320px;
                opacity: 1;
                padding: 10px 28px 22px;
                background: rgba(238,243,255,0.97);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                box-shadow: 0 14px 30px -16px rgba(13,35,88,0.35);
                border-radius: 0 0 18px 18px;
            }

            .mobile-menu a {
                text-decoration: none;
                color: var(--ink);
                font-weight: 600;
                font-size: 16px;
                padding: 13px 6px;
                border-bottom: 1px solid var(--line);
            }

                .mobile-menu a.nav-cta {
                    text-align: center;
                    border-bottom: none;
                    margin-top: 8px;
                    color: #fff !important;
                }

        /* ---------- FLOW LINE (signature element) ---------- */
        .story-flow-wrap {
            position: relative;
        }

        .flow-line {
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            transform: translateX(-50%);
            background: repeating-linear-gradient( to bottom, var(--blue) 0px, var(--blue) 8px, transparent 8px, transparent 16px );
            opacity: 0.35;
            z-index: 0;
        }

        .flow-node {
            position: absolute;
            left: 50%;
            transform: translate(-50%,-50%);
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--surface);
            border: 3px solid var(--blue);
            z-index: 1;
        }

        .flow-tag {
            position: absolute;
            left: 50%;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--purple);
            background: #fff;
            border: 1px solid var(--line);
            padding: 3px 9px;
            border-radius: 6px;
            white-space: nowrap;
            transform: translateX(-50%);
            box-shadow: 0 6px 16px -8px rgba(13,35,88,0.3);
        }

        /* ---------- BUTTONS ---------- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 26px;
            border-radius: 100px;
            font-family: 'Be Vietnam Pro', sans-serif;
            font-weight: 600;
            font-size: 15px;
            text-decoration: none;
            border: 2px solid transparent;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .btn-primary {
            background: var(--blue);
            color: #fff;
            box-shadow: 0 14px 30px -12px rgba(59,99,224,0.65);
        }

            .btn-primary:hover {
                transform: translateY(-3px);
                box-shadow: 0 18px 34px -12px rgba(59,99,224,0.75);
            }

        .btn-ghost {
            background: transparent;
            border-color: var(--navy);
            color: var(--navy);
        }

            .btn-ghost:hover {
                background: var(--navy);
                color: #fff;
                transform: translateY(-3px);
            }

        .btn-coral {
            background: var(--coral);
            color: #fff;
            box-shadow: 0 14px 30px -12px rgba(255,138,143,0.7);
        }

            .btn-coral:hover {
                transform: translateY(-3px);
            }

        /* ---------- SPEECH BUBBLE ---------- */
        .bubble {
            position: relative;
            background: #fff;
            border: 2px solid var(--line);
            border-radius: 20px;
            padding: 14px 20px;
            font-family: 'Baloo 2', sans-serif;
            font-weight: 600;
            font-size: 15.5px;
            color: var(--navy);
            box-shadow: var(--shadow);
        }

            .bubble.blue {
                border-color: var(--blue-light);
            }

            .bubble .tail {
                position: absolute;
                width: 20px;
                height: 20px;
                background: #fff;
                border-right: 2px solid var(--line);
                border-bottom: 2px solid var(--line);
            }

        /* ---------- HERO ---------- */
        .hero {
            padding: 150px 0 110px;
            overflow: hidden;
        }

        .hero-bg-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.5;
            z-index: 0;
        }

        .blob1 {
            width: 420px;
            height: 420px;
            background: var(--blue-light);
            top: -120px;
            right: -100px;
        }

        .blob2 {
            width: 320px;
            height: 320px;
            background: var(--purple);
            opacity: 0.25;
            bottom: -60px;
            left: -100px;
        }

        .hero .wrap {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 40px;
            align-items: center;
            z-index: 1;
        }

        .hero h1 {
            font-size: clamp(34px, 5vw, 54px);
            font-weight: 800;
            margin: 18px 0 20px;
        }

            .hero h1 .accent {
                color: var(--blue);
            }

        .hero p.lede {
            font-size: 17.5px;
            color: var(--ink-soft);
            max-width: 480px;
            line-height: 1.65;
            margin-bottom: 32px;
        }

        .hero-ctas {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .hero-visual {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: flex-end;
        }

            .hero-visual img {
                width: 340px;
                position: relative;
                z-index: 1;
                animation: float 5s ease-in-out infinite;
                filter: drop-shadow(0 30px 30px rgba(13,35,88,0.25));
            }

        .hero-bubble {
            position: absolute;
            top: 2%;
            left: -18%;
            width: 270px;
            max-width: none;
            z-index: 2;
            animation: float 5s ease-in-out infinite;
            animation-delay: .3s;
        }

            .hero-bubble .tail {
                bottom: -9px;
                right: 38%;
                transform: rotate(45deg);
            }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-14px);
            }
        }

        .badge-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 34px;
        }

            .badge-row span {
                font-family: 'JetBrains Mono', monospace;
                font-size: 12px;
                color: var(--ink-soft);
                background: var(--surface);
                border: 1px solid var(--line);
                padding: 6px 12px;
                border-radius: 8px;
            }

        /* ---------- SECTION HEADERS ---------- */
        .section-head {
            text-align: center;
            max-width: 640px;
            margin: 0 auto 56px;
            position: relative;
            z-index: 1;
        }

            .section-head h2 {
                font-size: clamp(28px,3.6vw,40px);
                margin-top: 16px;
            }

            .section-head p {
                color: var(--ink-soft);
                font-size: 16px;
                margin-top: 14px;
                line-height: 1.6;
            }

        section.pad {
            padding: 110px 0;
        }

        /* ---------- STORY / TIMELINE ---------- */
        .timeline {
            display: flex;
            flex-direction: column;
            gap: 64px;
            position: relative;
            z-index: 1;
        }

        .t-item {
            display: grid;
            grid-template-columns: 1fr;
            max-width: 520px;
        }

            .t-item:nth-child(odd) {
                margin-right: auto;
            }

            .t-item:nth-child(even) {
                margin-left: auto;
            }

                .t-item:nth-child(even) .t-card {
                    border-radius: 20px 4px 20px 20px;
                }

            .t-item:nth-child(odd) .t-card {
                border-radius: 4px 20px 20px 20px;
            }

        .t-num {
            font-family: 'Baloo 2', sans-serif;
            font-weight: 800;
            font-size: 13px;
            color: var(--blue);
            background: rgba(59,99,224,0.1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 100px;
            margin-bottom: 12px;
        }

        .t-card {
            background: var(--surface);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            padding: 24px 26px;
        }

            .t-card h3 {
                font-size: 20px;
                margin-bottom: 8px;
            }

            .t-card p {
                color: var(--ink-soft);
                font-size: 15px;
                line-height: 1.6;
            }

        .t-quip {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px dashed var(--line);
        }

            .t-quip img {
                width: 36px;
                height: auto;
                flex: none;
                border-radius: 50%;
                background: var(--bg-soft);
                padding: 2px;
            }

            .t-quip span {
                font-family: 'Baloo 2', sans-serif;
                font-size: 14px;
                color: var(--navy-2);
                font-weight: 600;
            }

        /* ---------- SYSTEM SECTION ---------- */
        .system-intro {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 48px;
            align-items: center;
            margin-bottom: 70px;
            position: relative;
            z-index: 1;
        }

            .system-intro img {
                width: 100%;
                max-width: 300px;
                margin: 0 auto;
            }

            .system-intro .bubble {
                margin-top: 18px;
                max-width: 300px;
            }

        .system-copy p {
            color: var(--ink-soft);
            font-size: 16.5px;
            line-height: 1.75;
            margin-bottom: 16px;
        }

        .system-copy strong {
            color: var(--navy);
        }

        .flow-diagram {
            background: var(--navy);
            border-radius: var(--radius-lg);
            padding: 44px 32px;
            margin-bottom: 60px;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

            .flow-diagram::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
                background-size: 22px 22px;
            }

        .flow-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .flow-box {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            color: #fff;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.25);
            padding: 10px 18px;
            border-radius: 10px;
            text-align: center;
        }

            .flow-box.main {
                background: var(--coral);
                border-color: var(--coral);
                font-weight: 600;
                color: #2a0d0e;
            }

        .flow-arrow {
            color: rgba(255,255,255,0.4);
            font-size: 18px;
        }

        .flow-outputs {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 26px;
            position: relative;
            z-index: 1;
        }

            .flow-outputs .flow-box {
                background: rgba(155,127,242,0.18);
                border-color: rgba(155,127,242,0.5);
            }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            position: relative;
            z-index: 1;
        }

        .feature-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            padding: 26px 24px;
            box-shadow: var(--shadow);
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .feature-card:hover {
                transform: translateY(-6px);
            }

            .feature-card .icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 16px;
                color: #fff;
            }

            .feature-card:nth-child(1) .icon {
                background: var(--blue);
            }

            .feature-card:nth-child(2) .icon {
                background: var(--purple);
            }

            .feature-card:nth-child(3) .icon {
                background: var(--coral);
            }

            .feature-card:nth-child(4) .icon {
                background: var(--navy-2);
            }

            .feature-card:nth-child(5) .icon {
                background: #4fb0a5;
            }

            .feature-card h3 {
                font-size: 17.5px;
                margin-bottom: 8px;
            }

            .feature-card p {
                font-size: 14px;
                color: var(--ink-soft);
                line-height: 1.6;
            }

        /* ---------- PROJECTS ---------- */
        .project-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
            position: relative;
            z-index: 1;
        }

        .project-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
        }

            .project-card.featured {
                grid-column: 1 / -1;
            }

        .p-top {
            height: 6px;
            background: linear-gradient(90deg, var(--blue), var(--purple));
        }

        .project-card.featured .p-top {
            background: linear-gradient(90deg, var(--coral), var(--purple));
        }

        .p-body {
            padding: 26px 26px 24px;
        }

        .p-status {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: #4fb0a5;
            background: rgba(79,176,165,0.12);
            border: 1px solid rgba(79,176,165,0.4);
            padding: 4px 10px;
            border-radius: 100px;
            display: inline-block;
            margin-bottom: 12px;
        }

        .p-body h3 {
            font-size: 19px;
            margin-bottom: 8px;
        }

        .p-body p {
            font-size: 14.5px;
            color: var(--ink-soft);
            line-height: 1.65;
            margin-bottom: 16px;
        }

        .tag-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .tag-row span {
                font-family: 'JetBrains Mono', monospace;
                font-size: 11.5px;
                color: var(--navy-2);
                background: var(--bg-soft);
                padding: 4px 10px;
                border-radius: 6px;
            }

        /* ---------- CONTACT ---------- */
        .contact {
            background: var(--navy);
            border-radius: var(--radius-lg);
            padding: 70px 48px;
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            align-items: center;
            gap: 40px;
            z-index: 1;
        }

            .contact::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
                background-size: 20px 20px;
            }

        .contact-visual {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: center;
        }

            .contact-visual img {
                width: 230px;
                transform: scaleX(-1);
                filter: drop-shadow(0 20px 24px rgba(0,0,0,0.35));
            }

        .contact-copy {
            position: relative;
            z-index: 1;
        }

            .contact-copy .eyebrow {
                background: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.3);
                color: #bcd0ff;
            }

            .contact-copy h2 {
                color: #fff;
                font-size: clamp(26px,3.4vw,36px);
                margin: 16px 0 14px;
            }

            .contact-copy p.lede {
                color: #c6d3f5;
                font-size: 16px;
                line-height: 1.65;
                margin-bottom: 26px;
                max-width: 440px;
            }

        .contact-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 28px;
        }

            .contact-list a {
                text-decoration: none;
                color: #e8edff;
                font-size: 14.5px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: 'JetBrains Mono', monospace;
            }

                .contact-list a span.dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--coral);
                    flex: none;
                }

        footer {
            text-align: center;
            padding: 36px 0 44px;
            color: var(--ink-soft);
            font-size: 13.5px;
            position: relative;
            z-index: 1;
        }

            footer .foot-brand {
                display: inline-flex;
                align-items: center;
