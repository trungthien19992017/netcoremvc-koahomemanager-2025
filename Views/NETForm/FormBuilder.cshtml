  function setPath(obj,path,value){const parts=path.split('.');if(parts.some(p=>['__proto__','prototype','constructor'].includes(p))||parts.length>2)throw Error('Đường dẫn thuộc tính không hợp lệ.');if(parts.length===2){obj[parts[0]]??={};if(value===undefined)delete obj[parts[0]][parts[1]];else obj[parts[0]][parts[1]]=value;}else obj[path]=value;}
  function resolveScope(scope){if(scope==='field')return selectedField();if(scope==='version')return activeVersion();if(scope==='form')return state.form;if(scope==='ui')return state.ui;if(scope.startsWith('service:'))return activeVersion().services.find(s=>sameId(s.id,scope.slice(8)));throw Error('Không tìm thấy đối tượng cần sửa.');}
  function updateProperty(scope,path,value){mutate(()=>{const target=resolveScope(scope);if(!target)throw Error('Hãy chọn trường cần sửa.');
    if(scope.startsWith('service:')&&!target.isEditable)throw Error('Service dùng chung này đang ở chế độ chỉ đọc.');
    if(scope==='field'){
      if(path==='parentId'){value=value||null;if(descendantIds(target.id).has(String(value)))throw Error('Không thể chuyển group vào chính nó.');if(target.type==='group'&&value)throw Error('Viewer chỉ hỗ trợ group một cấp.');const p=activeVersion().fields.find(f=>sameId(f.id,value));target.colSpan=Math.min(target.colSpan,p?p.colCount:rootColumns());target.order=nextOrder(value);}
      if(path==='colCount'){if(!groupCounts.includes(value))throw Error('colCount phải là số nguyên 1–12.');children(target.id).forEach(f=>f.colSpan=Math.min(f.colSpan,value));}
      if(path==='fieldTypeCode'){const definition=types.find(t=>t.fieldTypeCode===value)||defaultTypes.find(t=>t.fieldTypeCode===value);if(!definition)throw Error('Field type không tồn tại trong catalog.');if(target.type==='group'&&definition.type!=='group'&&children(target.id).length)throw Error('Chuyển các trường con ra ngoài trước khi đổi loại group.');if(definition.type==='group'&&target.parentId)throw Error('Viewer chỉ hỗ trợ group một cấp.');target.type=definition.type;if(definition.type==='group')target.colCount??=2;if(['select','radio','checkbox'].includes(definition.type))target.options??=[{label:'Lựa chọn A',value:'a'}];}
    }
    setPath(target,path,value);
  });}
  function switchVersion(id){state.activeVersionId=state.versions.find(v=>sameId(v.id,id))?.id??id;selectedFieldId=activeVersion().fields[0]?.id||null;render();}
  function forkVersion(){mutate(()=>{const source=activeVersion(),copy=clone(source),next=Math.max(0,...state.versions.map(v=>Number(v.version)||0))+1;copy.id=uid('version');copy.clientKey=copy.id;copy.version=next;copy.status='draft';copy.note='Fork từ version '+source.version;copy.lastModificationTime=null;const idMap=new Map(copy.fields.map(f=>[String(f.id),uid('fld')]));copy.fields.forEach(f=>{const old=String(f.id);f.id=idMap.get(old);f.clientKey=f.id;f.parentId=f.parentId===null?null:idMap.get(String(f.parentId));});state.versions.push(copy);state.activeVersionId=copy.id;selectedFieldId=copy.fields[0]?.id||null;},'Đã fork version '+(Math.max(0,...state.versions.map(v=>Number(v.version)||0))))}
  function duplicateField(fid){mutate(()=>{const descendant=descendantIds(fid),originals=activeVersion().fields.filter(f=>descendant.has(String(f.id))),ids=new Map(originals.map(f=>[String(f.id),uid('fld')]));for(const original of originals){const f=clone(original);f.id=ids.get(String(original.id));f.clientKey=f.id;f.parentId=ids.get(String(original.parentId))||original.parentId;f.key=uniqueKey(f.key+'_copy');if(sameId(original.id,fid)){f.label+=' (bản sao)';f.order=nextOrder(original.parentId);}activeVersion().fields.push(f);}selectedFieldId=ids.get(String(fid));},'Đã nhân bản cả cấu trúc trường');}
  function moveField(fid,direction){mutate(()=>{const f=activeVersion().fields.find(x=>sameId(x.id,fid)),siblings=children(f.parentId),at=siblings.findIndex(x=>sameId(x.id,fid)),to=at+(direction==='up'?-1:1);if(to<0||to>=siblings.length)return;[siblings[at],siblings[to]]=[siblings[to],siblings[at]];siblings.forEach((x,i)=>x.order=i+1);});}

