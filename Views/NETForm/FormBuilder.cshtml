<style>
/* v3: database-backed builder with a scoped design/runtime renderer. */
main{grid-template-columns:225px minmax(360px,1fr) 350px}
.brand b{letter-spacing:.03em}.brand small{font-size:9px}.crumb{max-width:220px}.crumb strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.canvas-wrap{inset:90px 14px 12px;padding:14px 0 70px}.form-canvas{width:100%;max-width:1100px;border-radius:16px}
.version-orb{width:54px;height:54px}.version-orb b{font-size:13px}.version-dock{left:14px;top:12px}.version-select{width:120px;margin-top:4px}
.stage-bar{left:auto;right:14px;transform:none;max-width:calc(100% - 152px)}
.stage-tab{padding:8px 10px}.stage-tab.active{color:#5e4bdc}.stage-tab i{margin-right:5px}
.palette-item{width:100%;text-align:left;color:var(--text);cursor:pointer}.palette-item .pi{font-size:13px}.palette-item small{font-weight:400}
.palette-item:focus-visible,.mini:focus-visible,.stage-tab:focus-visible{outline:2px solid #7560f4;outline-offset:2px}
.palette-note{font-size:10px;color:#697084;line-height:1.6;margin:0 15px 14px}.palette-note b{color:#6754ed}
.field-list{padding:16px;min-height:150px}.layout-ruler{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:5px;padding:10px 16px;background:#f8f7ff;border-bottom:1px solid #e9e5fa}
.layout-ruler span{height:18px;display:grid;place-items:center;color:#988dcc;font:9px DM Mono;background:#ede9fb;border-radius:3px}
.layout-caption{font-size:10px;color:#72768c;padding:9px 16px;background:#fcfbff;border-bottom:1px solid #ece9f8}
.layout-grid{display:grid;grid-template-columns:repeat(var(--cols,12),minmax(0,1fr));grid-auto-flow:row;gap:16px 14px;align-items:start;min-width:0}
.layout-item{grid-column:span var(--span,12);min-width:0;position:relative;overflow-wrap:anywhere}
.field-card{margin:0;padding:28px 9px 10px;border-radius:10px;transition:border-color .15s;min-height:86px;background:#fff}
.field-card.selected{border-color:#7966f4;box-shadow:0 0 0 1px #7966f4}.field-card.group-card{padding:28px 9px 10px;background:#faf9ff}
.field-card .drag{left:9px;top:7px;font-size:13px;line-height:16px}.field-card .field-meta{position:absolute;right:7px;top:6px;margin:0;font-size:8px;border:0;padding:2px 4px;max-width:calc(100% - 33px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.field-card .field-actions{position:static;display:flex;justify-content:flex-end;gap:4px;margin-top:8px}.field-card .mini{font-size:10px;width:24px;height:21px}
.field-card .runtime-leaf{pointer-events:none}.field-card .runtime-leaf input,.field-card .runtime-leaf textarea{min-width:0}
.group-inner{padding:15px;border:1px solid #e3dffa;border-radius:10px;background:#fff;min-width:0}
.group-heading{display:flex;align-items:center;gap:8px;margin:0 0 17px;font-size:13px;color:#5c4ac3;line-height:1.5}
.group-inner>.layout-grid{min-height:45px}.group-empty{grid-column:1/-1;border:1px dashed #bcb2eb;color:#8b80af;text-align:center;padding:16px;font-size:10px;border-radius:7px}
.group-add{width:100%;margin-top:12px;border:1px dashed #c9c0ed;color:#715cc4;background:#f8f5ff;border-radius:7px;padding:8px;font-size:10px}
.hidden-field{opacity:.55}.sort-ghost{opacity:.35}.sort-chosen{border-color:#6f5cf6}
.rt-label{display:flex!important;align-items:center;gap:6px;font-size:12px!important;font-weight:600;line-height:1.6;margin:0 0 7px!important;color:#404861}
.rt-label .req{color:#e75567}.rt-control{display:block;width:100%;max-width:100%;min-width:0;border:1px solid #dbe0eb;background:#fff;border-radius:7px;padding:10px 11px;font-size:12px;color:#30384f;line-height:1.5;box-sizing:border-box}
textarea.rt-control{min-height:86px;resize:vertical}.rt-control:focus{outline:2px solid #bdb3ff;outline-offset:1px}.rt-control[readonly],.rt-control:disabled{background:#f5f6fa;color:#737b90}
.rt-control::placeholder{color:#a0a7b7}.rt-options{display:flex;flex-wrap:wrap;gap:9px 15px;padding:8px 0}.rt-choice{display:flex!important;align-items:center;gap:7px;font-size:12px!important;font-weight:400!important;margin:0!important;color:#556079}
.rt-choice input{width:15px!important;height:15px;padding:0!important;accent-color:#7560ed}.rt-rating{display:flex;gap:4px;flex-wrap:wrap}.rt-rating label{cursor:pointer;color:#b18100!important;font-size:20px!important}.rt-rating input{accent-color:#b18100}
.rt-rich{font-size:12px;line-height:1.8;min-height:20px;overflow-wrap:anywhere}.rt-rich p{margin:0 0 8px}.rt-rich h1,.rt-rich h2,.rt-rich h3{line-height:1.4}.rt-rich img{max-width:100%;height:auto}.rt-rich a{color:#6350d3}
.rt-image{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;border-radius:8px}.media-empty{min-height:100px;display:grid;place-items:center;padding:20px;text-align:center;background:#f0f1fa;color:#8790aa;border:1px dashed #d5d9e8;border-radius:9px;font-size:12px}
.rt-video{width:100%;aspect-ratio:16/9;background:#171a2d;border-radius:10px;display:block}.rt-embed{width:100%;aspect-ratio:16/9;border:0;border-radius:10px;background:#171a2d}.media-cover{display:grid;place-items:center;min-height:150px;aspect-ratio:16/9;border-radius:10px;background:linear-gradient(140deg,#202a4a,#41347b);color:#eeeaff;text-align:center;width:100%;border:0;padding:20px;font-size:12px}
.media-cover i{display:block;font-size:30px;margin-bottom:10px}.media-cover small{display:block;color:#b7b3ce;margin-top:7px}.rt-hint{font-size:10px;color:#8b91a1;line-height:1.6;margin:6px 0 0}.rt-signature{display:block;width:100%;height:130px;background:#fff;border:1px dashed #b8bdd0;border-radius:8px;touch-action:none}.rt-sign-clear{margin-top:5px;font-size:10px;border:0;background:#eeeafc;color:#6956ce;padding:5px 10px;border-radius:5px}
.form-hero{padding:24px}.form-hero h1{font-size:22px;line-height:1.45;display:flex;gap:10px;align-items:center}.form-hero p{line-height:1.7}.form-hero:after{display:none}
.inspect-body{padding:12px 15px 40px}.control input,.control select,.control textarea{font-size:11px}.control label{font-size:10px;color:#677088;line-height:1.5}.control textarea.css-editor{font-size:10px;min-height:65px;line-height:1.65}.control textarea.rich-editor{min-height:170px}
.section-head b{font-size:12px}.section-head span{font-size:9px}.help{font-size:10px;line-height:1.65;color:#8a90a3;margin:7px 0}.help strong{color:#6f59cc}.info-box{padding:10px;background:#f4f1ff;border:1px solid #e7e0fc;border-radius:8px;font-size:10px;line-height:1.7;color:#7d70a4;margin-bottom:12px}
.span-picker,.icon-picker{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px}.span-picker button,.icon-picker button{border:1px solid #e2dcef;background:#faf8ff;color:#7764b7;border-radius:6px;padding:6px 9px;font-size:10px}.span-picker button.active{background:#7662f6;color:white;border-color:#7662f6}
.icon-picker button{font-size:14px;min-width:30px}.toggle-row{gap:10px}.toggle{flex-shrink:0}.inspector .json-wrap{min-height:0;flex:1;padding:0}.json-editor{font-size:11px;min-height:240px}.json-status{max-width:150px;overflow-wrap:anywhere}.json-toolbar{flex-wrap:wrap}.json-help{font-size:10px;margin:0;padding:10px;background:#f6f4fd;color:#79728d;line-height:1.6}
.json-error{color:#ef5967}.service-chip{font-size:9px}.inspector .empty{padding:24px 10px}.version-list-note{font-size:10px;color:#89819a;line-height:1.7}
.modal{padding:20px}.modal-card{width:min(1240px,100%);max-height:94vh;display:flex;flex-direction:column;overflow:hidden;border-radius:16px}.modal-head{align-items:center;gap:12px;flex-wrap:wrap;padding:13px 18px;flex-shrink:0}.modal-head h2{font-size:13px}.preview-tools{display:flex;gap:6px;align-items:center}.preview-tools button{font-size:10px;padding:6px 9px}.preview-tools button.active{background:#ece8ff;border-color:#baaff4;color:#634ed5}
.modal-body{overflow:auto;min-height:0;background:#eef0f7;padding:22px}.preview-viewport{margin:auto;width:100%;container-type:inline-size;transition:max-width .2s}.preview-viewport[data-device="tablet"]{max-width:768px}.preview-viewport[data-device="mobile"]{max-width:390px}
.preview-surface{background:#fff;border:1px solid #e1e4ef;border-radius:12px;overflow:hidden;color:#333b53}.preview-header{padding:18px 22px;background:#edeaff;border-bottom:1px solid #e5defb;display:flex;gap:12px;align-items:center;justify-content:space-between}.preview-header h2{font-size:16px;margin:0;line-height:1.5;display:flex;align-items:center;gap:8px}.preview-description{font-size:11px;color:#8a8fa0;margin:5px 0 0;line-height:1.65}.preview-fields{padding:22px}.preview-footer{font-size:10px;color:#868c9e;margin:12px 0;text-align:center}.preview-result{white-space:pre-wrap;overflow-wrap:anywhere;background:#222638;color:#d7e0fa;padding:14px;border-radius:9px;font:11px/1.8 DM Mono}.preview-status{color:#e36475;font-size:11px;margin:12px 0}.preview-surface .group-inner{background:transparent}
@@container(max-width:575px){.preview-fields{padding:14px}.preview-header{padding:15px}.preview-header h2{font-size:13px}.preview-surface[data-stack="true"] .layout-grid{grid-template-columns:minmax(0,1fr)!important}.preview-surface[data-stack="true"] .layout-item{grid-column:1/-1!important}.preview-surface .group-inner{padding:12px}}
@@media(max-width:1100px) and (min-width:821px){main{grid-template-columns:185px minmax(300px,1fr) 315px}.crumb{display:none}.canvas-wrap{inset:100px 8px 8px}.field-list{padding:10px}.layout-grid{gap:12px 8px}.stage-tab{font-size:9px;padding:7px}.stage-bar{max-width:calc(100% - 140px);right:8px}.palette-item{padding:9px 6px;gap:5px}.form-hero{padding:18px}}
@@media(max-width:820px){.app{height:calc(100dvh - 62px);grid-template-rows:60px minmax(0,1fr)}main{display:block}.mobile-nav{position:fixed;left:0;right:0;bottom:0;height:62px;padding-bottom:max(7px,env(safe-area-inset-bottom))}.stage{height:100%}.version-dock{top:10px;left:9px}.version-orb{width:39px;height:39px}.stage-bar{top:10px;right:9px;left:auto;transform:none;max-width:calc(100% - 63px)}.stage-tab{padding:7px 9px;font-size:9px}.canvas-wrap{inset:57px 7px 7px;padding:7px 0 30px}.layout-caption{font-size:9px}.field-list{padding:10px}.field-card{padding:25px 6px 8px}.layout-grid{gap:12px 8px}.group-inner{padding:10px}.rt-label{font-size:11px!important}.form-hero{padding:18px}.form-hero h1{font-size:19px}.actions #previewBtn{display:flex!important}.actions .btn{font-size:10px}.stage-tab[data-stage="flow"],.stage-tab[data-stage="data"]{display:inline-flex}.modal{padding:7px}.modal-card{max-height:97dvh}.modal-body{padding:10px}.preview-tools{gap:4px}.preview-tools button{padding:6px}.modal-head{padding:10px}.inspector{height:auto}.layout-ruler{gap:3px;padding:7px 10px}}

</style>
</head>
<body>
<div class="grain"></div>
<div class="app">
  <header>
    <div class="brand"><div class="brand-mark"></div><div><b>FORM STUDIO 2</b><small>Database-driven · NETForm</small></div></div>
    <div class="crumb"><span>workspace</span><span>›</span><strong id="headerName">Phiếu đăng ký dịch vụ</strong><span class="kbd">⌘ K</span></div>
    <div class="actions">
      <button class="btn icon" id="undoBtn" title="Hoàn tác">↶</button>
      <button class="btn" id="importBtn">↥ <span class="txt">Import</span></button>
      <button class="btn" id="previewBtn">◉ <span class="txt">Preview</span></button>
      <button class="btn" id="deleteVersionBtn"><i class="fa fa-trash"></i> <span class="txt">Xóa version</span></button>
      <button class="btn" id="saveBtn"><i class="fa fa-save"></i> <span class="txt">Lưu nháp</span></button>
      <button class="btn publish" id="publishBtn"><i class="fa fa-check-circle"></i> <span class="txt">Publish</span></button>
      <button class="btn acid" id="exportBtn">Export JSON ↗</button>
    </div>
  </header>
  <main>
    <aside class="library">
      <div class="side-head"><span class="eyebrow">Thư viện trường</span><span class="count" id="paletteCount">12</span></div>
      <div class="search"><span>⌕</span><input id="fieldSearch" placeholder="Tìm kiểu trường..." /></div>
      <p class="palette-note">Thêm vào: <b id="addTarget">Biểu mẫu (12 cột)</b></p><div class="palette" id="palette"></div>
    </aside>
    <section class="stage">
      <div class="version-dock"><div class="version-orb"><div><small>VERSION</small><b id="orbVersion">1.2</b></div></div><select class="version-select" id="versionSelect"></select></div>
      <div class="stage-bar"><button type="button" class="stage-tab active" data-stage="design"><i class="fa fa-th-large"></i>Thiết kế</button><button type="button" class="stage-tab" data-stage="form"><i class="fa fa-sliders"></i>Biểu mẫu</button><button type="button" class="stage-tab" data-stage="preview"><i class="fa fa-eye"></i>Preview</button></div>
      <div class="canvas-wrap">
        <div class="form-canvas">
          <div class="form-hero"><span class="status-pill"><span class="dot"></span><span id="formStatus">PUBLISHED</span></span><h1 id="canvasTitle"></h1><p id="canvasDesc"></p></div>
          <div class="layout-ruler" aria-label="Lưới 12 cột"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span></div><div class="layout-caption">12 cột · vượt hàng tự xuống dòng · chọn group để thêm trường con</div><div class="field-list" id="fieldList"></div>
          <div class="service-rail" id="serviceRail"></div>
        </div>
      </div>
    </section>
    <section class="inspector">
      <div class="side-head"><span class="eyebrow">Inspector / JSON</span><span class="count" id="syncState">LIVE</span></div>
      <div class="inspect-tabs">
        <button class="inspect-tab active" data-tab="properties">PROPERTIES</button>
        <button class="inspect-tab" data-tab="form">FORM</button><button class="inspect-tab" data-tab="versions">VERSIONS</button>
        <button class="inspect-tab" data-tab="services">SERVICES</button>
        <button class="inspect-tab" data-tab="json">{ JSON }</button>
      </div>
      <div class="inspect-body" id="inspectorBody"></div>
    </section>
  </main>
</div>
<nav class="mobile-nav" aria-label="Điều hướng cấu hình trên mobile">
  <button data-mobile="library"><i>⊞</i><span>Trường</span></button>
  <button class="active" data-mobile="canvas"><i>▦</i><span>Thiết kế</span></button>
  <button data-mobile="inspector"><i>⚙</i><span>Cấu hình</span></button>
  <button data-mobile="json"><i>{ }</i><span>JSON</span></button>
</nav>
<div class="mobile-backdrop"></div>
<div class="toast" id="toast"></div>
<div class="modal" id="previewModal" role="dialog" aria-modal="true" aria-labelledby="previewTitle" aria-hidden="true"><div class="modal-card"><div class="modal-head"><h2 id="previewTitle">Runtime Preview</h2><div class="preview-tools"><a class="btn" href="@Url.Action("Viewer", "NETForm", new { FormCode = formCode, isPage = true })" target="_blank" rel="noopener">Mở Viewer thật</a><button type="button" class="btn active" data-device="desktop">Desktop</button><button type="button" class="btn" data-device="tablet">Tablet</button><button type="button" class="btn" data-device="mobile">Mobile</button><button type="button" class="btn icon" data-close aria-label="Đóng Preview">×</button></div></div><div class="modal-body" id="previewBody"></div></div></div>
<input type="file" id="fileInput" accept=".json,application/json" hidden>
<form id="antiForgeryForm" hidden>@Html.AntiForgeryToken()</form>
<script>
(() => {
  'use strict';
  const FORM_CODE = @Html.Raw(JsonSerializer.Serialize(formCode));
  const CREATE_NEW = @Html.Raw(JsonSerializer.Serialize(createNew));
  const INITIAL_ERROR = @Html.Raw(JsonSerializer.Serialize(initialError));
  const STORAGE_KEY = 'form-builder-draft:' + (FORM_CODE || 'new');
  const API = {
    data: '@Url.Action("FormBuilderData", "NETForm")',
    catalog: '@Url.Action("FormBuilderCatalog", "NETForm")',
    save: '@Url.Action("FormBuilderSave", "NETForm")',
    publish: '@Url.Action("FormBuilderPublish", "NETForm")',
    deleteVersion: '@Url.Action("FormBuilderDeleteVersion", "NETForm")'
  };
  const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];
  const clone = x => JSON.parse(JSON.stringify(x));
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const uid = p => p + '_' + (crypto.randomUUID ? crypto.randomUUID().replace(/-/g,'').slice(0,12) : Date.now().toString(36) + Math.random().toString(36).slice(2,8));
  const supportedTypeDefinitions = {
    TextBox:['text','Văn bản','Một dòng tự do','font','Cơ bản'], TextArea:['textarea','Đoạn văn','Nội dung nhiều dòng','align-left','Cơ bản'],
    NumberBox:['number','Số','Giá trị số','hashtag','Cơ bản'], DateBox:['date','Ngày tháng','Chọn ngày','calendar','Cơ bản'],
    SelectBox:['select','Danh sách chọn','Một lựa chọn','list-ul','Lựa chọn'], DropDownBox:['select','Dropdown','Danh sách thả xuống','caret-square-o-down','Lựa chọn'],
    TagBox:['select','Tag box','Nhiều giá trị','tags','Lựa chọn'], ListSelection:['select','Danh sách','Chọn từ danh sách','list','Lựa chọn'],
    RadioGroup:['radio','Radio','Lựa chọn hiển thị','dot-circle-o','Lựa chọn'], CheckBox:['checkbox','Checkbox','Giá trị đúng/sai','check-square-o','Lựa chọn'],
    Switch:['checkbox','Switch','Bật hoặc tắt','toggle-on','Lựa chọn'], ColorBox:['text','Màu sắc','Chọn màu','eyedropper','Cơ bản'],
    GroupItem:['group','Nhóm trường','Một cấp group','object-group','Bố cục & nội dung'], EmptyBox:['spacer','Khoảng trống','Điều chỉnh bố cục','arrows-h','Bố cục & nội dung'],
    FileUploader:['file','Tệp đính kèm','Tải một hoặc nhiều tệp','paperclip','Nâng cao'], HTMLEditor:['html','HTML Editor','Nội dung HTML','code','Bố cục & nội dung'],
    DynamicReport:['unsupported','Dynamic Report','Báo cáo động','table','Nâng cao'], Label:['html','Nhãn / HTML','Nội dung mô tả','font','Bố cục & nội dung'],
    EmbedYoutube:['video','YouTube','Nhúng video YouTube','youtube-play','Bố cục & nội dung'], VideoUploader:['video','Video uploader','Video tải lên','video-camera','Nâng cao'],
    ScanCCCD:['unsupported','Quét CCCD','Đọc căn cước','id-card','Nâng cao'], AjaxButton:['unsupported','Nút Ajax','Thực hiện tác vụ','bolt','Nâng cao']
  };
  const defaultTypes = Object.entries(supportedTypeDefinitions).map(([fieldTypeCode,[type,label,desc,icon,group]]) => ({fieldTypeCode,type,label,desc,icon,group,supported:true,color:group==='Cơ bản'?'#7464e8':group==='Lựa chọn'?'#1baab7':group==='Nâng cao'?'#e59446':'#9873c6'}));
  let types = clone(defaultTypes);
  const groupCounts = Array.from({length:12},(_,i)=>i+1);
  const codeForUiType = type => defaultTypes.find(t=>t.type===type)?.fieldTypeCode || 'TextBox';
  const field = (id,key,type,label,colSpan,extra={}) => ({id,key,type,fieldTypeCode:codeForUiType(type),label,parentId:null,colSpan,order:1,required:false,readonly:false,visible:true,showLabel:true,placeholder:'',iconClass:'',iconStyle:'',labelStyle:'',inputStyle:'',validation:{},rawOptions:{},rawValidates:[],datasources:[],editorOptions:{},...extra});
  const initial = {
    schemaVersion:3,
    form:{id:null,code:FORM_CODE,name:FORM_CODE||'Biểu mẫu mới',title:'',description:'',isActive:false,latestVersion:null,iconClass:'fa fa-file-text-o',formStyle:'',labelStyle:'',labelBGStyle:'',rawCssOptionHeader:{}},
    versions:[{id:uid('version'),clientKey:uid('version'),version:1,status:'draft',note:'Bản nháp mới',colCount:12,readOnly:false,labelLocation:'top',mobileStack:true,rawOptions:{},fields:[],services:[]}],
    catalogs:{fieldTypes:[],datasources:[],services:[]},
    activeVersionId:null,concurrencyToken:'',ui:{theme:'light',autosave:true,mobileStack:true}
  };
  initial.activeVersionId=initial.versions[0].id;

  // Configuration input is validated before replacing state. v1 JSON is migrated in memory.
  function normalize(raw){
    const obj = x => x && typeof x==='object' && !Array.isArray(x);
    if(!obj(raw)||!obj(raw.form)||!Array.isArray(raw.versions)||!raw.versions.length) throw Error('Cần có form và ít nhất một phần tử versions[].');
    const next=clone(raw); next.schemaVersion=3;
    if(typeof next.form.name!=='string'||typeof next.form.code!=='string') throw Error('form.name và form.code phải là chuỗi.');
    next.form={description:'',isActive:false,iconClass:'fa fa-file-text-o',formStyle:'',labelStyle:'',labelBGStyle:'',rawCssOptionHeader:{},...next.form};
    next.catalogs={fieldTypes:[],datasources:[],services:[],...next.catalogs};
    next.ui={autosave:true,mobileStack:true,...next.ui};
    const versionIds=new Set();
    next.versions.forEach(v=>{
      if(!obj(v)||v.id===null||v.id===undefined||String(v.id)===''||versionIds.has(String(v.id))) throw Error('ID phiên bản phải có giá trị và không trùng nhau.');
      versionIds.add(String(v.id));
