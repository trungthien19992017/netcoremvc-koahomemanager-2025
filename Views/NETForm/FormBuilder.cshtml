      const result=await requestJSON(API.deleteVersion,{method:'POST',body:JSON.stringify({formId:Number(state.form.id),versionId:activeVersion().id,expectedLastModificationTime:activeVersion().lastModificationTime||null})});
      localStorage.removeItem(STORAGE_KEY);dirty=false;await loadServer(false,result.versionId);toast(`Đã xóa version ${result.version}.`);return result;
    }catch(error){setSync(error.status===409?'XUNG ĐỘT':'LỖI LƯU');toast(error.status===409?'Cấu hình đã đổi trên server. Hãy Export bản đang làm rồi tải lại.':error.message);return null;}
    finally{saving=false;setSync(dirty?'CHƯA LƯU':'ĐÃ ĐỒNG BỘ');}
  }

