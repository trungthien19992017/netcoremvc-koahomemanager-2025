  function runtimeSubmit(e){
    if(e.target.id!=='runtimeForm')return;e.preventDefault();const result={},errors=[];
    const visible=f=>{if(f.visible===false)return false;let p=f.parentId;while(p){const group=activeVersion().fields.find(x=>sameId(x.id,p));if(!group||group.visible===false)return false;p=group.parentId;}return true;};
    const inputs=[...e.target.querySelectorAll('[data-runtime-id]')];
    for(const f of activeVersion().fields.filter(visible)){
      if(['group','html','image','video','spacer','unsupported'].includes(f.type))continue;
      const nodes=inputs.filter(n=>n.dataset.runtimeId===f.id);let val;
      if(f.type==='checkbox')val=nodes.filter(n=>n.checked).map(n=>n.value);
      else if(['radio','rating'].includes(f.type))val=nodes.find(n=>n.checked)?.value||'';
      else if(f.type==='file')val=[...(nodes[0]?.files||[])].map(file=>({name:file.name,size:file.size,type:file.type}));
      else if(f.type==='signature'){const canvas=[...e.target.querySelectorAll('[data-signature]')].find(c=>c.dataset.signature===f.id);val=signatures.has(f.id)?canvas.toDataURL('image/png'):'';}
      else val=nodes[0]?.value??'';
      if(f.required&&(val===''||Array.isArray(val)&&!val.length))errors.push('Vui lòng nhập '+f.label+'.');
      if(typeof val==='string'&&!['signature'].includes(f.type)){if(f.validation.minLength!==undefined&&val&&val.length<f.validation.minLength)errors.push(f.label+': cần ít nhất '+f.validation.minLength+' ký tự.');if(f.validation.maxLength!==undefined&&val.length>f.validation.maxLength)errors.push(f.label+': tối đa '+f.validation.maxLength+' ký tự.');}
      result[f.key]=f.type==='number'&&val!==''?Number(val):val;
    }
    $('#previewStatus').textContent=errors.join(' ');$('#previewResult').hidden=errors.length>0;if(!errors.length){$('#previewResult').textContent=JSON.stringify(result,null,2);toast('Dữ liệu hợp lệ. Chỉ xem kết quả, không gửi API.');}
  }
