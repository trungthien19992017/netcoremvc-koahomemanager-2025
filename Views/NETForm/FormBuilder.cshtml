    .stage:before{display:none}.stage-bar{background:#fff;border-color:#e1e3ec;box-shadow:0 8px 22px rgba(45,52,86,.10)}
    .stage-tab{color:#969baa}.stage-tab.active{background:#efedff;color:#6654ed}
    .version-orb{background:#fff;border:3px solid #eeeaff;box-shadow:0 10px 25px rgba(58,52,112,.12)}
