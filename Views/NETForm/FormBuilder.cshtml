  function jsonHTML(){return `<div class="json-toolbar"><button type="button" class="btn" data-format>Format</button><button type="button" class="btn acid" data-apply-json>Apply</button><button type="button" class="btn" data-reset-json title="Bỏ nội dung chưa Apply">Reset</button><span class="json-status" id="jsonStatus">${jsonDirty?'CHƯA APPLY':'JSON CẤU HÌNH'}</span></div><p class="json-help">Contract v3 giữ ID database dạng số, bản ghi mới dùng clientKey, version là số nguyên và group chỉ có một cấp. rawOptions, rawValidates và datasources được giữ nguyên khi lưu.</p><textarea aria-label="JSON cấu hình" class="json-editor" id="jsonEditor" spellcheck="false">${esc(jsonDirty?jsonDraft:JSON.stringify(state,null,2))}</textarea>`;}
  function renderInspector(){$$('.inspect-tab').forEach(el=>el.classList.toggle('active',el.dataset.tab===tab));const el=$('#inspectorBody');el.className=tab==='json'?'inspect-body json-wrap':'inspect-body';el.innerHTML=tab==='properties'?propertiesHTML():tab==='form'?formHTML():tab==='versions'?versionsHTML():tab==='services'?servicesHTML():jsonHTML();}

  function addField(fieldTypeCode){mutate(()=>{const current=selectedField(),parent=current?.type==='group'?current.id:current?.parentId||null,count=parent?activeVersion().fields.find(f=>sameId(f.id,parent)).colCount:rootColumns();
    const meta=types.find(t=>t.fieldTypeCode===fieldTypeCode);if(!meta?.supported)throw Error('Viewer chưa hỗ trợ tạo mới loại '+fieldTypeCode+'.');if(meta.type==='group'&&parent)throw Error('Viewer chỉ hỗ trợ group một cấp.');const id=uid('fld'),f=field(id,uniqueKey(fieldTypeCode.toLowerCase()),meta.type,meta.label,count,{clientKey:id,fieldTypeCode,parentId:parent,order:nextOrder(parent),iconClass:'fa fa-'+meta.icon});
