  function applyCatalog(catalog){
    state.catalogs={fieldTypes:[],datasources:[],services:[],...(catalog||{})};
    const source=state.catalogs.fieldTypes.length?state.catalogs.fieldTypes:defaultTypes.map(t=>({code:t.fieldTypeCode,name:t.label,description:t.desc,icon:'fa fa-'+t.icon}));
    types=source.map(ft=>{const definition=supportedTypeDefinitions[ft.code],fallback=definition||['unsupported',ft.name||ft.code,ft.description||'Viewer chưa có renderer',String(ft.icon||'question-circle').replace(/^fa fa-/,''),'Chưa hỗ trợ'];const [type,label,desc,iconName,group]=fallback;return {fieldTypeCode:ft.code,type,label:ft.name||label,desc:ft.description||desc,icon:String(ft.icon||iconName).replace(/^fa fa-/,''),group,supported:!!definition,color:group==='Cơ bản'?'#7464e8':group==='Lựa chọn'?'#1baab7':group==='Nâng cao'?'#e59446':'#9873c6'};});
    for(const fieldTypeCode of new Set(state.versions.flatMap(v=>v.fields.map(f=>f.fieldTypeCode))))if(!types.some(t=>t.fieldTypeCode===fieldTypeCode)){const d=defaultTypes.find(t=>t.fieldTypeCode===fieldTypeCode);types.push(d||{fieldTypeCode,type:'unsupported',label:fieldTypeCode,desc:'Metadata đang tồn tại',icon:'question-circle',group:'Chưa hỗ trợ',supported:false,color:'#8b91a1'});}
