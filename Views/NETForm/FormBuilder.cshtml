    @@media(max-width:430px){
      header .brand small{display:none}.actions #previewBtn{display:none}.btn.acid{font-size:9px}
      .stage-tab[data-stage="flow"],.stage-tab[data-stage="data"]{display:none}.stage-bar{left:auto;right:9px;transform:none}
