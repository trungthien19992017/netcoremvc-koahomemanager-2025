  function initSignatures(){signatures=new Map();$$('#previewBody canvas[data-signature]').forEach(canvas=>{const f=activeVersion().fields.find(x=>x.id===canvas.dataset.signature),scale=devicePixelRatio||1;canvas.width=Math.max(1,canvas.clientWidth)*scale;canvas.height=130*scale;const ctx=canvas.getContext('2d');ctx.scale(scale,scale);ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#303654';let down=false;
    canvas.addEventListener('pointerdown',e=>{if(f.readonly)return;down=true;canvas.setPointerCapture(e.pointerId);const r=canvas.getBoundingClientRect();ctx.beginPath();ctx.moveTo(e.clientX-r.left,e.clientY-r.top);});
    canvas.addEventListener('pointermove',e=>{if(!down)return;const r=canvas.getBoundingClientRect();ctx.lineTo(e.clientX-r.left,e.clientY-r.top);ctx.stroke();signatures.set(f.id,true);});['pointerup','pointercancel'].forEach(type=>canvas.addEventListener(type,()=>down=false));});}
