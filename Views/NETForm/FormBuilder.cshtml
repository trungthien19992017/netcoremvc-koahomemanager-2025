  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <style>
    :root{
      --bg:#07080a;--panel:#101216;--panel2:#15181d;--line:#292d34;--muted:#858b96;
      --text:#f4f2ed;--acid:#c8ff4d;--violet:#a988ff;--cyan:#5ee7f2;--orange:#ff9f5a;
      --danger:#ff6d7a;--shadow:0 24px 70px rgba(0,0,0,.45);--r:20px;
    }
    *{box-sizing:border-box} html,body{height:100%} body{margin:0;background:var(--bg);color:var(--text);
      font-family:Manrope,system-ui,sans-serif;overflow:hidden}
    button,input,select,textarea{font:inherit;color:inherit} button{cursor:pointer}
    .grain{position:fixed;inset:0;pointer-events:none;opacity:.055;z-index:20;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E")}
    .app{height:100%;display:grid;grid-template-rows:68px 1fr}
    header{display:flex;align-items:center;justify-content:space-between;padding:0 22px;border-bottom:1px solid var(--line);
      background:rgba(7,8,10,.82);backdrop-filter:blur(18px);z-index:8}
    .brand{display:flex;align-items:center;gap:12px}.brand-mark{width:36px;height:36px;border-radius:50%;border:1px solid var(--acid);
      display:grid;place-items:center;position:relative;box-shadow:0 0 24px #c8ff4d25}
    .brand-mark:after{content:"";width:8px;height:8px;background:var(--acid);border-radius:50%;box-shadow:0 0 12px var(--acid)}
    .brand b{font-size:14px;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font:10px DM Mono}
    .crumb{font:11px DM Mono;color:var(--muted);display:flex;gap:8px;align-items:center}.crumb strong{color:var(--text)}
    .actions{display:flex;gap:8px}.btn{border:1px solid var(--line);background:#14161a;border-radius:10px;padding:9px 12px;
      font-size:11px;font-weight:700;display:flex;align-items:center;gap:7px;transition:.2s}
    .btn:hover{transform:translateY(-1px);border-color:#4b515d}.btn.acid{background:var(--acid);color:#0b0d08;border-color:var(--acid)}
    .btn:disabled{cursor:not-allowed;opacity:.55;transform:none}.btn.publish{background:#20263a;color:#fff;border-color:#20263a}
    .btn.icon{padding:9px 11px}.kbd{font:9px DM Mono;color:var(--muted);border:1px solid #3a3e45;border-radius:5px;padding:2px 5px}
    main{display:grid;grid-template-columns:255px minmax(450px,1fr) 360px;min-height:0}
    aside,.inspector{background:var(--panel);min-height:0}.library{border-right:1px solid var(--line);display:flex;flex-direction:column}
    .inspector{border-left:1px solid var(--line);display:flex;flex-direction:column}
    .side-head{padding:18px 16px 12px;display:flex;align-items:center;justify-content:space-between}
    .eyebrow{font:10px DM Mono;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .count{font:10px DM Mono;background:#22262c;border-radius:20px;padding:4px 8px;color:var(--acid)}
    .search{margin:0 14px 14px;position:relative}.search input{width:100%;background:#0b0d10;border:1px solid var(--line);
      border-radius:11px;padding:10px 10px 10px 34px;font-size:11px;outline:none}.search input:focus{border-color:var(--acid)}
    .search span{position:absolute;left:11px;top:9px;color:var(--muted)}
    .palette{padding:0 12px 18px;overflow:auto}.group-title{font:9px DM Mono;color:#626873;text-transform:uppercase;
      letter-spacing:.14em;margin:14px 4px 7px}.palette-item{display:grid;grid-template-columns:34px 1fr 18px;gap:9px;align-items:center;
      padding:10px 9px;border:1px solid transparent;border-radius:12px;transition:.18s;user-select:none}
    .palette-item:hover{background:#191c21;border-color:#2d3239;transform:translateX(3px)}.palette-item .pi{
      width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:color-mix(in srgb,var(--c) 13%,transparent);
      color:var(--c);font:700 13px DM Mono}.palette-item b{font-size:11px}.palette-item small{display:block;color:var(--muted);font-size:9px;margin-top:2px}
    .plus{color:#555b65;font-size:18px}.palette-item:hover .plus{color:var(--acid)}
    .stage{min-width:0;position:relative;overflow:hidden;background-color:#090b0e;
      background-image:radial-gradient(#32363c 1px,transparent 1px);background-size:24px 24px}
    .stage:before{content:"";position:absolute;width:480px;height:480px;left:50%;top:42%;transform:translate(-50%,-50%);
      border:1px solid #242932;border-radius:50%;box-shadow:0 0 0 80px #0b0d1000,0 0 0 81px #1d212720,0 0 0 160px #0b0d1000,0 0 0 161px #1d212720}
    .stage-bar{position:absolute;top:14px;left:50%;transform:translateX(-50%);display:flex;gap:4px;background:#111318e8;
      border:1px solid var(--line);border-radius:14px;padding:5px;z-index:5;box-shadow:var(--shadow)}
    .stage-tab{border:0;background:transparent;color:var(--muted);padding:8px 13px;border-radius:9px;font-size:10px;font-weight:700}
    .stage-tab.active{background:#272b32;color:var(--text)}
    .version-dock{position:absolute;left:18px;top:18px;z-index:4}.version-orb{width:76px;height:76px;border-radius:50%;
      background:#12151a;border:1px solid #343943;display:grid;place-items:center;text-align:center;box-shadow:0 15px 40px #0008}
    .version-orb b{font:16px DM Mono;color:var(--violet)}.version-orb small{display:block;font:8px DM Mono;color:var(--muted)}
    .version-select{margin-top:8px;width:112px;background:#111318;border:1px solid var(--line);border-radius:9px;padding:7px;font:9px DM Mono}
    .canvas-wrap{position:absolute;inset:76px 24px 24px;overflow:auto;padding:26px 8% 90px;z-index:2}
    .form-canvas{width:min(720px,100%);margin:auto;background:#0e1014d9;border:1px solid #313641;border-radius:28px;
      backdrop-filter:blur(12px);box-shadow:0 35px 100px #000a;overflow:hidden}
    .form-hero{padding:27px 30px 22px;border-bottom:1px solid var(--line);position:relative}
    .form-hero:after{content:"FORM";position:absolute;right:23px;top:16px;font:700 48px DM Mono;color:#ffffff06}
    .status-pill{display:inline-flex;gap:6px;align-items:center;font:9px DM Mono;color:var(--acid);border:1px solid #c8ff4d35;
      background:#c8ff4d0c;border-radius:20px;padding:5px 8px}.dot{width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 9px currentColor}
    .form-hero h1{font-size:25px;letter-spacing:-.04em;margin:13px 0 5px}.form-hero p{font-size:11px;color:var(--muted);margin:0}
    .field-list{padding:14px;min-height:220px}.field-card{position:relative;border:1px solid transparent;border-radius:15px;
      padding:13px 13px 12px 47px;margin:5px 0;transition:.2s;background:#121419}
    .field-card:hover,.field-card.selected{border-color:#3b414b;background:#171a20}.field-card.selected{box-shadow:inset 3px 0 var(--acid)}
    .drag{position:absolute;left:14px;top:20px;color:#525862;cursor:grab;font:14px DM Mono}.field-card label{display:flex;gap:5px;font-size:10px;font-weight:700;margin-bottom:7px}
    .req{color:var(--orange)}.mock-input{height:36px;background:#090b0e;border:1px solid #2b3038;border-radius:9px;color:#686e78;
      padding:10px 11px;font-size:10px}.field-meta{position:absolute;right:11px;top:10px;font:8px DM Mono;color:#5f6570;
      background:#0b0d10;border:1px solid #252a31;padding:3px 6px;border-radius:6px}.field-actions{position:absolute;right:8px;bottom:8px;display:none;gap:3px}
    .field-card:hover .field-actions{display:flex}.mini{border:0;background:#252a31;border-radius:6px;color:#aeb3bc;width:25px;height:24px}
    .drop-hint{border:1px dashed #343a43;border-radius:14px;margin:8px 0 0;padding:18px;text-align:center;color:#626975;font-size:10px}
    .drop-hint strong{color:var(--acid)}
    .service-rail{padding:12px 20px 18px;border-top:1px solid var(--line);display:flex;gap:8px;overflow:auto}
    .service-chip{white-space:nowrap;border:1px solid #343a44;border-radius:20px;padding:7px 10px;font:9px DM Mono;color:var(--cyan);background:#5ee7f208}
    .empty{padding:48px 20px;text-align:center;color:var(--muted);font-size:11px}.empty b{color:var(--text);display:block;font-size:13px;margin-bottom:5px}
    .inspect-tabs{display:flex;padding:0 13px;border-bottom:1px solid var(--line)}.inspect-tab{flex:1;border:0;background:none;color:var(--muted);
      padding:12px 4px;font:9px DM Mono;border-bottom:2px solid transparent}.inspect-tab.active{color:var(--acid);border-color:var(--acid)}
    .inspect-body{padding:14px 16px 70px;overflow:auto}.section{border-bottom:1px solid #252930;padding:7px 0 16px;margin-bottom:12px}
    .section-head{display:flex;justify-content:space-between;align-items:center;margin:2px 0 12px}.section-head b{font-size:11px}.section-head span{font:9px DM Mono;color:var(--muted)}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.control{margin-bottom:10px}.control label{display:block;font:9px DM Mono;color:var(--muted);margin:0 0 6px}
    .control input,.control select,.control textarea{width:100%;border:1px solid #30353d;background:#0b0d10;border-radius:9px;
      padding:9px 10px;font-size:10px;outline:none}.control textarea{min-height:64px;resize:vertical;font-family:DM Mono}
    .control input:focus,.control select:focus,.control textarea:focus{border-color:var(--violet)}
    .toggle-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-size:10px}
    .toggle{width:34px;height:19px;border-radius:20px;background:#2a2f36;border:0;padding:2px;transition:.2s}
    .toggle:after{content:"";display:block;width:15px;height:15px;border-radius:50%;background:#787f8a;transition:.2s}
    .toggle.on{background:var(--acid)}.toggle.on:after{transform:translateX(15px);background:#111}
    .danger-btn{width:100%;border:1px solid #ff6d7a40;background:#ff6d7a0a;color:var(--danger);border-radius:9px;padding:9px;font-size:10px}
    .json-wrap{height:100%;display:flex;flex-direction:column}.json-toolbar{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid var(--line)}
    .json-status{margin-left:auto;font:9px DM Mono;color:var(--acid);align-self:center}.json-editor{flex:1;width:100%;resize:none;border:0;outline:0;
      background:#090b0e;color:#c9ced6;padding:16px;font:10px/1.65 DM Mono;tab-size:2}.json-error{color:var(--danger)}
    .versions-list,.services-list{display:grid;gap:8px}.entity-card{border:1px solid #2c3139;background:#12151a;border-radius:12px;padding:11px}
    .entity-card.active{border-color:var(--violet);box-shadow:inset 3px 0 var(--violet)}.entity-top{display:flex;justify-content:space-between;align-items:center}
    .entity-card b{font-size:10px}.entity-card p{font:8px DM Mono;color:var(--muted);margin:5px 0 0}.badge{font:8px DM Mono;border-radius:12px;padding:4px 7px;background:#2a2e35}
    .add-entity{border:1px dashed #3a4049;background:transparent;color:var(--muted);border-radius:11px;padding:11px;font-size:10px}
    .toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,30px);opacity:0;background:#eef4e3;color:#0d100a;
      border-radius:11px;padding:11px 15px;font-size:10px;font-weight:800;z-index:50;transition:.25s;pointer-events:none}
    .toast.show{opacity:1;transform:translate(-50%,0)}
    .modal{position:fixed;inset:0;background:#000b;z-index:40;display:none;place-items:center;padding:20px}.modal.open{display:grid}
    .modal-card{width:min(720px,100%);max-height:85vh;overflow:auto;background:#111419;border:1px solid #363c45;border-radius:22px;box-shadow:var(--shadow)}
    .modal-head{display:flex;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)}.modal-head h2{font-size:14px;margin:0}
    .modal-body{padding:20px}.preview-form{background:#f6f4ef;color:#181917;border-radius:14px;padding:26px}.preview-form h2{margin-top:0}
    .preview-form label{display:block;font-size:11px;font-weight:700;margin:14px 0 6px}.preview-form input,.preview-form select,.preview-form textarea{width:100%;border:1px solid #d6d2c9;background:white;border-radius:8px;padding:10px;color:#222}
    @@media(max-width:1050px){main{grid-template-columns:210px 1fr 320px}}@@media(max-width:820px){body{overflow:auto}.app{height:auto;min-height:100%}
      main{grid-template-columns:1fr}.library{display:none}.stage{height:720px}.inspector{border-left:0;border-top:1px solid var(--line);min-height:600px}
      header{position:sticky;top:0}.crumb,.kbd{display:none}.actions .btn span.txt{display:none}}
  </style>
  <style>
    /* Light dashboard skin — inspired by the supplied configuration workspace */
    :root{
      --bg:#f5f6fb;--panel:#ffffff;--panel2:#f8f9fd;--line:#e6e8f0;--muted:#8b91a1;
      --text:#20263a;--acid:#6f5cf6;--violet:#7662f6;--cyan:#16b8e8;--orange:#ff9f43;
      --danger:#ef5967;--shadow:0 12px 36px rgba(45,52,86,.10);--r:16px;
    }
    body{background:var(--bg);color:var(--text)}
    .grain{display:none}
    header{background:rgba(255,255,255,.94);border-color:var(--line);box-shadow:0 4px 18px rgba(38,43,70,.06)}
    .brand-mark{border:0;background:linear-gradient(135deg,#8878ff,#6554ef);box-shadow:0 8px 20px #6f5cf63b}
    .brand-mark:after{background:#fff;box-shadow:none}.brand small,.crumb{color:var(--muted)}
    .btn{background:#fff;border-color:#e2e4ed;color:#34394b;box-shadow:0 3px 10px rgba(45,52,86,.07)}
    .btn:hover{border-color:#b9b3fb;box-shadow:0 5px 16px #6f5cf625}.btn.acid{background:linear-gradient(135deg,#806df8,#6654ed);color:#fff;border:0}
    .kbd{border-color:#dedfea;background:#f5f6fa;color:#888e9d}
    aside,.inspector{background:#fff}.library,.inspector{border-color:var(--line)}
    .eyebrow{color:#697084;font-weight:700}.count{background:#f0edff;color:#6854ed}
    .search input,.control input,.control select,.control textarea{background:#fff;border-color:#dfe2eb;color:#31374a}
    .search input:focus,.control input:focus,.control select:focus,.control textarea:focus{border-color:#8171f5;box-shadow:0 0 0 3px #7662f614}
    .palette{padding-left:10px;padding-right:10px}.group-title{color:#a0a5b2}
    .palette-item{margin-bottom:6px;border:1px solid #e7e8ef;background:#fafbfe;box-shadow:0 2px 5px rgba(32,38,58,.025)}
    .palette-item:hover{background:#fff;border-color:#cec8fb;box-shadow:0 7px 18px #6f5cf615}
