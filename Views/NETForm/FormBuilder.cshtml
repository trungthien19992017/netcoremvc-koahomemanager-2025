  $('.mobile-backdrop').addEventListener('click',()=>openMobilePanel('canvas'));
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){if($('#previewModal').classList.contains('open'))closePreview();else openMobilePanel('canvas');}
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();if(matchMedia('(max-width:820px)').matches)openMobilePanel('library');$('#fieldSearch').focus();}
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveDraft();}
    if(e.key==='Tab'&&$('#previewModal').classList.contains('open')){const nodes=$$('#previewModal button, #previewModal input, #previewModal select, #previewModal textarea, #previewModal a[href]').filter(n=>!n.disabled&&n.offsetParent!==null);const first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}
  });
  window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});
  renderPalette();render();setSync('ĐANG TẢI');loadServer(true).catch(error=>{loaded=false;setSync('LỖI TẢI');$('#fieldList').innerHTML=`<div class="empty"><b>Không tải được cấu hình</b>${esc(error.message)}<br><button type="button" class="btn" style="margin:14px auto" onclick="location.reload()">Tải lại</button></div>`;toast(error.message);});
})();


</script>
</body>
</html>
