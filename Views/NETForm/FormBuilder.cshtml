  async function requestJSON(url,options={}){
    const response=await fetch(url,{credentials:'same-origin',headers:{'Accept':'application/json',...(options.body?{'Content-Type':'application/json','RequestVerificationToken':$('#antiForgeryForm input[name="__RequestVerificationToken"]').value}:{}),...(options.headers||{})},...options});
    const body=await response.json().catch(()=>({success:false,errorMessage:'Phản hồi từ server không hợp lệ.'}));
    if(!response.ok||body.success===false){const error=new Error(body.errorMessage||`Yêu cầu thất bại (${response.status}).`);error.status=response.status;error.body=body;throw error;}
    return body;
  }

  async function loadServer(allowRecovery=true,preferredVersionId=null){
    setSync('ĐANG TẢI');
    const catalogResponse=await requestJSON(API.catalog);
    let serverState;
    try{
      const dataResponse=await requestJSON(API.data+'?FormCode='+encodeURIComponent(FORM_CODE));
      serverState=dataResponse.data;
    }catch(error){
      if(!(CREATE_NEW&&error.status===404))throw error;
      serverState=clone(initial);serverState.form.code=FORM_CODE;serverState.form.name=FORM_CODE;
    }
    if(preferredVersionId!==null&&serverState.versions?.some(v=>sameId(v.id,preferredVersionId)))serverState.activeVersionId=serverState.versions.find(v=>sameId(v.id,preferredVersionId)).id;
    state=normalize(serverState);applyCatalog(catalogResponse.data);
    if(allowRecovery){
      try{const raw=localStorage.getItem(STORAGE_KEY);if(raw&&confirm('Có bản cấu hình chưa lưu trên trình duyệt. Bạn có muốn phục hồi bản này không?')){const recovered=normalize(JSON.parse(raw));recovered.catalogs=state.catalogs;state=recovered;applyCatalog(state.catalogs);dirty=true;startupWarning='Đã phục hồi bản chưa lưu trên trình duyệt.';}}catch{startupWarning='Bản phục hồi local không hợp lệ nên đã dùng dữ liệu server.';}
    }
    selectedFieldId=activeVersion().fields[0]?.id||null;loaded=true;render();setSync(dirty?'CHƯA LƯU':'ĐÃ ĐỒNG BỘ');if(startupWarning){toast(startupWarning);startupWarning='';}
  }

  function savePayload(){
    const version=clone(activeVersion());
    version.fields=version.fields.map(field=>{
      const copy=clone(field);if(!/^\d+$/.test(String(copy.id)))copy.clientKey=copy.clientKey||String(copy.id);if(copy.parentId!==null&&!/^\d+$/.test(String(copy.parentId)))copy.parentClientKey=String(copy.parentId);
      copy.editorOptions={...(copy.editorOptions||{}),placeholder:copy.placeholder||'',value:copy.type==='html'?copy.content:copy.value,options:copy.options||copy.editorOptions?.options};
      if(copy.dataFillStore)copy.editorOptions.dataFillStore=copy.dataFillStore;else delete copy.editorOptions.dataFillStore;
      if(copy.fieldTypeCode==='HTMLEditor')copy.editorOptions.height=Number(copy.editorHeight)||200;
      if(copy.fieldTypeCode==='DynamicReport')Object.assign(copy.editorOptions,{reportCode:copy.reportCode||'',isViewerUtility:!!copy.isViewerUtility,isEditor:!!copy.isEditor});
      if(['FileUploader','ScanCCCD'].includes(copy.fieldTypeCode))Object.assign(copy.rawOptions,{codeUpload:copy.codeUpload||'',multiple:!!copy.multiple});
      if(copy.fieldTypeCode==='ScanCCCD')copy.rawOptions.dataField=copy.dataField||{};
      if(copy.fieldTypeCode==='AjaxButton')Object.assign(copy.rawOptions,{responseField:copy.responseField||'',request:{...(copy.rawOptions.request||{}),datasourceid:copy.requestDatasourceId||null,sqlstore:copy.requestSqlStore||''}});
      if(copy.serviceId!==null&&copy.serviceId!==undefined&&String(copy.serviceId)!=='')copy.editorOptions.service=copy.serviceId;else delete copy.editorOptions.service;
      return copy;
    });
    version.services=version.services.map(service=>{const copy=clone(service);if(!/^\d+$/.test(String(copy.id)))copy.clientKey=copy.clientKey||String(copy.id);return copy;});version.referencedServices=version.services;
    return {form:clone(state.form),version,expectedLastModificationTime:activeVersion().lastModificationTime||state.concurrencyToken||null,replaceFields:true};
  }

  async function saveDraft(){
    if(saving)return null;if(activeVersion().status==='published'){toast('Version đã publish. Hãy Fork phiên bản trước khi chỉnh sửa.');tab='versions';renderInspector();return null;}
    saving=true;setSync('ĐANG LƯU');
    try{
      const result=await requestJSON(API.save,{method:'POST',body:JSON.stringify({payload:savePayload()})});
      localStorage.removeItem(STORAGE_KEY);dirty=false;await loadServer(false,result.versionId);toast(`Đã lưu version ${result.version} · ${result.savedFieldCount} trường.`);return result;
    }catch(error){setSync(error.status===409?'XUNG ĐỘT':'LỖI LƯU');toast(error.status===409?'Cấu hình đã đổi trên server. Hãy Export bản đang làm rồi tải lại.':error.message);return null;}
    finally{saving=false;setSync(dirty?'CHƯA LƯU':'ĐÃ ĐỒNG BỘ');}
  }

  async function publishVersion(){
    if(saving)return;if(!confirm(`Publish version ${activeVersion().version}? Version hiện tại sẽ trở thành bản đang dùng của Viewer.`))return;
    let version=activeVersion();if(dirty||!/^\d+$/.test(String(version.id))){const saved=await saveDraft();if(!saved)return;version=activeVersion();}
    if(!state.form.id||!/^\d+$/.test(String(version.id))){toast('Hãy lưu bản nháp trước khi publish.');return;}
    saving=true;setSync('ĐANG PUBLISH');
    try{const result=await requestJSON(API.publish,{method:'POST',body:JSON.stringify({formId:Number(state.form.id),versionId:Number(version.id),expectedLastModificationTime:version.lastModificationTime||null})});dirty=false;localStorage.removeItem(STORAGE_KEY);await loadServer(false,result.versionId);toast(`Đã publish version ${result.version}.`);}
    catch(error){setSync(error.status===409?'XUNG ĐỘT':'LỖI PUBLISH');toast(error.message);}
    finally{saving=false;setSync(dirty?'CHƯA LƯU':'ĐÃ ĐỒNG BỘ');}
  }
  
  async function deleteVersion(){
    if(saving)return null;if(activeVersion().status==='published'){toast('Version đã publish. Vui lòng chỉ xóa bản nháp.');tab='versions';renderInspector();return null;}
    saving=true;setSync('ĐANG LƯU');
