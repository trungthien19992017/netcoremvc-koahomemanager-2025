@{
    ViewData["Title"] = "Dashboard Builder (Dynamic)";
    Layout = "_BlankLayout";

    // Dữ liệu từ controller
    var dashboardCode = ViewBag.DashboardCode as string ?? "KoaDashboard";
    var dashboardConfig = ViewBag.DashboardConfig as IDictionary<string, object>;
    var widgets = ViewBag.Widgets as List<IDictionary<string, object>>;
}

@section PageStyles {
    <style>
        :root {
            --primary: #7367f0;
            --primary-light: #f1f0fe;
            --bg: #f5f5f9;
            --card: #ffffff;
            --border: #e7e7ea;
            --text: #3d3d4e;
            --text-muted: #8a8d93;
            --success: #28c76f;
            --danger: #ea5455;
            --warn: #ff9f43;
            --info: #00cfe8;
            --grid-cols: 12;
            --grid-cell: 70px;
            --grid-gap: 14px;
            --shadow-sm: 0 2px 4px rgba(0,0,0,.03);
            --shadow-md: 0 8px 16px rgba(0,0,0,.06);
            --shadow-lg: 0 12px 24px rgba(0,0,0,.1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        button {
            font-family: inherit;
        }

        /* ================= LAYOUT ================= */
        .app {
            display: grid;
            grid-template-columns: 230px 1fr 290px;
            height: 100vh;
        }

            .app.mode-view {
                grid-template-columns: 0 1fr 0;
            }

                .app.mode-view .widget-library, .app.mode-view .config-panel, .app.mode-view .grid-controls {
                    display: none;
                }

        .panel-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: .03em;
            margin: 0 0 12px;
        }

        /* ================= THƯ VIỆN WIDGET ================= */
        .widget-library {
            background: var(--card);
            border-right: 1px solid var(--border);
            padding: 16px 12px;
            overflow-y: auto;
        }

        .lib-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: grab;
            background: #fafafd;
            font-size: 13px;
            transition: .2s ease-in-out;
        }

            .lib-item:hover {
                border-color: var(--primary);
                background: var(--primary-light);
                box-shadow: var(--shadow-sm);
            }

            .lib-item .ic {
                width: 32px;
                height: 32px;
                border-radius: 7px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 15px;
                font-weight: 700;
                box-shadow: 0 2px 8px rgba(115,103,240,.2);
            }

            .lib-item .desc {
                font-size: 10.5px;
                color: var(--text-muted);
                display: block;
                margin-top: 1px;
            }

            .lib-item.dragging-source {
                opacity: .35;
            }

        .lib-hint {
            font-size: 11.5px;
            color: var(--text-muted);
            line-height: 1.6;
            margin: 14px 2px 0;
            padding-top: 12px;
            border-top: 1px dashed var(--border);
        }

        /* ================= CANVAS ================= */
        .canvas-wrap {
            grid-column: 2;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .toolbar {
            background: linear-gradient(135deg, var(--card) 0%, rgba(243,242,254,0.5) 100%);
            border-bottom: 1px solid var(--border);
            padding: 12px 20px;
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
            box-shadow: var(--shadow-sm);
        }

            .toolbar h1 {
                font-size: 16px;
                margin: 0;
                margin-right: auto;
                font-weight: 700;
                color: var(--text);
                letter-spacing: -.3px;
            }

        /* Cụm điều khiển Grid */
        .grid-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f8f8fd;
            padding: 6px 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
        }

        .grid-ctrl-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .grid-ctrl-btn {
            width: 22px;
            height: 22px;
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .grid-ctrl-btn:hover {
                background: var(--primary);
                color: #fff;
                border-color: var(--primary);
            }

        .grid-val {
            min-width: 24px;
            text-align: center;
            color: var(--primary);
            font-weight: 700;
        }

        .btn {
            border: none;
            border-radius: 7px;
            padding: 9px 15px;
            font-size: 12.5px;
            cursor: pointer;
            font-weight: 600;
            white-space: nowrap;
            transition: .2s ease-in-out;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: var(--shadow-sm);
        }

            .btn-primary:hover {
                background: #6954d6;
                box-shadow: var(--shadow-md);
                transform: translateY(-1px);
            }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--border);
            color: var(--text);
        }

            .btn-outline:hover {
                background: var(--primary-light);
                border-color: var(--primary);
            }

        .btn-danger-outline {
            background: #fff;
            border: 1px solid var(--danger);
            color: var(--danger);
        }

            .btn-danger-outline:hover {
                background: rgba(234,84,85,.08);
            }

        .mode-switch {
            display: flex;
            background: #eeedf7;
            border-radius: 7px;
            padding: 3px;
            gap: 2px;
        }

            .mode-switch button {
                border: none;
                background: transparent;
                padding: 6px 12px;
                border-radius: 5px;
                font-size: 12.5px;
                font-weight: 600;
                cursor: pointer;
                color: var(--text-muted);
            }

                .mode-switch button.active {
                    background: #fff;
                    color: var(--primary);
                    box-shadow: 0 1px 3px rgba(0,0,0,.08);
                }

        .canvas-scroll {
            flex: 1;
            overflow: auto;
            padding: 20px;
        }

        #canvas {
            position: relative;
            min-height: 900px;
            background-image: linear-gradient(to right, #f0eefd 1px, transparent 1px), linear-gradient(to bottom, #f0eefd 1px, transparent 1px);
            background-size: calc((100% - (var(--grid-cols) - 1) * var(--grid-gap)) / var(--grid-cols) + var(--grid-gap)) calc(var(--grid-cell) + var(--grid-gap));
            border: 1px solid #e9e5f5;
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
        }

            #canvas.drop-active {
                background-color: var(--primary-light);
                border-color: var(--primary);
            }

        .app.mode-view #canvas {
            background-image: none;
            border: none;
            min-height: 0;
        }

        .widget {
            position: absolute;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .widget:hover {
                box-shadow: var(--shadow-lg);
                transform: translateY(-3px);
            }

            .widget::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--primary), #f1f0fe);
            }

            .widget.selected {
                border-color: var(--primary);
                box-shadow: 0 0 0 2px rgba(115,103,240,.25), var(--shadow-md);
            }

        .widget-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px 10px;
            cursor: move;
            touch-action: none;
            border-bottom: 1px solid #f0f0f5;
        }

            .widget-head h4 {
                font-size: 13px;
                margin: 0;
                font-weight: 700;
                color: var(--text);
                letter-spacing: -.2px;
            }

            .widget-head .rm {
                cursor: pointer;
                color: var(--text-muted);
                font-size: 14px;
                border: none;
                background: none;
            }

                .widget-head .rm:hover {
                    color: var(--danger);
                }

        .app.mode-view .widget-head {
            cursor: default;
        }

            .app.mode-view .widget-head .rm, .resize-handle {
                display: none;
            }

        .widget-body {
            flex: 1;
            padding: 6px 14px 14px;
            position: relative;
        }

        .resize-handle {
            position: absolute;
            right: 0;
            bottom: 0;
            width: 18px;
            height: 18px;
            cursor: nwse-resize;
            touch-action: none;
            background: linear-gradient(135deg, transparent 50%, #c9c7d8 50%);
            border-bottom-right-radius: 8px;
        }

        /* ================= CONFIG PANEL ================= */
        .config-panel {
            background: linear-gradient(180deg, #fff 0%, rgba(245,245,249,.3) 100%);
            border-left: 1px solid var(--border);
            padding: 16px 14px;
            overflow-y: auto;
        }

        .empty-hint {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .field {
            margin-bottom: 13px;
        }

            .field label {
                display: block;
                font-size: 11.5px;
                font-weight: 600;
                margin-bottom: 5px;
                color: var(--text-muted);
            }

            .field input[type=text], .field select {
                width: 100%;
                padding: 8px 10px;
                border: 1px solid var(--border);
                border-radius: 6px;
                font-size: 13px;
            }

        /* ================= DATA PLACEHOLDER ================= */
        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f5 25%, #e7e7ea 50%, #f0f0f5 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @@keyframes loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        /* Thêm CSS cho các card type */
        .card-kpi {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: var(--primary-light);
            border-radius: 8px;
        }

        .card-kpi-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
        }

        .card-kpi-label {
            font-size: 11px;
            color: var(--text-muted);
        }
    </style>
}

<div class="app mode-edit" id="app">
    <!-- THƯ VIỆN WIDGET -->
    <div class="widget-library">
        <div class="panel-title">Widget Library</div>
        <div id="lib-container"></div>
        <div class="lib-hint">Kéo thả widget vào canvas để thêm</div>
    </div>

    <!-- CANVAS CHÍNH -->
    <div class="canvas-wrap">
        <div class="toolbar">
            <h1>Dashboard Builder</h1>
            <div class="grid-controls">
                <div class="grid-ctrl-item">Cols: <span class="grid-val" id="grid-col-val">12</span></div>
                <button class="grid-ctrl-btn" onclick="changeGridCols(-1)">−</button>
                <button class="grid-ctrl-btn" onclick="changeGridCols(1)">+</button>
            </div>
            <div class="mode-switch">
                <button class="active" onclick="switchMode('edit')">✎ Edit</button>
                <button onclick="switchMode('view')">👁 View</button>
            </div>
            <button class="btn btn-primary" onclick="saveDashboard()">💾 Save</button>
            <button class="btn btn-outline" onclick="resetLayout()">↻ Reset</button>
        </div>
        <div class="canvas-scroll">
            <div id="canvas"></div>
        </div>
    </div>

    <!-- CONFIG PANEL -->
    <div class="config-panel">
        <div class="panel-title">Settings</div>
        <div id="config-panel-content" class="empty-hint">Select a widget to configure</div>
    </div>
</div>

@section PageScripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/interactjs/1.10.19/interact.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@latest/dist/apexcharts.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pickr/1.8.2/pickr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/pickr/1.8.2/themes/monolith.min.css" />

    <script>
        // ===================== STATE & CONFIG =====================
        const dashboardCode = "@dashboardCode";
        const siteCode = "@(ViewBag.SiteCode ?? "KOA")";
        const chartInstances = {};
        let widgets = [];
        let selectedWidget = null;
        let nextWidgetId = 1;
        let apiBaseUrl = '/api/dashboard';

        // Widget template definitions (từ database)
        const widgetTemplates = {
            'large_img_card': { name: 'Large Image Card', icon: '#', color: '#28c76f', w: 4, h: 3 },
            'multiple_mini_card': { name: 'Multiple Mini Cards', icon: '☰', color: '#7367f0', w: 5, h: 4 },
            'donut': { name: 'Donut Chart', icon: '◉', color: '#ff9f43', w: 6, h: 5 },
            'line': { name: 'Line Chart', icon: '⚡', color: '#7367f0', w: 6, h: 4 },
            'bar': { name: 'Bar Chart', icon: '◆', color: '#00cfe8', w: 6, h: 4 },
            'list': { name: 'List Widget', icon: '≡', color: '#7367f0', w: 6, h: 6 },
            'table': { name: 'Table', icon: '⊞', color: '#ea5455', w: 8, h: 4 },
            'heatmap': { name: 'Heatmap', icon: '▦', color: '#00cfe8', w: 6, h: 4 }
        };

        // ===================== KHỞI ĐỘNG =====================
        document.addEventListener('DOMContentLoaded', async () => {
            renderLibrary();
            await loadDashboardData();
            setupInteract();
            setupDragAndDrop();
        });

        // ===================== HÀM LOAD DỮ LIỆU =====================
        async function loadDashboardData() {
            try {
                const response = await fetch(`${apiBaseUrl}/${dashboardCode}/widgets?siteCode=${siteCode}`);
                if (!response.ok) throw new Error('Failed to load widgets');

                const data = await response.json();

                // Chuyển đổi từ API response thành widget object
                // Schema: id, dashboardcode, widgetcode, name, templetecode, storegetdata,
                //         positionx, positiony, width, height, configjson, chartconfig, etc.
                widgets = (data || []).map((w, idx) => {
                    let config = {};
                    try {
                        config = JSON.parse(w.configjson || '{}');
                    } catch (e) {
                        console.warn('Failed to parse config:', w.configjson);
                    }

                    return {
                        id: idx + 1,
                        dbId: w.id,
                        type: w.templetecode || 'card',
                        config: config,
                        x: parseInt(w.positionx) || 0,
                        y: parseInt(w.positiony) || 0,
                        w: parseInt(w.width) || 4,
                        h: parseInt(w.height) || 3,
                        code: w.widgetcode || '',
                        dataSource: (config && config.dataSource) || w.storegetdata || ''
                    };
                });

                nextWidgetId = widgets.length + 1;
                renderCanvas();
            } catch (error) {
                console.error('Error loading dashboard:', error);
                // Fallback to default empty dashboard
                renderCanvas();
            }
        }

        // ===================== RENDER LIBRARY =====================
        function renderLibrary() {
            const libContainer = document.getElementById('lib-container');
            libContainer.innerHTML = Object.entries(widgetTemplates)
                .map(([key, tmpl]) => `
                    <div class="lib-item" draggable="true" data-type="${key}">
                        <div class="ic" style="background:${tmpl.color}">${tmpl.icon}</div>
                        <div>
                            <strong>${tmpl.name}</strong>
                            <span class="desc">${tmpl.w}×${tmpl.h}</span>
                        </div>
                    </div>
                `).join('');

            // Kích hoạt drag from library
            document.querySelectorAll('.lib-item').forEach(el => {
                el.addEventListener('dragstart', e => {
                    e.dataTransfer.effectAllowed = 'copy';
                    e.dataTransfer.setData('type', el.dataset.type);
                    el.classList.add('dragging-source');
                });
                el.addEventListener('dragend', e => el.classList.remove('dragging-source'));
            });
        }

        // ===================== RENDER CANVAS =====================
        function renderCanvas() {
            const canvas = document.getElementById('canvas');
            canvas.innerHTML = '';

            widgets.forEach(wdg => {
                const tmpl = widgetTemplates[wdg.type] || {};
                const el = document.createElement('div');
                el.className = 'widget';
                el.dataset.id = wdg.id;
                el.innerHTML = `
                    <div class="widget-head">
                        <h4>${wdg.config.title || tmpl.name || 'Widget'}</h4>
                        <button class="rm" onclick="removeWidget(${wdg.id})">×</button>
                    </div>
                    <div class="widget-body">
                        <div class="loading-skeleton" style="height:100%;border-radius:6px;"></div>
                    </div>
                    <div class="resize-handle"></div>
                `;

                el.style.cssText = `
                    left: ${wdg.x}%;
                    top: ${wdg.y}%;
                    width: ${wdg.w}%;
                    height: ${wdg.h}%;
                `;

                el.addEventListener('click', () => selectWidget(wdg.id));
                canvas.appendChild(el);

                // Render widget content
                renderWidgetContent(wdg);
            });
        }

        // ===================== RENDER WIDGET CONTENT =====================
        function renderWidgetContent(wdg) {
            const el = document.querySelector(`[data-id="${wdg.id}"] .widget-body`);
            if (!el) return;

            const tmpl = widgetTemplates[wdg.type] || {};
            const config = wdg.config || {};

            switch (wdg.type) {
                case 'large_img_card':
                    el.innerHTML = `
                        <div style="display:flex;gap:14px;height:100%;">
                            <div style="flex:1;">
                                <h4 style="color:${config.color || '#000'}">${config.value1 || 'N/A'}</h4>
                                <p style="font-size:12px;color:#999;">${config.value2 || ''}</p>
                                <a href="${config.buttonurl || '#'}" class="btn btn-sm"
                                   style="background:${config.color || '#7367f0'};color:#fff;">
                                    ${config.buttontext || 'View'}
                                </a>
                            </div>
                            <div style="flex:1;text-align:center;">
                                <img src="${config.imageurl || ''}" style="max-height:${config.imageheight || 150}px;" />
                            </div>
                        </div>`;
                    break;

                case 'multiple_mini_card':
                    el.innerHTML = `
                        <div style="font-size:10px;color:#999;">${config.subContent || 'Multiple metrics'}</div>
                        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:8px;">
                            ${[1,2,3,4].map(i => `
                                <div class="card-kpi">
                                    <div>
                                        <div class="card-kpi-label">Metric ${i}</div>
                                        <div class="card-kpi-value">--</div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>`;
                    break;

                case 'donut':
                case 'line':
                case 'bar':
                    el.innerHTML = `<div id="chart-${wdg.id}" style="width:100%;height:100%;"></div>`;
                    // Render chart after DOM update
                    setTimeout(() => renderChart(wdg), 100);
                    break;

                case 'list':
                    el.innerHTML = `
                        <div style="font-size:11px;color:#999;margin-bottom:8px;">${config.title || 'List Items'}</div>
                        <ul style="list-style:none;padding:0;margin:0;font-size:12px;">
                            ${[1,2,3].map(i => `<li style="padding:6px 0;border-bottom:1px solid #f0f0f5;">Item ${i}</li>`).join('')}
                        </ul>`;
                    break;

                default:
                    el.innerHTML = `<div style="color:#999;text-align:center;padding:20px;">${config.title || 'Empty Widget'}</div>`;
            }
        }

        // ===================== RENDER CHART =====================
        function renderChart(wdg) {
            const chartEl = document.getElementById(`chart-${wdg.id}`);
            if (!chartEl) return;

            const options = {
                chart: { type: wdg.type, toolbar: { show: false }, height: '100%' },
                title: { text: wdg.config.title || '' },
                series: [{ name: 'Data', data: [30, 40, 45, 50, 49, 60, 70] }],
                xaxis: { categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] }
            };

            if (chartInstances[wdg.id]) chartInstances[wdg.id].destroy();
            const chart = new ApexCharts(chartEl, options);
            chart.render();
            chartInstances[wdg.id] = chart;
        }

        // ===================== WIDGET MANAGEMENT =====================
        function selectWidget(id) {
            selectedWidget = widgets.find(w => w.id === id);
            document.querySelectorAll('.widget').forEach(el => el.classList.remove('selected'));
            document.querySelector(`[data-id="${id}"]`)?.classList.add('selected');
            updateConfigPanel();
        }

        async function removeWidget(id) {
            if (!confirm('Remove this widget?')) return;

            const widget = widgets.find(w => w.id === id);
            if (widget && widget.code) {
                try {
                    // Gọi API để xóa từ database
                    const response = await fetch(
                        `${apiBaseUrl}/widget?dashboardCode=${dashboardCode}&widgetCode=${widget.code}`,
                        { method: 'DELETE' }
                    );

                    if (!response.ok) {
                        console.warn('Failed to delete from database:', response.statusText);
                    }
                } catch (error) {
                    console.error('Error deleting widget:', error);
                }
            }

            widgets = widgets.filter(w => w.id !== id);
            renderCanvas();
            selectedWidget = null;
            updateConfigPanel();
        }

        function addWidget(type) {
            const tmpl = widgetTemplates[type] || {};
            const newWidget = {
                id: nextWidgetId++,
                type: type,
                config: { title: tmpl.name || 'New Widget' },
                x: Math.random() * 50,
                y: Math.random() * 50,
                w: tmpl.w || 4,
                h: tmpl.h || 3,
                code: `widget_${nextWidgetId}`,
                dataSource: ''
            };
            widgets.push(newWidget);
            renderCanvas();
            selectWidget(newWidget.id);
        }

        // ===================== CONFIG PANEL =====================
        function updateConfigPanel() {
            const panel = document.getElementById('config-panel-content');
            if (!selectedWidget) {
                panel.innerHTML = '<div class="empty-hint">Select a widget to configure</div>';
                return;
            }

            const config = selectedWidget.config || {};
            panel.innerHTML = `
                <div class="field">
                    <label>Title</label>
                    <input type="text" value="${config.title || ''}"
                           onchange="updateConfig('title', this.value)">
                </div>
                <div class="field">
                    <label>Data Source</label>
                    <input type="text" value="${selectedWidget.dataSource || ''}"
                           onchange="updateConfig('dataSource', this.value)">
                </div>
                <div class="field">
                    <label>Color</label>
                    <input type="text" value="${config.color || '#7367f0'}"
                           onchange="updateConfig('color', this.value)">
                </div>
                <hr style="margin:12px 0;border:none;border-top:1px dashed var(--border);">
                <div style="font-size:11px;color:var(--text-muted);">
                    <strong>Position:</strong> X=${selectedWidget.x}% Y=${selectedWidget.y}%<br>
                    <strong>Size:</strong> ${selectedWidget.w}% × ${selectedWidget.h}%
                </div>
            `;
        }

        function updateConfig(key, value) {
            if (!selectedWidget) return;
            if (key === 'dataSource') {
                selectedWidget.dataSource = value;
            } else {
                selectedWidget.config = selectedWidget.config || {};
                selectedWidget.config[key] = value;
            }
            renderWidgetContent(selectedWidget);
            updateConfigPanel();
        }

        // ===================== INTERACT.JS (DRAG & RESIZE) =====================
        function setupInteract() {
            interact('.widget').resizable({
                edges: { left: false, right: true, bottom: true, top: false },
                listeners: {
                    move(event) {
                        let { x, y } = event.target.dataset;
                        x = (parseFloat(x) || 0);
                        y = (parseFloat(y) || 0);

                        event.target.style.width = event.rect.width + 'px';
                        event.target.style.height = event.rect.height + 'px';
                    },
                    end(event) {
                        const id = parseInt(event.target.dataset.id);
                        const wdg = widgets.find(w => w.id === id);
                        if (wdg && event.target.parentElement) {
                            const canvas = event.target.parentElement;
                            wdg.w = (event.target.offsetWidth / canvas.offsetWidth) * 100;
                            wdg.h = (event.target.offsetHeight / canvas.offsetHeight) * 100;
                        }
                    }
                },
                modifiers: [
                    interact.modifiers.restrictSize({
                        min: { width: 150, height: 100 }
                    })
                ]
            }).draggable({
                listeners: {
                    move(event) {
                        event.target.style.left = event.pageX - event.target.offsetWidth / 2 + 'px';
                        event.target.style.top = event.pageY - event.target.offsetHeight / 2 + 'px';
                    },
                    end(event) {
                        const id = parseInt(event.target.dataset.id);
                        const wdg = widgets.find(w => w.id === id);
                        if (wdg && event.target.parentElement) {
                            const canvas = event.target.parentElement;
                            wdg.x = (event.target.offsetLeft / canvas.offsetWidth) * 100;
                            wdg.y = (event.target.offsetTop / canvas.offsetHeight) * 100;
                        }
                    }
                }
            });
        }

        // ===================== DRAG & DROP LƯU VIỆN =====================
        function setupDragAndDrop() {
            const canvas = document.getElementById('canvas');

            canvas.addEventListener('dragover', e => {
                e.preventDefault();
                canvas.classList.add('drop-active');
            });

            canvas.addEventListener('dragleave', () => canvas.classList.remove('drop-active'));

            canvas.addEventListener('drop', e => {
                e.preventDefault();
                canvas.classList.remove('drop-active');
                const type = e.dataTransfer.getData('type');
                if (type) addWidget(type);
            });
        }

        // ===================== MODE SWITCH =====================
        function switchMode(mode) {
            document.querySelectorAll('.mode-switch button').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById('app').classList.toggle('mode-view', mode === 'view');
        }

        // ===================== GRID CONTROLS =====================
        function changeGridCols(delta) {
            let cols = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-cols').trim());
            cols = Math.max(4, Math.min(20, cols + delta));
            document.documentElement.style.setProperty('--grid-cols', cols);
            document.getElementById('grid-col-val').textContent = cols;
        }

        // ===================== SAVE DASHBOARD =====================
        async function saveDashboard() {
            try {
                // Tạo options JSON từ grid settings
                const gridOptions = {
                    dashboardCode: dashboardCode,
                    gridCols: parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-cols').trim()),
                    cellHeight: parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-cell').trim()),
                    gridGap: parseInt(getComputedStyle(document.documentElement).getPropertyValue('--grid-gap').trim()),
                    backgroundColor: '',
                    titleSize: '',
                    titleWeight: '',
                    titleColor: '',
                    widgetColor: ''
                };

                const payload = {
                    dashboardCode: dashboardCode,
                    dashboardName: dashboardCode,
                    options: JSON.stringify([gridOptions]),
                    datasourceId: null,
                    siteCode: siteCode,
                    widgets: widgets.map(w => ({
                        dashboardCode: dashboardCode,
                        widgetCode: w.code,
                        templateCode: w.type,
                        positionX: Math.round(w.x),
                        positionY: Math.round(w.y),
                        width: Math.round(w.w),
                        height: Math.round(w.h),
                        configJson: w.config,
                        chartConfig: {},
                        siteCode: siteCode
                    }))
                };

                const response = await fetch(`${apiBaseUrl}/save`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error('Failed to save');

                alert('✓ Dashboard saved successfully!');
            } catch (error) {
                alert('✗ Save failed: ' + error.message);
            }
        }

        // ===================== RESET LAYOUT =====================
        function resetLayout() {
            if (!confirm('Reset to default layout?')) return;
            widgets = [];
            renderCanvas();
            selectedWidget = null;
            updateConfigPanel();
        }
    </script>
}
