        // other
        function initDashboardBuilderColorPicker(wdg)
        {
          document.querySelectorAll('.dashboard-color-picker').forEach(pickerEl => {
            const pickerId = pickerEl.id;                  // ví dụ: 'color-background'
            const fieldId = pickerId.replace('color-', ''); // ví dụ: 'background'

            const inputEl = document.getElementById(fieldId);
            if (!inputEl) return; // bỏ qua nếu không tìm thấy input ẩn tương ứng

            // mặc định không hiển thị màu
            let defaultColor; // fallback

            const storedColor = inputEl.value?.trim();
            const dataDefault = pickerEl.getAttribute('data-default')?.trim();

            // nếu có giá trị màu store trả lên thì lấy
            if (storedColor) {
              defaultColor = storedColor;
            }
            // nếu không có thì kiểm tra có màu mặc định không? Không có thì lấy màu primary như ban đầu
            else if (dataDefault) {
              defaultColor = dataDefault;
            }
            
            // gán giá trị vào input ẩn
            inputEl.value = defaultColor

            const pickr = Pickr.create({
              el: '#' + pickerId,
              theme: 'monolith',
              default: defaultColor,  // nếu input ẩn có giá trị ban đầu
              swatches: ["rgba(144, 85, 253, 1)", "rgba(86, 202, 0, 1)", "rgba(255, 76, 81, 1)", "rgba(255, 180, 0, 1)", "rgba(22, 177, 255, 1)"],
              components: {
                preview: true,
                opacity: true,
                hue: true,
                interaction: {
                  hex: true,
                  rgba: true,
                  hsla: !0,
                  hsva: !0,
                  cmyk: !0,
                  input: true,
                  clear: true,
                  save: true
                }
              }
            });

            pickr.on('save', color => {
                const hex = color.toHEXA().toString();
                inputEl.value = hex;
                wdg.config[fieldId] = hex;
                renderWidgetContent(wdg);
                updateJsonPreview(wdg);
                pickr.hide();
            });

            pickr.on('change', color => {
                const hex = color.toHEXA().toString();
                inputEl.value = hex;
                wdg.config[fieldId] = hex;
                renderWidgetContent(wdg);
                updateJsonPreview(wdg);
            });
          });
        }
        // =========================================================================
        // MONACO EDITOR - CHART CONFIG OVERRIDE
        // =========================================================================
        let jsonEditor = null;
        const READONLY_CHART_FIELDS = {
          'code': true, 'title': true, 'color': true, 'series': true, 
          'labels': true, 'chart': true, 'colors': true, 'type': true, 
          'height': true
        };
        const CHART_TEMPLATES = {
          line: {
            grid: { borderColor: '#e0e0e0', strokeDashArray: 6, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } } },
            stroke: { width: 3, curve: 'smooth' },
            tooltip: { shared: false, intersect: true },
            xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
            yaxis: { labels: { show: true } },
            markers: { size: 6, strokeWidth: 3, strokeColors: 'transparent', hover: { size: 7 } }
          },
          bar: {
            grid: { borderColor: '#f1f1f1', strokeDashArray: 4 },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '45%', distributed: false } },
            dataLabels: { enabled: false }
          },
          donut: {
            legend: { position: 'right' },
            plotOptions: { pie: { donut: { size: '65%', labels: { show: true, total: { show: true, label: 'Tổng' } } } } },
            dataLabels: { enabled: true }
          }
        };
      // Cờ đánh dấu để chỉ đăng ký Provider/Command 1 lần duy nhất
      let isMonacoInitialized = false;

      function initMonacoEditor(wdg) {
        if (!wdg.kind.match(/^(line|bar|donut|heatmap)$/)) {
          document.getElementById('json-editor-container').style.display = 'none';
          return;
        }

        require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs' } });
        require(['vs/editor/editor.main'], function () {
          
          // 🧹 1. RESET EDITOR CŨ
          if (jsonEditor) {
            const oldModel = jsonEditor.getModel();
            jsonEditor.dispose(); // Hủy instance editor cũ
            if (oldModel) oldModel.dispose(); // Hủy model cũ để tránh hoãn bộ nhớ
          }

          // 🛡️ 2. CHỈ ĐĂNG KÝ COMMAND & PROVIDER NẾU CHƯA ĐĂNG KÝ (Tránh trùng lặp)
          if (!isMonacoInitialized) {
            
            // Toggle Command
            monaco.editor.registerCommand('toggle-json-boolean', (accessor, range, newValue) => {
              if (!jsonEditor) return;
              const model = jsonEditor.getModel();
              model.pushEditOperations(
                [],
                [{ range: monaco.Range.lift(range), text: newValue ? 'true' : 'false' }],
                () => null
              );
            });

            // Inlay Hints Provider
            monaco.languages.registerInlayHintsProvider('json', {
              provideInlayHints: function (model, token) {
                const hints = [];
                const matches = model.findMatches('\\b(true|false)\\b', false, true, false, null, true);

                for (const match of matches) {
                  const isTrue = match.matches[0] === 'true';
                  hints.push({
                    position: match.range.getStartPosition(),
                    label: [{
                      label: isTrue ? '☑️ ' : '🔲 ',
                      command: {
                        id: 'toggle-json-boolean',
                        title: 'Toggle Boolean',
                        arguments: [match.range, !isTrue]
                      }
                    }],
                    kind: monaco.languages.InlayHintKind.Type,
                    paddingRight: true
                  });
                }
                return { hints: hints, dispose: () => {} };
              }
            });

            // Color Provider
            monaco.languages.registerColorProvider('json', {
              provideDocumentColors: function (model) {
                const matches = model.findMatches('#(?:[0-9a-fA-F]{3}){1,2}\\b', false, true, false, null, true);
                return matches.map(m => {
                  const hex = m.matches[0];
                  const r = parseInt(hex.slice(1, 3), 16) / 255;
                  const g = parseInt(hex.slice(3, 5), 16) / 255;
                  const b = parseInt(hex.slice(5, 7), 16) / 255;
                  return { range: m.range, color: { red: r, green: g, blue: b, alpha: 1 } };
                });
              },
              provideColorPresentations: function (model, colorInfo) {
                const r = Math.round(colorInfo.color.red * 255).toString(16).padStart(2, '0');
                const g = Math.round(colorInfo.color.green * 255).toString(16).padStart(2, '0');
                const b = Math.round(colorInfo.color.blue * 255).toString(16).padStart(2, '0');
                return [{ label: `#${r}${g}${b}` }];
              }
            });

            // JSON Schema Config
            monaco.languages.json.jsonDefaults.setDiagnosticsOptions({
              validate: true,
              schemas: [{
                uri: "http://myserver/product-schema.json",
                fileMatch: ["*"],
                schema: {
                  $ref: "#/definitions/anyObject",
                  definitions: {
                    anyObject: {
                      type: "object",
                      properties: {
                        id: { type: "string" },
                        product_name: { type: "string" },
                        category: { type: "string", enum: ["Điện thoại", "Máy tính", "Gia dụng", "Thời trang", "Đồng hồ"] },
                        status: { type: "string", enum: ["Active", "Pending", "Archived"] },
                        strokeColors: { type: "string", enum: ["circle", "square", "rectangle", "oval"] }
                      },
                      additionalProperties: { $ref: "#/definitions/anyNode" }
                    },
                    anyNode: {
                      anyOf: [
                        { $ref: "#/definitions/anyObject" },
                        { type: "array", items: { $ref: "#/definitions/anyNode" } },
                        { type: "string" },
                        { type: "number" },
                        { type: "boolean" }
                      ]
                    }
                  }
                }
              }]
            });

            // Bật cờ để các lần gọi initMonacoEditor sau bỏ qua đoạn đăng ký này
            isMonacoInitialized = true;
          }

          // 🚀 3. TẠO TẢI LẠI EDITOR MỚI SẠCH SẼ
          const chartConfig = wdg.config.chartConfig || CHART_TEMPLATES[wdg.kind] || {};
          const displayConfig = markReadonlyFields(chartConfig);

          jsonEditor = monaco.editor.create(document.getElementById('json-editor'), {
            value: JSON.stringify(displayConfig, null, 2),
            language: 'json',
            theme: 'vs-dark',
            automaticLayout: true,
            minimap: { enabled: false },
            scrollBeyondLastLine: false,
            fixedOverflowWidgets: true,
            colorDecorators: true,
            inlayHints: { enabled: 'on' }
          });

          document.getElementById('json-editor-container').style.display = 'block';
          document.getElementById('json-output-container').style.display = 'block';
          
          document.getElementById('btn-apply-chart').onclick = () => applyChartConfig(wdg);
        });
      }

        function markReadonlyFields(obj, path = '') {
          const result = {};
          for (const key in obj) {
            const value = obj[key];
            const isReadonly = READONLY_CHART_FIELDS[key] || (path === 'chart' && (key === 'type' || key === 'height'));
            
            if (isReadonly && typeof value === 'string') {
              result[key] = `<${value}>`;
            } else if (isReadonly && typeof value === 'number') {
              result[key] = `<${value}>`;
            } else if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
              result[key] = markReadonlyFields(value, key);
            } else {
              result[key] = value;
            }
          }
          return result;
        }

        function restoreReadonlyValues(obj, originalWdg) {
          const result = {};
          for (const key in obj) {
            const value = obj[key];
            const isReadonly = READONLY_CHART_FIELDS[key];
            
            if (isReadonly) {
              if (key === 'code') result[key] = originalWdg.config.code;
              else if (key === 'title') result[key] = originalWdg.config.title;
              else if (key === 'color') result[key] = originalWdg.config.color;
              else if (key === 'series') result[key] = originalWdg.config.series;
              else if (key === 'labels') result[key] = originalWdg.config.labels;
              else if (key === 'chart') result[key] = originalWdg.config.chart || {};
              else if (key === 'colors') result[key] = originalWdg.config.colors;
              else result[key] = value;
            } else if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
              if (key === 'chart') {
                result[key] = {};
                for (const subKey in value) {
                  if (subKey === 'type' || subKey === 'height') {
                    result[key][subKey] = originalWdg.config.chart?.[subKey] || value[subKey];
                  } else {
                    result[key][subKey] = typeof value[subKey] === 'object' ? restoreReadonlyValues(value[subKey], originalWdg) : value[subKey];
                  }
                }
              } else {
                result[key] = restoreReadonlyValues(value, originalWdg);
              }
            } else {
              result[key] = value;
            }
          }
          return result;
        }

        function applyChartConfig(wdg) {
            if (!jsonEditor) return;
            const btnApply = document.getElementById('btn-apply-chart');
            const statusEl = document.getElementById('chart-status');
            btnApply.disabled = true;
          
            try {
              let parsedConfig = JSON.parse(jsonEditor.getValue());
              
              // Khôi phục readonly values từ markers (<type>, <color>, etc)
              parsedConfig = restoreReadonlyValuesFromMarkers(parsedConfig, wdg);
              
              // Lưu vào wdg.config
              wdg.config.chartConfig = parsedConfig;
              
              // Re-render widget với config mới
              renderWidgetContent(wdg);
              updateJsonPreview(wdg);
              
              // Build & display payload
              const payload = buildPayload();
              document.getElementById('json-output').value = JSON.stringify(payload, null, 2);
              
              statusEl.textContent = '✓ Chart config applied successfully!';
              statusEl.className = 'chart-status success';
            } catch (err) {
              statusEl.textContent = '✗ JSON Error: ' + err.message;
              statusEl.className = 'chart-status error';
            } finally {
              btnApply.disabled = false;
            }
          }

        function restoreReadonlyValuesFromMarkers(obj, wdg) {
          const result = {};
          
          for (const key in obj) {
            const value = obj[key];
            
            // Kiểm tra nếu value là marker string (<something>)
            if (typeof value === 'string' && value.match(/^<(.+)>$/)) {
              // Lấy giá trị gốc từ wdg.config
              result[key] = getOriginalValueForMarker(key, wdg);
            } else if (isObjectLike(value)) {
              result[key] = restoreReadonlyValuesFromMarkers(value, wdg);
            } else {
              result[key] = value;
            }
          }
          
          return result;
        }

        function getOriginalValueForMarker(key, wdg) {
          switch(key) {
            case 'type': return wdg.kind;
            case 'height': return wdg.config.chartHeight || '60%';
            case 'color': return wdg.config.color;
            case 'title': return wdg.config.title;
            case 'series': return wdg.config.series;
            case 'colors': return [wdg.config.color];
            case 'labels': return wdg.config.labels;
            default: return null;
          }
        }
        
        function createDisplayConfigWithMarkers(wdg, chartType) {
          const template = getChartTemplate(chartType);
          const chartConfig = wdg.config.chartConfig || template;
          
          return markReadonlyFieldsWithMarkers(chartConfig, wdg);
        }
        
        function markReadonlyFieldsWithMarkers(obj, wdg, path = '') {
          const result = {};
          
          for (const key in obj) {
            const value = obj[key];
            const isSystemField = key === 'series' || key === 'labels' || key === 'chart' || key === 'colors';
            const isChartSubfield = (path === 'chart' && (key === 'type' || key === 'height'));
            
            if (isSystemField || key === 'color' || key === 'title' || isChartSubfield) {
              // Thay thế bằng marker
              if (key === 'type') result[key] = '<type>';
              else if (key === 'height') result[key] = '<height>';
              else if (key === 'color') result[key] = '<color>';
              else if (key === 'title') result[key] = '<title>';
              else if (key === 'series') result[key] = '<series>';
              else if (key === 'colors') result[key] = '<colors>';
              else if (key === 'labels') result[key] = '<labels>';
              else if (key === 'chart') {
                // Xử lý nested chart object
                result[key] = {};
                for (const subKey in value) {
                  if (subKey === 'type' || subKey === 'height') {
                    result[key][subKey] = `<${subKey}>`;
                  } else {
                    result[key][subKey] = value[subKey];
                  }
                }
              }
            } else if (isObjectLike(value)) {
              result[key] = markReadonlyFieldsWithMarkers(value, wdg, key);
            } else {
              result[key] = value;
            }
          }
          
          return result;
        }
        
        function getChartTemplate(chartType) {
          const templates = {
            line: {
              grid: { borderColor: '#000', strokeDashArray: 6, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } }, padding: { top: -5, left: -7, right: 9, bottom: -5 } },
              stroke: { width: 3 },
              tooltip: { shared: false, intersect: true, x: { show: false }, enabled: true, theme: 'light' },
              xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
              yaxis: { labels: { show: true } },
              markers: { size: 6, strokeWidth: 3, strokeColors: 'transparent', colors: ['transparent'], hover: { size: 7 } }
            },
            bar: {
              grid: { borderColor: '#f1f1f1', strokeDashArray: 4, padding: { top: -5, left: -7, right: 9, bottom: -5 } },
              plotOptions: { bar: { borderRadius: 4, columnWidth: '45%', distributed: false } },
              dataLabels: { enabled: false },
              xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
              tooltip: { enabled: true, theme: 'light' }
            },
            donut: {
              legend: { position: 'right' },
              plotOptions: { pie: { donut: { size: '65%', labels: { show: true, total: { show: true, label: 'Tổng' } } } } },
              dataLabels: { enabled: true },
              tooltip: { enabled: true, theme: 'light' }
            }
          };
          
          return templates[chartType] || {};
        }
        
        // /**
        //  * Init Monaco editor khi select chart widget
        //  */
        // function initMonacoEditor(wdg) {
        //   // Chỉ init cho chart types
        //   if (!wdg.kind.match(/^(line|bar|donut|heatmap)$/)) {
