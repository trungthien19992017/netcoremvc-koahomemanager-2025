        // 12) LƯU - DỮ LIỆU ĐƯỢC GỬI ĐI BAO GỒM CÁC THÔNG SỐ GRID
        // ---------------------------------------------------------------------
        async function saveLayout(){
          const payload = {
            // Lưu các chỉ số cấu hình Grid hiện tại của Dashboard
            dashboardConfig: {
              dashboardCode: '@(ViewBag.DashboardCode ?? "")',
              gridCols: GRID_COLS,
              cellHeight: CELL,
              gridGap: GAP
            },
            // Lưu danh sách các Widget
            widgets: widgets.map(w=>({
              widgetTypeCode: w.kind,
              widgetCode: w.config.code,
              positionX: w.x, positionY: w.y, width: w.w, height: w.h,
              configJson: JSON.stringify(w.config)
            }))
          };

          let resultText;
          try{
            const res = await fetch('/Dashboards/SaveLayout', {
              method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload)
            });
            resultText = `POST /Dashboards/SaveLayout -> HTTP ${res.status}\n\n` + JSON.stringify(payload, null, 2);
          }catch(err){
            resultText = `[Demo offline - chưa có backend thật nên fetch() lỗi mạng, đây là dữ liệu LẼ RA sẽ được POST]\n\n` + JSON.stringify(payload, null, 2);
          }
          const out = document.getElementById('exportOutput');
          out.textContent = resultText + '\n\n// Click ra ngoài để đóng';
          out.style.display = 'block';
          out.onclick = ()=> out.style.display='none';
        }
        document.getElementById('btnSave').addEventListener('click', saveLayout);
        document.getElementById('btnReset').addEventListener('click', ()=>{
          if(confirm('Tải lại mẫu mặc định? Layout hiện tại sẽ mất.')) seedDefaultLayout();
        });

