        function buildPayload() {
          const dashConfig = {
            dashboardCode: 'dashboard_koa',
            gridCols: GRID_COLS,
            cellHeight: CELL,
            gridGap: GAP
          };
          
          return {
            dashboardConfig: dashConfig,
            widgets: widgets,
            chartConfigs: widgets
              .filter(w => w.config.chartConfig)
              .reduce((acc, w) => {
                acc[w.id] = w.config.chartConfig;
                return acc;
              }, {})
          };
        }
        
        function setupConfigPanelHook() {
          const originalRenderConfigPanel = renderConfigPanel;
          renderConfigPanel = function() {
            originalRenderConfigPanel.apply(this, arguments);
            const wdg = widgets.find(w => w.id === selectedId);
            if (wdg) {
              setTimeout(() => initMonacoEditor(wdg), 100);
            }
          };
        }

        // function buildPayload() {
        //   const dashConfig = {
