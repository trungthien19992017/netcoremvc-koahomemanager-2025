@{
    ViewData["Title"] = "Dashboard Builder (SortableJS)";
    Layout = "_BlankLayout";

    // Du lieu object (Mock/ViewBag)
    var SimpleCard_ChucMung = ViewBag.SimpleCard_ChucMung as IDictionary<string, object>;
    var SimpleCard_SoLieuTrongThang = ViewBag.SimpleCard_SoLieuTrongThang as IDictionary<string, object>;
    var LineChart_DoanhThuCacThang = ViewBag.LineChart_DoanhThuCacThang as IDictionary<string, object>;
    var ColumnChart_ChiPhiCacThang = ViewBag.ColumnChart_ChiPhiCacThang as IDictionary<string, object>;
    var ColumnChart_DoanhThuTuan = ViewBag.ColumnChart_DoanhThuTuan as IDictionary<string, object>;
    var PieChart_TyLeCacPhongTrongThang = ViewBag.PieChart_TyLeCacPhongTrongThang as IDictionary<string, object>;

    // Du lieu list (Mock/ViewBag)
    var ListItem_TopDichVuThang = ViewBag.ListItem_TopDichVuThang as List<dynamic>;
    var ListItem_TyLeKinPhongTuan = ViewBag.ListItem_TyLeKinPhongTuan as List<dynamic>;
    var ListItem_TopKhachHangGanDay = ViewBag.ListItem_TopKhachHangGanDay as List<dynamic>;
}

@section PageStyles {
    <style>
       :root{
          --primary:#7367f0; --bg:#f5f5f9; --card:#ffffff; --border:#e7e7ea;
          --text:#3d3d4e; --text-muted:#8a8d93; --success:#28c76f; --danger:#ea5455;
          --warn:#ff9f43; --info:#00cfe8; 
          --grid-cols: 12;
          --grid-cell: 70px; 
          --grid-gap: 14px;
        }
        *{box-sizing:border-box;}
        body{margin:0;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);}
        button{font-family:inherit;}

        /* ================= LAYOUT ================= */
        .app{display:grid;grid-template-columns:230px 1fr 290px;height:100vh;}
        .app.mode-view{grid-template-columns:0 1fr 0;}
        .app.mode-view .widget-library, .app.mode-view .config-panel, .app.mode-view .grid-controls{display:none;}
        .panel-title{font-size:12px;font-weight:700;text-transform:uppercase;color:var(--text-muted);letter-spacing:.03em;margin:0 0 12px;}

        /* ================= THƯ VIỆN WIDGET ================= */
        .widget-library{background:var(--card);border-right:1px solid var(--border);padding:16px 12px;overflow-y:auto;}
        .lib-item{display:flex;align-items:center;gap:10px;padding:10px 11px;border:1px solid var(--border);border-radius:8px;
          margin-bottom:8px;cursor:grab;background:#fafafd;font-size:13px;transition:.15s;}
        .lib-item:hover{border-color:var(--primary);background:#f1f0fe;}
        .lib-item .ic{width:28px;height:28px;border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
          color:#fff;font-size:14px;font-weight:700;}
        .lib-item .desc{font-size:10.5px;color:var(--text-muted);display:block;margin-top:1px;}
        .lib-item.dragging-source{opacity:.35;}
        .lib-hint{font-size:11.5px;color:var(--text-muted);line-height:1.6;margin:14px 2px 0;padding-top:12px;border-top:1px dashed var(--border);}

        /* ================= CANVAS ================= */
        .canvas-wrap{grid-column:2;display:flex;flex-direction:column;overflow:hidden;}
        .toolbar{background:var(--card);border-bottom:1px solid var(--border);padding:9px 18px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
        .toolbar h1{font-size:15px;margin:0;margin-right:auto;}
  
        /* Cụm điều khiển Grid */
        .grid-controls{display:flex;align-items:center;gap:8px;background:#f8f8fd;padding:4px 8px;border:1px solid var(--border);border-radius:8px;}
        .grid-ctrl-item{display:flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:var(--text-muted);}
        .grid-ctrl-btn{width:22px;height:22px;border:1px solid var(--border);background:#fff;border-radius:4px;cursor:pointer;font-weight:bold;display:flex;align-items:center;justify-content:center;}
        .grid-ctrl-btn:hover{background:var(--primary);color:#fff;border-color:var(--primary);}
        .grid-val{min-width:24px;text-align:center;color:var(--primary);font-weight:700;}

        .btn{border:none;border-radius:6px;padding:8px 13px;font-size:12.5px;cursor:pointer;font-weight:600;white-space:nowrap;}
        .btn-primary{background:var(--primary);color:#fff;}
        .btn-outline{background:#fff;border:1px solid var(--border);color:var(--text);}
        .btn-danger-outline{background:#fff;border:1px solid var(--danger);color:var(--danger);}
        .mode-switch{display:flex;background:#eeedf7;border-radius:7px;padding:3px;gap:2px;}
        .mode-switch button{border:none;background:transparent;padding:6px 12px;border-radius:5px;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--text-muted);}
        .mode-switch button.active{background:#fff;color:var(--primary);box-shadow:0 1px 3px rgba(0,0,0,.08);}
        .mobile-toggle{display:none;}

        .canvas-scroll{flex:1;overflow:auto;padding:20px;}
        #canvas{position:relative;min-height:900px;
          background-image:
            linear-gradient(to right, #eceaf9 1px, transparent 1px),
            linear-gradient(to bottom, #eceaf9 1px, transparent 1px);
          background-size: calc((100% - (var(--grid-cols) - 1) * var(--grid-gap)) / var(--grid-cols) + var(--grid-gap)) calc(var(--grid-cell) + var(--grid-gap));
          border:1px dashed var(--border); border-radius:10px;
        }
        #canvas.drop-active{background-color:#f1f0fe;}
        .app.mode-view #canvas{background-image:none;border:none;min-height:0;}
        #canvas.flow-stack{display:flex;flex-direction:column;gap:var(--grid-gap);min-height:0;}
        #canvas.flow-stack .widget{position:static !important;width:100% !important;height:auto !important;min-height:220px;}

        .widget{position:absolute;background:var(--card);border:1px solid var(--border);border-radius:10px;
          box-shadow:0 1px 3px rgba(0,0,0,.04); display:flex; flex-direction:column; overflow:hidden;}
        .widget:hover {
            box-shadow: 0 12px 24px rgba(0,0,0,0.12);
            transform: translateY(-4px);
        }
        .widget.selected{border-color:var(--primary); box-shadow:0 0 0 2px rgba(115,103,240,.25);}
        .widget-head{display:flex;align-items:center;justify-content:space-between;padding:10px 14px 4px;cursor:move;touch-action:none;}
        .widget-head h4{font-size:13px;margin:0;font-weight:600;}
        .widget-head .rm{cursor:pointer;color:var(--text-muted);font-size:14px;border:none;background:none;}
        .widget-head .rm:hover{color:var(--danger);}
        .app.mode-view .widget-head{cursor:default;}
        .app.mode-view .widget-head .rm, .app.mode-view .resize-handle{display:none;}
        .widget-body{flex:1;padding:6px 14px 14px;/*overflow:hidden;*/position:relative;}
        .resize-handle{position:absolute;right:0;bottom:0;width:18px;height:18px;cursor:nwse-resize;touch-action:none;
          background:linear-gradient(135deg, transparent 50%, #c9c7d8 50%);border-bottom-right-radius:8px;}

        /* ================= CONFIG PANEL ================= */
        .config-panel{background:var(--card);border-left:1px solid var(--border);padding:16px 14px;overflow-y:auto;}
        .empty-hint{font-size:13px;color:var(--text-muted);line-height:1.6;}
        .field{margin-bottom:13px;}
        .field label{display:block;font-size:11.5px;font-weight:600;margin-bottom:5px;color:var(--text-muted);}
        .field input[type=text], .field select{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;}
        .field-check{display:flex;align-items:center;gap:8px;font-size:12.5px;}
        .swatches{display:flex;gap:6px;}
        .swatch{width:22px;height:22px;border-radius:50%;cursor:pointer;border:2px solid transparent;}
        .swatch.active{border-color:#333;}
        .meta-row{font-size:11.5px;color:var(--text-muted);display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px dashed var(--border);}
        .json-preview{font-size:10.5px;background:#1e1e2e;color:#c9c9e8;padding:10px;border-radius:6px;white-space:pre-wrap;word-break:break-all;max-height:160px;overflow:auto;margin-top:6px;}

        /* ================= MONACO CHART CONFIG ================= */
        #json-editor-container{margin-top:12px;border-top:1px solid var(--border);padding-top:12px;}
        #json-editor{width:100%;height:240px;border:1px solid var(--border);border-radius:6px;overflow:hidden;}
        .chart-config-section{margin-top:10px;}
        .chart-config-label{font-size:11.5px;font-weight:600;color:var(--text-muted);margin-bottom:6px;display:block;}
        #btn-apply-chart{background:var(--primary);color:#fff;border:none;padding:8px 12px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;margin-top:8px;}
        #btn-apply-chart:hover{background:#5e50ee;}
        #btn-apply-chart:disabled{background:#ccc;cursor:not-allowed;}
        .chart-status{font-size:11px;margin-top:6px;min-height:18px;}
        .chart-status.success{color:var(--success);}
        .chart-status.error{color:var(--danger);}
        #json-output-container{margin-top:12px;border-top:1px solid var(--border);padding-top:12px;}
        #json-output{width:100%;height:180px;background:#1e1e2e;color:#c9c9e8;font-family:Consolas,'Courier New',monospace;font-size:10px;padding:8px;border-radius:6px;border:1px solid #333;resize:vertical;font-weight:500;}

        /* ================= MINI COMPONENTS ================= */
        .kpi-wrap{display:flex;align-items:center;gap:12px;height:100%;}
        .kpi-wrap .badge{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;flex-shrink:0;}
        .kpi-wrap .num{font-size:20px;font-weight:700;line-height:1.1;}
        .kpi-wrap .lbl{font-size:12px;color:var(--text-muted);}

        table.mini-table{width:100%;border-collapse:collapse;font-size:12px;}
        table.mini-table th{text-align:left;color:var(--text-muted);font-weight:600;padding:5px 6px;border-bottom:1px solid var(--border);font-size:11px;text-transform:uppercase;}
        table.mini-table td{padding:6px;border-bottom:1px dashed var(--border);}
        table.mini-table tr:last-child td{border-bottom:none;}

        ul.mini-list{list-style:none;margin:0;padding:0;font-size:12px;}
        ul.mini-list li{padding:7px 0;border-bottom:1px dashed var(--border);}
        ul.mini-list li:last-child{border-bottom:none;}
        .mini-list .row-top{display:flex;justify-content:space-between;}
        .mini-list .name{font-weight:600;}
        .mini-list .val{color:var(--success);font-weight:700;}
        .progress-track{background:#f0f0f5;border-radius:4px;height:5px;margin-top:4px;overflow:hidden;}
        .progress-fill{height:100%;}

        /* ================= DRAWER & RESPONSIVE ================= */
        .drawer-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
        .drawer-close{display:none;border:none;background:#f0f0f5;color:var(--text-muted);width:30px;height:30px;
          border-radius:7px;font-size:15px;cursor:pointer;align-items:center;justify-content:center;flex-shrink:0;}
        #drawerBackdrop{display:none;position:fixed;inset:0;background:rgba(20,18,35,.4);z-index:55;}
        #drawerBackdrop.show{display:block;}

        /* koa dashboard css */
        .card-img-position {
            position: absolute;
            block-size: 190px
        }

        .dashboard-filter .btn-dashboard-filter {
            position: fixed;
            z-index: 1080;
            box-shadow: 0 10px 25px rgba(47, 128, 255, 0.35);
            inset-block-start: 5rem;
            inset-inline-end: 1.5rem;
            background: #2F80FF;
        }

        .dashboard-filter .btn-dashboard-filter:hover {
            box-shadow: none !important
        }

        @@media (max-width:1100px){
          .grid-controls{display:none;} /* Ẩn bớt trên màn hình nhỏ nếu hẹp */
        }

        @@media (max-width:900px){
          .app, .app.mode-view{grid-template-columns:1fr !important;}
          .mobile-toggle{display:inline-flex;}
          .widget-library, .config-panel{position:fixed;top:0;bottom:0;width:82vw;max-width:320px;z-index:60;
            transform:translateX(-110%);transition:transform .22s;box-shadow:0 0 24px rgba(0,0,0,.25);padding: 65px 14px;}
          .config-panel{left:auto;right:0;transform:translateX(110%);padding: 56px 14px;}
          .widget-library.open, .config-panel.open{transform:translateX(0) !important;}
          .drawer-close{display:flex;}
          .toolbar h1{font-size:13px;}
          .canvas-scroll{padding:12px;}
        }
    </style>
}

<div class="app mode-build" id="appRoot">

    <!-- ============ THƯ VIỆN LOẠI WIDGET ============ -->
    <aside class="widget-library" id="libraryPanel">
        <div class="drawer-head">
            <p class="panel-title" style="margin:0;">Loại widget</p>
            <button class="drawer-close" id="closeLibBtn" title="Đóng">✕</button>
        </div>
        <div id="libraryList"></div>
        <p class="lib-hint">Kéo 1 loại widget vào canvas, sau đó chọn nó để chỉnh "Nguồn dữ liệu" và các thông số riêng ở panel bên phải.</p>
    </aside>

    <!-- ============ CANVAS ============ -->
    <main class="canvas-wrap">
        <div class="toolbar">
            <button class="btn btn-outline mobile-toggle" id="btnOpenLib">☰ Widget</button>
            <h1>Cấu hình Dashboard</h1>

            <!-- BỘ ĐIỀU KHIỂN ĐỘNG CÁC CHỈ SỐ GRID -->
            <div class="grid-controls">
                <div class="grid-ctrl-item" title="Số cột tối đa">
                    <span>Cột:</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('GRID_COLS', -1)">-</button>
                    <span class="grid-val" id="val_GRID_COLS">12</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('GRID_COLS', 1)">+</button>
                </div>
                <div class="grid-ctrl-item" title="Chiều cao 1 ô (px)">
                    <span>H ô:</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('CELL', -5)">-</button>
                    <span class="grid-val" id="val_CELL">70</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('CELL', 5)">+</button>
                </div>
                <div class="grid-ctrl-item" title="Khoảng cách giữa các ô (px)">
                    <span>Gap:</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('GAP', -2)">-</button>
                    <span class="grid-val" id="val_GAP">14</span>
                    <button class="grid-ctrl-btn" onclick="updateGridParam('GAP', 2)">+</button>
                </div>
            </div>

            <div class="mode-switch">
                <button id="modeBuildBtn" class="active">🛠 Build</button>
                <button id="modeViewBtn">👁 View</button>
            </div>
            <button class="btn btn-outline" id="btnReset">Mẫu mặc định</button>
            <button class="btn btn-primary" id="btnSave">Lưu (POST JSONB)</button>
            <button class="btn btn-outline mobile-toggle" id="btnOpenCfg">⚙</button>
        </div>
        <div class="canvas-scroll">
            <div id="canvas"></div>
        </div>
    </main>

    <!-- ============ CONFIG PANEL ============ -->
    <aside class="config-panel" id="configPanel">
        <div class="drawer-head">
            <p class="panel-title" style="margin:0;">Cấu hình widget</p>
            <button class="drawer-close" id="closeCfgBtn" title="Đóng">✕</button>
        </div>
        <div id="configPanelBody">
            <div class="empty-hint">Chọn 1 widget trên canvas để cấu hình.</div>
        </div>
    </aside>

</div>
<div id="drawerBackdrop"></div>

<pre id="exportOutput" style="display:none;position:fixed;inset:5%;background:#1e1e2e;color:#c9c9e8;padding:20px;overflow:auto;
  border-radius:10px;z-index:999;font-size:11.5px;box-shadow:0 10px 40px rgba(0,0,0,.4);white-space:pre-wrap;"></pre>

@section PageScripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/interactjs@1.10.27/dist/interact.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs/loader.min.js"></script>

    <script>
        let GRID_COLS = 12;
        let CELL = 70;
        let GAP  = 14;

        const READONLY_MARKERS = {
          'type': '<type>',
          'height': '<height>',
          'color': '<color>',
          'title': '<title>',
          'series': '<series>',
          'colors': '<colors>'
        };

        // Cập nhật các chỉ số GRID_COLS, CELL, GAP trực tiếp trên UI
        function updateGridParam(param, delta){
          if(param === 'GRID_COLS'){
            GRID_COLS = Math.max(4, Math.min(24, GRID_COLS + delta));
            document.getElementById('val_GRID_COLS').textContent = GRID_COLS;
            document.documentElement.style.setProperty('--grid-cols', GRID_COLS);
          } else if(param === 'CELL'){
            CELL = Math.max(30, Math.min(200, CELL + delta));
            document.getElementById('val_CELL').textContent = CELL;
            document.documentElement.style.setProperty('--grid-cell', CELL + 'px');
          } else if(param === 'GAP'){
            GAP = Math.max(0, Math.min(50, GAP + delta));
            document.getElementById('val_GAP').textContent = GAP;
            document.documentElement.style.setProperty('--grid-gap', GAP + 'px');
          }
  
          // Đảm bảo không widget nào vượt quá GRID_COLS mới
          widgets.forEach(w => {
            if(w.x + w.w > GRID_COLS){
              if(w.w > GRID_COLS) w.w = GRID_COLS;
              w.x = Math.max(0, GRID_COLS - w.w);
            }
          });

          renderCanvas();
        }

        // ---------------------------------------------------------------------
        // 1) LOẠI WIDGET GENERIC
        // ---------------------------------------------------------------------
        const WIDGET_KINDS = [
          { kind:'emoji_card', name:'Thẻ số liệu (emoji)', desc:'Số + icon + nhãn',      icon:'#',  color:'#28c76f', defaultW:3, defaultH:2, minW:2,minH:2,maxW:5,maxH:3 },
          { kind:'donut',    name:'Biểu đồ Donut',     desc:'Tỷ lệ theo danh mục',   icon:'◔',  color:'#ff9f43', defaultW:6, defaultH:5, minW:4,minH:4,maxW:9,maxH:6 },
          { kind:'line',     name:'Biểu đồ Line',      desc:'Xu hướng theo thời gian', icon:'⟋', color:'#7367f0', defaultW:4, defaultH:3, minW:3,minH:2,maxW:6,maxH:4 },
          { kind:'bar',      name:'Biểu đồ Bar/Column',desc:'So sánh theo nhóm',     icon:'▥',  color:'#00cfe8', defaultW:4, defaultH:4, minW:3,minH:3,maxW:8,maxH:5 },
          { kind:'table',    name:'Bảng dữ liệu',      desc:'Table nhiều cột',       icon:'▤',  color:'#ea5455', defaultW:6, defaultH:4, minW:4,minH:3,maxW:12,maxH:6 },
          { kind:'list',     name:'Danh sách xếp hạng',desc:'List + progress bar',   icon:'☰',  color:'#7367f0', defaultW:5, defaultH:4, minW:3,minH:3,maxW:8,maxH:6 },
          { kind:'heatmap',  name:'Heatmap',           desc:'Ma trận cường độ',      icon:'▦',  color:'#00cfe8', defaultW:6, defaultH:5, minW:5,minH:4,maxW:12,maxH:6 },
          { kind:'large_img_card', name:'Thể số liệu (ảnh lớn)',desc:'Số liệu 1 + 2 + ảnh lớn + nhãn', icon:'#',  color:'#28c76f', defaultW:3, defaultH:2, minW:2,minH:2,maxW:8,maxH:4 },
          { kind:'multiple_mini_card', name:'Thẻ nhiều chi tiết',desc:'Thẻ nhiều chi tiết',   icon:'☰',  color:'#7367f0', defaultW:5, defaultH:4, minW:3,minH:3,maxW:12,maxH:4 },
          { kind:'report', name:'Báo cáo',desc:'Tương tự table',   icon:'☰',  color:'#7367f0', defaultW:5, defaultH:4, minW:3,minH:3,maxW:12,maxH:4 },
          { kind:'button', name:'Button', desc:'Nút xử lý',      icon:'#',  color:'#28c76f', defaultW:2, defaultH:1, minW:1,minH:1,maxW:6,maxH:2 },
        ];
        function kindOf(k){ return WIDGET_KINDS.find(t=>t.kind===k); }

        // ---------------------------------------------------------------------
        // 2) NGUỒN DỮ LIỆU MOCK
        // ---------------------------------------------------------------------
        const MOCK_DATASETS = {
          revenue_by_room:{ label:'Doanh thu theo phòng (tháng)', shape:'categorical', data:{
            labels:['KOA 101 (TP)','KOA 102 (TP)','KOA 201 (TP)','KOA 302 (TP)','KOA 101 (TĐ)','KOA 102 (TĐ)','KOA 201 (TĐ)','KOA 202 (TĐ)'],
            values:[9524,10928,9953,9210,11386,10491,9140,8197],
            colors:['#16C47F','#FFD65A','#FF9D23','#F93827','#3A59D1','#3D90D7','#7AC6D2','#B5FCCD'] }},
          monthly_revenue_trend:{ label:'Doanh thu 6 tháng gần đây', shape:'series', data:{
            categories:['T2','T3','T4','T5','T6','T7'], series:[65434,126586,60782,5695,36442,78829] }},
          monthly_cost_trend:{ label:'Chi phí 6 tháng gần đây', shape:'series', data:{
            categories:['T2','T3','T4','T5','T6','T7'], series:[16837,12817,3325,15000,30062,34575] }},
          weekly_revenue:{ label:'Doanh thu theo tuần (T2-CN)', shape:'series', data:{
            categories:['T2','T3','T4','T5','T6','T7','CN'], series:[4730,3137,3950,2358,1600,1815,330] }},
          top_services:{ label:'Top dịch vụ', shape:'rows', data:{
            columns:[{field:'name',label:'Dịch vụ'},{field:'qty',label:'Lượt'},{field:'vnd',label:'Doanh thu'},{field:'image',label:'Ảnh'}],
            rows:[
              {name:'B - Book combo giờ', description:'80 lượt', qty:'72', vnd:'19.900.000', image:'/img/ServiceImage/Combo2Tieng.png'},
              {name:'B - Book qua đêm T5 - CN', description:'59 lượt', qty:'37', vnd:'14.800.000', image:'/img/ServiceImage/Combo2Tieng.png'},
              {name:'B - Book combo giờ T7 - CN', description:'45 lượt', qty:'40', vnd:'14.480.000', image:'/img/ServiceImage/QuaDem.png'},
              {name:'B - KM Overnight', description:'45 lượt', qty:'33', vnd:'11.550.000', image:'/img/ServiceImage/QuaDem.png'},
