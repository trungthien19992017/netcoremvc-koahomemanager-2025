              function saveLayout() {
                if (Dashboard6UI.hasDrafts()) { alert('Hãy áp dụng cấu hình JSON nâng cao đang sửa trước khi lưu.'); return; }
                // 1. Chuẩn bị dữ liệu JSON
                const codes = widgets.map(w => w.config?.code?.trim());
                if (codes.some(code => !code) || new Set(codes).size !== codes.length) {
                  alert('Mỗi widget cần có mã riêng, không để trống hoặc trùng mã.'); return;
                }

                const optionsJson = JSON.stringify({
                  ...options,
                  gridCols: GRID_COLS,
                  cellHeight: CELL,
                  gridGap: GAP
                });

                const widgetsJson = JSON.stringify(widgets.map(w => ({
                  id: w.id,
                  kind: w.kind,
                  widgetCode: w.config?.code,
                  x: w.x,
                  y: w.y,
                  w: w.w,
                  h: w.h,
                  config: w.config,
                  chart: chartForSave(w.chart)
                })));

                // 2. Đưa dữ liệu vào FormData
                var formData = new FormData();
                formData.append("dashboardCode", dashboardCode);
                formData.append("options", optionsJson);
                formData.append("widgets", widgetsJson);

                // Lấy AntiforgeryToken nếu backend có yêu cầu Validate
                var antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                formData.append('__RequestVerificationToken', antiforgeryToken || '');
                document.getElementById('btnSave').disabled = true;

                // 3. Gọi AJAX theo phong cách handleAjaxConfirmed
                $.ajax({
                  url: '/Dashboards/SaveLayout7', // Thay đúng URL Controller của bạn
                  type: 'POST',
                  data: formData,
                  processData: false, // Bắt buộc khi dùng FormData
                  contentType: false, // Bắt buộc khi dùng FormData
                  success: function (response) {
                    if (response.success) {
                      celebrate();
                      rplm({
                        title: "Lưu giao diện thành công!",
                        text: "Cấu hình Dashboard đã được cập nhật.",
                        type: "success",
                        timer: 2000,
                        confirmButtonText: 'Xác nhận',
                        html: true
                      }, function () {
                        location.reload();
                      });
                    } else {
                      rplm({
                        title: "Lỗi!",
                        text: escapeHtml(response.errorMessage || "Không thể lưu cấu hình Dashboard."),
                        type: "error",
                        timer: 2000,
                        confirmButtonText: 'Xác nhận',
                        html: true
                      });
                    }
                  },
                  complete: function () { document.getElementById('btnSave').disabled = false; },
                  error: function (xhr) {
                    rplm({
                      title: "Lỗi!",
                      text: escapeHtml(xhr.responseJSON?.errorMessage || "Lỗi khi kết nối đến máy chủ."),
                      type: "error",
                      timer: 2000,
                      confirmButtonText: 'Xác nhận',
                      html: true
                    });
                  }
                });
              }
              document.getElementById('btnSave').addEventListener('click', saveLayout);
              document.getElementById('btnReset').addEventListener('click', ()=>{
                if(confirm('Hoàn tác các thay đổi bố cục chưa lưu?')) seedDefaultLayout();
              });

