                document.getElementById('val_GRID_COLS').textContent = GRID_COLS;
                document.getElementById('val_CELL').textContent = CELL;
                document.getElementById('val_GAP').textContent = GAP;
                document.documentElement.style.setProperty('--grid-cols', GRID_COLS);
                document.documentElement.style.setProperty('--grid-cell', CELL + 'px');
                document.documentElement.style.setProperty('--grid-gap', GAP + 'px');

                idSeq = 1;

                widgets = cloneConfig(Array.isArray(initialWidgets) ? initialWidgets : []).map(w => {
                  w.id = String(w.id || 'new-' + crypto.randomUUID());
                  w.config ||= {};
                  delete w.config.dataSource;
                  if (w.kind === 'large_img_card') { delete w.config.value1; delete w.config.value2; }
                  return w;
                });
                selectedId = null;
                renderCanvas();
                renderConfigPanel();
              }
