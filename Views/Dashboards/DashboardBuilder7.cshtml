              const SYSTEM_CHART_ROOTS = new Set(['chart', 'series', 'labels', 'colors']);

              function cloneConfig(value){ return JSON.parse(JSON.stringify(value || {})); }
              function getByPath(object, path){ return path.split('.').reduce((current, key) => current?.[key], object); }
              function setByPath(object, path, value){
                const keys = path.split('.');
                const lastKey = keys.pop();
                const target = keys.reduce((current, key) => (current[key] ||= {}), object);
                target[lastKey] = value;
              }
              function deleteByPath(object, path){
                const keys = path.split('.');
                const lastKey = keys.pop();
                const target = keys.reduce((current, key) => current?.[key], object);
                if (target && Object.prototype.hasOwnProperty.call(target, lastKey)) delete target[lastKey];
              }
              function chartConfigForEditor(wdg)
              {
                return wdg.chart; //|| getChartTemplate(wdg.kind) || {};
              }
              function persistChartValue(wdg, path, value){
                // if (!wdg.chart) wdg.chart = cloneConfig(getChartTemplate(wdg.kind));
                setByPath(wdg.chart, path, value);
                renderWidgetContent(wdg);
                updateJsonPreview(wdg);
              }
              function editorValue(config, field){
                const value = getByPath(config, field.path);
                if (value === undefined) return field.default;
                if (field.type === 'range' && typeof value === 'string' && field.suffix && value.endsWith(field.suffix)) return Number(value.slice(0, -field.suffix.length));
                return value;
              }
              function createSchemaField(wdg, config, field){
                const wrap = document.createElement('div');
                wrap.className = 'schema-field';
                const value = editorValue(config, field);
                const label = document.createElement('label');
                label.textContent = field.label;
                wrap.appendChild(label);
                let input;
                if (field.type === 'boolean') {
                  input = document.createElement('input'); input.type = 'checkbox'; input.checked = !!value;
                  label.className = 'schema-switch'; label.textContent = '';
                  label.append(input, document.createTextNode(field.label)); wrap.replaceChildren(label);
                  input.addEventListener('change', () => persistChartValue(wdg, field.path, input.checked));
                } else if (field.type === 'select') {
                  input = document.createElement('select');
                  field.options.forEach(option => { const el = document.createElement('option'); el.value = option; el.textContent = option; el.selected = option === value; input.appendChild(el); });
                  input.addEventListener('change', () => persistChartValue(wdg, field.path, input.value)); wrap.appendChild(input);
                } else if (field.type === 'color') {
                  const row = document.createElement('div'); row.className = 'schema-inline';
                  input = document.createElement('input'); input.type = 'color'; input.value = /^#[0-9a-f]{6}$/i.test(value) ? value : field.default;
                  const code = document.createElement('output'); code.value = input.value; code.textContent = input.value;
                  input.addEventListener('input', () => { code.value = input.value; code.textContent = input.value; persistChartValue(wdg, field.path, input.value); });
                  row.append(input, code); wrap.appendChild(row);
                } else if (field.type === 'range') {
                  const row = document.createElement('div'); row.className = 'schema-inline';
                  input = document.createElement('input'); input.type = 'range'; input.min = field.min; input.max = field.max; input.step = field.step || 1; input.value = value;
                  const output = document.createElement('output'); output.textContent = `${input.value}${field.suffix || ''}`;
                  input.addEventListener('input', () => { output.textContent = `${input.value}${field.suffix || ''}`; persistChartValue(wdg, field.path, field.suffix ? `${input.value}${field.suffix}` : Number(input.value)); });
                  row.append(input, output); wrap.appendChild(row);
                } else {
                  input = document.createElement('input'); input.type = 'number'; input.min = field.min; input.max = field.max; input.step = field.step || 1; input.value = value;
                  input.addEventListener('change', () => persistChartValue(wdg, field.path, Number(input.value))); wrap.appendChild(input);
                }
                return wrap;
              }
              function renderUnknownTree(wdg, config, host, knownRoots){
                const unknown = Object.fromEntries(Object.entries(config).filter(([key]) => !knownRoots.has(key) && !SYSTEM_CHART_ROOTS.has(key)));
                const details = document.createElement('details'); details.className = 'schema-group';
                const summary = document.createElement('summary'); summary.textContent = 'Trường mở rộng'; details.appendChild(summary);
                const body = document.createElement('div'); body.className = 'schema-group-body'; details.appendChild(body);
                const renderNode = (value, path, key, canRemove = true) => {
                  const isObject = value && typeof value === 'object' && !Array.isArray(value);
                  if (isObject) {
                    const node = document.createElement('details'); node.className = 'tree-node'; node.open = path.split('.').length < 2;
                    const title = document.createElement('summary'); title.textContent = key; node.appendChild(title);
                    Object.entries(value).forEach(([childKey, childValue]) => node.appendChild(renderNode(childValue, `${path}.${childKey}`, childKey)));
                    const add = document.createElement('button'); add.type = 'button'; add.className = 'tree-add'; add.textContent = '+ Thuộc tính';
                    add.addEventListener('click', () => { const name = prompt('Tên thuộc tính mới'); if (name && !/[.]/.test(name)) { persistChartValue(wdg, `${path}.${name}`, ''); renderChartConfigEditor(wdg); } });
                    node.appendChild(add); return node;
                  }
                  const row = document.createElement('div'); row.className = 'tree-leaf';
                  const name = document.createElement('label'); name.textContent = key;
                  let input;
                  if (Array.isArray(value)) { input = document.createElement('textarea'); input.value = JSON.stringify(value); input.addEventListener('change', () => { try { persistChartValue(wdg, path, JSON.parse(input.value)); } catch (_) { input.classList.add('invalid'); } }); }
                  else { input = document.createElement('input'); input.type = typeof value === 'number' ? 'number' : 'text'; input.value = String(value ?? ''); input.addEventListener('change', () => persistChartValue(wdg, path, typeof value === 'boolean' ? input.value === 'true' : typeof value === 'number' ? Number(input.value) : input.value)); }
                  row.append(name, input);
                  if (canRemove) { const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'tree-remove'; remove.textContent = '×'; remove.title = 'Xóa thuộc tính'; remove.addEventListener('click', () => { if (!wdg.chart) return; deleteByPath(wdg.chart, path); renderWidgetContent(wdg); updateJsonPreview(wdg); renderChartConfigEditor(wdg); }); row.appendChild(remove); }
                  return row;
                };
                Object.entries(unknown).forEach(([key, value]) => body.appendChild(renderNode(value, key, key)));
                const addRoot = document.createElement('button'); addRoot.type = 'button'; addRoot.className = 'tree-add'; addRoot.textContent = '+ Thuộc tính cấp cao';
                addRoot.addEventListener('click', () => { const name = prompt('Tên thuộc tính mới'); if (name && !/[.]/.test(name)) { persistChartValue(wdg, name, ''); renderChartConfigEditor(wdg); } });
                body.appendChild(addRoot); host.appendChild(details);
              }
              function renderChartConfigEditor(wdg){
                const host = document.getElementById('chart-config-editor');
                if (!host) return;
                host.replaceChildren();
                const groups = CHART_CONFIG_SCHEMAS[wdg.kind];
                if (!groups) return;
                const shell = document.createElement('section'); shell.className = 'schema-editor';
                const title = document.createElement('p'); title.className = 'panel-title'; title.textContent = 'Tùy chỉnh biểu đồ'; shell.appendChild(title);
                const config = chartConfigForEditor(wdg);
                const knownRoots = new Set();
                groups.forEach((group, index) => { const details = document.createElement('details'); details.className = 'schema-group'; details.open = index === 0; const summary = document.createElement('summary'); summary.textContent = group.title; const body = document.createElement('div'); body.className = 'schema-group-body'; group.fields.forEach(field => { knownRoots.add(field.path.split('.')[0]); body.appendChild(createSchemaField(wdg, config, field)); }); details.append(summary, body); shell.appendChild(details); });
                host.appendChild(shell);
                renderUnknownTree(wdg, config, shell, knownRoots);
              }

              // =========================================================================
              // LEGACY MONACO IMPLEMENTATION (not invoked in v6)
              // =========================================================================
              let jsonEditor = null;
              const CHART_TEMPLATES = {
                line: {
                  grid: { borderColor: '#e0e0e0', strokeDashArray: 6, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } } },
                  stroke: { width: 3, curve: 'smooth' },
                  tooltip: { shared: false, intersect: true },
                  xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
                  yaxis: { labels: { show: true } },
                  markers: { size: 6, strokeWidth: 3, strokeColors: 'transparent', hover: { size: 7 } }
                },
                bar: {
                  grid: { borderColor: '#f1f1f1', strokeDashArray: 4 },
                  plotOptions: { bar: { borderRadius: 4, columnWidth: '45%', distributed: false } },
                  dataLabels: { enabled: false }
                },
                donut: {
                  legend: { position: 'right' },
                  plotOptions: { pie: { donut: { size: '65%', labels: { show: true, total: { show: true, label: 'Tổng' } } } } },
                  dataLabels: { enabled: true }
                }
              };

        /**
          * Lấy chart template mặc định theo loại
          */
        // function getChartTemplate(chartType) {
        //   const templates = {
        //     line: {
        //       grid: { borderColor: '#000', strokeDashArray: 6, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } }, padding: { top: -5, left: -7, right: 9, bottom: -5 } },
        //       stroke: { width: 3 },
        //       tooltip: { shared: false, intersect: true, x: { show: false }, enabled: true, theme: 'light' },
        //       xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
        //       yaxis: { labels: { show: true } },
        //       markers: { size: 6, strokeWidth: 3, strokeColors: 'transparent', colors: ['transparent'], hover: { size: 7 } }
        //     },
        //     bar: {
        //       grid: { borderColor: '#f1f1f1', strokeDashArray: 4, padding: { top: -5, left: -7, right: 9, bottom: -5 } },
        //       plotOptions: { bar: { borderRadius: 4, columnWidth: '45%', distributed: false } },
        //       dataLabels: { enabled: false },
        //       xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
        //       tooltip: { enabled: true, theme: 'light' }
        //     },
        //     donut: {
        //       legend: { position: 'right' },
        //       plotOptions: { pie: { donut: { size: '65%', labels: { show: true, total: { show: true, label: 'Tổng' } } } } },
        //       dataLabels: { enabled: true },
        //       tooltip: { enabled: true, theme: 'light' }
        //     }
        //   };

        //   return templates[chartType] || {};
        // }

        function buildChartOptionsFromTemplate(wdg, data, chartType) {
          // Base template theo chart type
          const templates = {
            line: {
              chart: {
                height: '80%',
                type: 'line',
                parentHeightOffset: 0,
                toolbar: { show: false }
              },
              grid: {
                borderColor: '#000',
                strokeDashArray: 6,
                xaxis: { lines: { show: true } },
                yaxis: { lines: { show: false } },
                padding: { top: -5, left: -7, right: 9, bottom: -5 }
              },
              stroke: { width: 3 },
              fill: { type: wdg.config.showArea ? 'gradient' : 'solid', opacity: wdg.config.showArea ? 0.25 : 1 },
              colors: [wdg.config.color],
              series: [{ name: wdg.config.title, data: data.series }],
              tooltip: { shared: false, intersect: true, x: { show: false }, enabled: true, theme: 'light' },
              xaxis: { labels: { show: true }, axisTicks: { show: false }, axisBorder: { show: false } },
              yaxis: { labels: { show: true } },
              markers: {
                size: 6, strokeWidth: 3, strokeColors: 'transparent',
                colors: ['transparent'],
                discrete: [
                  {
                    seriesIndex: 0,
                    dataPointIndex: 5,
                    fillColor: '#000',
                    strokeColor: '#000',
                    size: 6,
                    shape: 'circle'
                  }
                ],
                hover: { size: 7 }
              }
            },
            bar: {
              chart: {
                height: '80%',
                type: 'bar',
                parentHeightOffset: 0,
                toolbar: { show: false }
              },
              grid: {
                borderColor: '#f1f1f1',
                strokeDashArray: 4,
                padding: { top: -5, left: -7, right: 9, bottom: -5 }
              },
              colors: [wdg.config.color],
              series: [{ name: wdg.config.title, data: data.series }],
              plotOptions: {
                bar: { borderRadius: 4, columnWidth: '50%', distributed: false, horizontal: !!wdg.config.horizontal }
              },
              dataLabels: { enabled: false },
              xaxis: {
                categories: data.categories || [],
                labels: { show: true, style:{fontSize:'10px'} },
                axisTicks: { show: false },
                axisBorder: { show: false }
              },
              tooltip: { enabled: true, theme: 'light' }
            },
            donut: {
              chart: {
                height: '80%',
                type: 'donut'
              },
              labels: data.labels || [],
              series: data.values || [],
              colors: data.colors || [],
              stroke: {
                width: 0
              },
              dataLabels: {
                enabled: !0
              },
              legend: {
                show: !0,
                position: wdg.config.legendPosition || 'right',
                fontSize: '13px',
                labels: {
                  colors: '#000',
                  useSeriesColors: !1
                },
                markers: {
                  offsetY: 0,
                  offsetX: -3,
                  height: 10,
                  width: 10
                },
                itemMargin: {
                  vertical: 3,
                  horizontal: 10
                }
              },
              tooltip: {
                style: {
                  color: '#FFF'
                }
              },
              grid: {
                padding: {
                  top: 0
                }
              },
              plotOptions: {
                pie: {
                  donut: {
                    size: '70%',
                    labels: {
                      show: !0,
                      value: {
                        fontSize: '22px',
                        fontFamily: 'Inter',
                        color: '#000',
                        fontWeight: 500,
                        offsetY: -20,
                        formatter: function (val) {
                          return fmt(Number(val),wdg);
                        }
                      },
                      name: {
                        offsetY: 20,
                        fontFamily: 'Inter',
                        fontWeight: '500',
                        formatter: function (val) {
                          return val
                        }
                      },
                      total: {
                        show: !0,
                        fontSize: '15px',
                        fontFamily: 'Inter',
                        label: 'Tổng',
                        formatter: function (e) {
                            const totalValue = e.globals.seriesTotals.reduce((a, b) => a + b, 0);
                            return fmt(totalValue,wdg);
                        }
                      }
                    }
                  }
                }
              },
              responsive: [{
                breakpoint: 1399,
                options: {
                  chart: {
                    height: 200
                  }
                }
              }, {
                breakpoint: 420,
                options: {
                  chart: {
                    height: 300
                  }
                }
              }]
            },
            heatmap: {
              chart: {
                height: '80%',
                type: 'heatmap',
                parentHeightOffset: 0,
                toolbar: { show: false }
              },
              colors: [wdg.config.color],
              series: [],
              xaxis: { categories: data.categories || data.weekLabels || [] },
              plotOptions: {
                heatmap: {
                  colorScale: {
                    ranges: data.ranges || [
                        {from:0,to:1000,color:'#b9b3f8'},
                        {from:1001,to:3000,color:'#9d95f5'},
                        {from:3001,to:5000,color:'#8176f2'},
                        {from:5001,to:9000,color:'#7367f0'}
                    ]
                  }
                }
              },
              tooltip: { enabled: true, theme: 'light' }
            }
          };

          const baseOptions = templates[chartType] || {};
          const chartConfig = wdg.chart || {};
          const savedOverrides = chartForSave(chartConfig) || {};

          // Deep merge: base + override + system lock
          const finalOptions = deepMergeOptions(baseOptions, savedOverrides);

          // Lock system fields (always from wdg config)
          finalOptions.colors = [wdg.config.color];
          if (chartType == 'donut') {
            finalOptions.series = data.values || [];
            finalOptions.labels = data.labels || [];
            finalOptions.colors = data.colors || [];
          } else if (chartType == 'heatmap'){
            const series = data.days.map(d=>({ name:d, data: data.weekLabels.map((w,i)=>({x:w, y:data.matrix[d][i]})) }));
            finalOptions.colors = [wdg.config.color];
            finalOptions.series = series;
            finalOptions.xaxis = finalOptions.xaxis || {};
            finalOptions.xaxis.categories = data.categories || data.weekLabels || [];
            finalOptions.chart.type = 'heatmap';
          }else {
            finalOptions.series = data.series || [];
            finalOptions.xaxis ||= {};
            finalOptions.xaxis.categories = data.categories || [];
          }
          finalOptions.chart.type = chartType === 'line' && wdg.config.showArea ? 'area' : chartType;
          finalOptions.yaxis ||= {};
          if (!Array.isArray(finalOptions.yaxis) && chartType !== 'heatmap') { finalOptions.yaxis.labels ||= {}; finalOptions.yaxis.labels.formatter = value => fmt(Number(value),wdg); }
          finalOptions.tooltip ||= {}; finalOptions.tooltip.y ||= {}; finalOptions.tooltip.y.formatter = value => fmt(value,wdg);
          if(chartType !== 'donut') { finalOptions.dataLabels ||= {}; finalOptions.dataLabels.formatter = value => fmt(value,wdg); }
          wdg.chart = chartForSave(finalOptions);

          return finalOptions;
        }

        /**
         * Deep merge options with override
         */
        function deepMergeOptions(target, ...sources) {
          if (!sources.length) return target;
          const source = sources.shift();

          if (isObjectLike(target) && isObjectLike(source)) {
            for (const key of Object.keys(source)) {
              if (['__proto__', 'prototype', 'constructor'].includes(key)) continue;
              if (isObjectLike(source[key])) {
                if (!target[key]) target[key] = {};
                deepMergeOptions(target[key], source[key]);
              } else {
                target[key] = source[key];
              }
            }
          }
          return deepMergeOptions(target, ...sources);
        }

        function isObjectLike(item) {
          return item && typeof item === 'object' && !Array.isArray(item);
        }

        function renderLine(el, wdg, data) {
          const options = buildChartOptionsFromTemplate(wdg, data, 'line');
          mountChart(el, wdg.id, options);
        }

        function renderBar(el, wdg, data) {
          const options = buildChartOptionsFromTemplate(wdg, data, 'bar');
          mountChart(el, wdg.id, options);
        }

        function renderDonut(el, wdg, data) {
          const options = buildChartOptionsFromTemplate(wdg, data, 'donut');
          mountChart(el, wdg.id, options);
        }

        function renderHeatmap(el, wdg, data) {
          const options = buildChartOptionsFromTemplate(wdg, data, 'heatmap');
          mountChart(el, wdg.id, options);
        }

        /**
         * renderWidgetContent - gọi hàm render tương ứng dựa vào kind
         * (Đây là hàm dispatcher, cần update nếu chưa có)
         */
        function renderWidgetContent(wdg) {
          if (!wdg) return;
          const el = document.querySelector(`.widget[data-id="${wdg.id}"] .widget-body`);
          if (!el) return;

          if (chartInstances[wdg.id]) { chartInstances[wdg.id].destroy(); delete chartInstances[wdg.id]; }
          el.replaceChildren();
          const dataKey = wdg.config.code;
          const dataset = DATASETS[dataKey];
          const needsDataset = !!wdg.config.dataBinding || !['emoji_card', 'button'].includes(wdg.kind);
          if (needsDataset && (!dataset || dataset.status !== 'ready')) {
            const message = datasetLoadError || dataset?.notice || (dataset?.status === 'empty' ? 'Chưa có dữ liệu trong kỳ thống kê.' : 'Chưa có nguồn dữ liệu cho widget này.');
            el.innerHTML = `<div class="empty-hint">${escapeHtml(message)}</div>`;
            wdg.chart ||= {};
            return;
          }
          const data = dataset?.data || {};

          // Dispatcher theo kind
          switch(wdg.kind) {
            case 'line':
              renderLine(el, wdg, data);
              break;
            case 'bar':
              renderBar(el, wdg, data);
              break;
            case 'donut':
              renderDonut(el, wdg, data);
              break;
            case 'heatmap':
              renderHeatmap(el, wdg, data);
              break;
            case 'emoji_card':
              renderEmojiCard(el, wdg, data);
              break;
            case 'large_img_card':
              renderLargeImgCard(el, wdg, data);
              break;
            case 'multiple_mini_card':
              renderMultipleMiniCard(el, wdg, data);
              break;
            case 'table':
              renderTable(el, wdg, data);
              break;
            case 'list':
              renderList(el, wdg, data);
              break;
            case 'report':
              renderReport(el, wdg, data);
              break;
            case 'button':
              renderButton(el, wdg, data);
              break;
            default:
              el.innerHTML = `<div class="empty-hint">Loại widget "${escapeHtml(wdg.kind)}" chưa được hỗ trợ.</div>`;
          }
          if (dataset?.notice) {
            const notice = document.createElement('div'); notice.className = 'dataset-notice'; notice.textContent = dataset.notice; el.appendChild(notice);
          }
        }

        /**
         * mountChart - render ApexChart instance
         * (Function này có sẵn rồi, không cần thay đổi)
         */
        function mountChart(el, key, options) {
          if (!el) return;
          if (chartInstances[key]) chartInstances[key].destroy();
          const chart = new ApexCharts(el, options);
          chart.render().catch(() => {
            if (chartInstances[key] !== chart) return;
            el.innerHTML = '<div class="empty-hint">Không thể vẽ biểu đồ với dữ liệu hiện tại.</div>';
          });
          chartInstances[key] = chart;
        }

        // =========================================================================
        // Khởi động
        // =========================================================================
        const status = document.getElementById('datasetStatus');
        const datasetCount = Object.keys(DATASETS).length;
        const unavailable = Object.values(DATASETS).filter(d => d.status !== 'ready').length;
        status.textContent = datasetLoadError || (datasetCount ? `Nguồn cấu hình riêng · ${datasetCount} widget${unavailable ? ` · ${unavailable} nguồn chưa có dữ liệu hoặc lỗi` : ''}` : 'Chọn widget → Dữ liệu để cấu hình nguồn và ánh xạ.');
        status.classList.toggle('warning', !!datasetLoadError || unavailable > 0 || !datasetCount);
        renderLibrary();
        seedDefaultLayout();
        let resizeT;
        window.addEventListener('resize', ()=>{ clearTimeout(resizeT); resizeT=setTimeout(renderCanvas, 120); });
    </script>
}
