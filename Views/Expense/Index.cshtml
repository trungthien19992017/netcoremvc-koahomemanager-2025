@{
    ViewData["Title"] = "Quản lý chi phí";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    .expense-row {
        transition: background-color 0.3s ease;
    }

        .expense-row.flash-update {
            background-color: #fef3c7; /* nhấp nháy nhẹ khi icon vừa được AI cập nhật */
        }

    .expense-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f3f4f6;
        font-size: 16px;
    }
</style>

<div class="container mt-4" style="max-width: 700px;">
    <h4 class="mb-3">Quản lý chi phí</h4>

    <!-- FORM NHẬP CHI PHÍ -->
    <div class="card p-3 mb-4">
        <div class="row g-2">
            <div class="col-7">
                <input id="inputExpenseName" type="text" class="form-control"
                       placeholder="VD: Cà phê sáng với khách hàng" />
            </div>
            <div class="col-3">
                <input id="inputAmount" type="number" class="form-control" placeholder="Số tiền" />
            </div>
            <div class="col-2">
                <button id="btnAdd" class="btn btn-primary w-100">Thêm</button>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH CHI PHÍ -->
    <div id="expenseList"></div>

    <div id="emptyState" class="text-center text-muted py-4">
        Chưa có chi phí nào. Nhập ở trên để bắt đầu.
    </div>
</div>

<script>
    (function () {
        let pendingIds = [];
        let pollingInterval = null;

        const listEl = document.getElementById('expenseList');
        const emptyStateEl = document.getElementById('emptyState');
        const btnAdd = document.getElementById('btnAdd');
        const inputExpenseName = document.getElementById('inputExpenseName');
        const inputAmount = document.getElementById('inputAmount');

        btnAdd.addEventListener('click', onAddExpense);
        inputExpenseName.addEventListener('keydown', e => {
            if (e.key === 'Enter') onAddExpense();
        });

        async function onAddExpense() {
            const name = inputExpenseName.value.trim();
            const amount = parseFloat(inputAmount.value) || 0;

            if (!name) {
                inputExpenseName.focus();
                return;
            }

            btnAdd.disabled = true;

            try {
                const res = await fetch('/Expense/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ expenseName: name, amount })
                });

                if (!res.ok) throw new Error('Lỗi server: ' + res.status);

                const data = await res.json();

                renderExpenseRow(data);

                // Reset form ngay để nhập dòng tiếp theo — không phải đợi AI
                inputExpenseName.value = '';
                inputAmount.value = '';
                inputExpenseName.focus();

                // Nếu chưa phân loại xong thì theo dõi để cập nhật icon sau
                if (data.status === 'Pending') {
                    pendingIds.push(data.id);
                    startPolling();
                }
            } catch (err) {
                alert('Có lỗi khi thêm chi phí: ' + err.message);
            } finally {
                btnAdd.disabled = false;
            }
        }

        function renderExpenseRow(data) {
            emptyStateEl.style.display = 'none';

            const row = document.createElement('div');
            row.id = `expense-${data.id}`;
            row.className = 'expense-row d-flex align-items-center gap-3 p-2 border-bottom';
            row.innerHTML = `
                <div class="expense-icon">
                    <i class="fa ${data.faIcon} ${data.status === 'Pending' ? 'fa-spin' : ''}"
                       style="color:${data.colorHex}"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-medium">${escapeHtml(data.expenseName)}</div>
                    <div class="text-muted small category-label">${data.category || 'Đang phân loại...'}</div>
                </div>
                <div class="fw-medium">${formatCurrency(data.amount)}</div>
            `;
            listEl.prepend(row);
        }

        function updateExpenseIcon(id, faIcon, colorHex, category) {
            const row = document.getElementById(`expense-${id}`);
            if (!row) return;

            const iconEl = row.querySelector('i');
            iconEl.className = `fa ${faIcon}`; // bỏ fa-spin, gắn icon thật AI trả về
            iconEl.style.color = colorHex;

            row.querySelector('.category-label').textContent = category;

            // Hiệu ứng nhấp nháy nhẹ để người dùng biết icon vừa được cập nhật
            row.classList.add('flash-update');
            setTimeout(() => row.classList.remove('flash-update'), 800);
        }

        function startPolling() {
            if (pollingInterval) return;

            pollingInterval = setInterval(async () => {
                if (pendingIds.length === 0) {
                    clearInterval(pollingInterval);
                    pollingInterval = null;
                    return;
                }

                const query = pendingIds.map(id => `ids=${id}`).join('&');
                const res = await fetch(`/Expense/GetStatus?${query}`);
                if (!res.ok) return;

                const results = await res.json();

                results.forEach(item => {
                    if (item.status === 'Done' || item.status === 'Failed') {
                        updateExpenseIcon(item.id, item.faIcon, item.colorHex, item.category);
                        pendingIds = pendingIds.filter(id => id !== item.id);
                    }
                });
            }, 2000);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    })();
</script>
